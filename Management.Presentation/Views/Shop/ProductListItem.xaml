<UserControl x:Class="Management.Presentation.Views.Shop.ProductListItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:converters="clr-namespace:Management.Presentation.Converters"
             mc:Ignorable="d"
             d:DesignHeight="320" d:DesignWidth="240"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             RenderOptions.CachingHint="Cache">

    <UserControl.Resources>
        <converters:StockToBrushConverter x:Key="StockToBrushConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        
        <Style x:Key="PinToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <Path x:Name="icon" Data="{StaticResource IconPin}" 
                                  Fill="{DynamicResource TextTertiaryBrush}" 
                                  Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="icon" Property="Data" Value="{StaticResource IconPinFilled}"/>
                                <Setter TargetName="icon" Property="Fill" Value="{DynamicResource FacilityAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="CardBorder"
            Height="{StaticResource SizeProductCardHeight}"
            Padding="20"
            CornerRadius="16"
            Margin="0,0,0,8">

        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource ElevatedCardStyleInteractive}">
                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="Background">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{DynamicResource FacilityAccentColor}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource FacilityAccentColor}" Offset="1"/>
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource FacilityAccentBrush}"/>
                        <Setter Property="BorderThickness" Value="2"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Border.InputBindings>
            <MouseBinding MouseAction="LeftClick" Command="{Binding ViewDetailsCommand}"/>
        </Border.InputBindings>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="{StaticResource SizeProductImageHeight}"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. PRODUCT IMAGE AREA -->
            <Grid Grid.Row="0">
                <Border Background="{DynamicResource SurfaceBgTertiary}"
                        CornerRadius="12">
                    <Path Data="{DynamicResource IconShop}"
                          Fill="{DynamicResource TextTertiaryBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Opacity="0.3">
                        <Path.Style>
                            <Style TargetType="Path" BasedOn="{StaticResource Style.Icon.Hero}">
                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Fill" Value="White"/>
                                        <Setter Property="Opacity" Value="0.6"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Border>

                <!-- 0. Selection Checkbox (Top Left) -->
                <CheckBox IsChecked="{Binding IsSelected}" 
                          Style="{StaticResource CircularSelectionCheckBoxStyle}"
                          HorizontalAlignment="Left" 
                          VerticalAlignment="Top" 
                          Margin="12"
                          Panel.ZIndex="10"
                          Visibility="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- Selection Pill -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                        Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="8,4"
                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{DynamicResource Terminology.Shop.Status.Selected}" Style="{StaticResource Micro}" Foreground="{DynamicResource FacilityAccentBrush}" FontWeight="Bold"/>
                </Border>
            </Grid>

            <!-- 2. CONTENT AREA -->
            <StackPanel Grid.Row="1" Margin="0,12,0,0" VerticalAlignment="Top">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="44">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyMedium}">
                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="{Binding Price, StringFormat='{}{0:N2} DA', Mode=OneWay}" Margin="0,2,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Title3}">
                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                    <!-- Stock & Actions -->
                    <Grid Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" 
                                    Visibility="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                            <Ellipse Width="8" Height="8" Fill="{Binding StockLevel, Converter={StaticResource StockToBrushConverter}}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Text" Value="{DynamicResource Terminology.Shop.StockStatus.InStock}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StockLevel}" Value="Warning">
                                                <Setter Property="Text" Value="{DynamicResource Terminology.Shop.StockStatus.LowStock}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StockLevel}" Value="Critical">
                                                <Setter Property="Text" Value="{DynamicResource Terminology.Shop.StockStatus.OutOfStock}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="Opacity" Value="0.8"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- Actions (Visible on Hover) -->
                        <!-- Actions (Visible on Hover) - Replaced with Pin Toggle -->
                        <Button Command="{Binding TogglePinCommand}" 
                                HorizontalAlignment="Right"
                                Padding="12,6"
                                Visibility="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" Stretch="Uniform">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data" Value="{StaticResource IconPin}"/>
                                            <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}"/>
                                            <Setter Property="StrokeThickness" Value="1.5"/>
                                            <Setter Property="Fill" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource FacilityAccentBrush}"/>
                                                    <Setter Property="Stroke" Value="{DynamicResource FacilityAccentBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Stroke" Value="White"/>
                                                    <DataTrigger.EnterActions>
                                                        <!-- No trigger needed for Fill if Stroke is White? Actually pinned + active should be white fill or white stroke -->
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsPinned}" Value="True"/>
                                                        <Condition Binding="{Binding IsActive}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Fill" Value="White"/>
                                                    <Setter Property="Stroke" Value="White"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock VerticalAlignment="Center" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{DynamicResource Terminology.Shop.Action.Pin}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                    <Setter Property="Text" Value="{DynamicResource Terminology.Shop.Action.Unpin}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource FacilityAccentBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
