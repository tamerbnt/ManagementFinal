<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Loading Spinner Path -->
    <StreamGeometry x:Key="Path.Spinner">M12,4V2A10,10 0 0,0 2,12H4A8,8 0 0,1 12,4Z</StreamGeometry>

    <Style x:Key="Button.Primary" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource FacilityAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Neutral.White}" />
        <Setter Property="Padding" Value="24,8" />
        <Setter Property="Height" Value="44" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <Grid Margin="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="content"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                
                                <Path x:Name="spinner"
                                      Data="{StaticResource Path.Spinner}"
                                      Fill="{TemplateBinding Foreground}"
                                      Width="18" Height="18"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="RotationTransform" Angle="0" />
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource FacilityAccentBrush.Deep}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.5" />
                            <Setter TargetName="content" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="spinner" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Pill.Primary" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="Tag" Value="Corner.Round"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Button.Pill.Outline" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="#E5E7EB" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="24,8" />
        <Setter Property="Height" Value="44" />
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#F9FAFB" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#D1D5DB" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="Button.Secondary" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Secondary}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Padding" Value="24,8" />
        <Setter Property="Height" Value="44" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Corner.LG}">
                            <Grid Margin="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="content"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                
                                <Path x:Name="spinner"
                                      Data="{StaticResource Path.Spinner}"
                                      Fill="{TemplateBinding Foreground}"
                                      Width="18" Height="18"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="SecondaryRotationTransform" Angle="0" />
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.5" />
                            <Setter TargetName="content" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="spinner" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Visibility, ElementName=spinner}" Value="Visible">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="RotationStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="SecondaryRotationTransform"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0" To="360" Duration="0:0:1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="RotationStoryboard" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="Button.Ghost" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Primary}" />
        <Setter Property="Padding" Value="16,4" />
        <Setter Property="Height" Value="44" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource Corner.LG}">
                            <ContentPresenter x:Name="content"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.Accent.Primary}" />
                            <Setter TargetName="border" Property="Opacity" Value="0.15" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.QuickAction" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Neutral.White}" />
        <Setter Property="Padding" Value="10,12" />
        <Setter Property="MinHeight" Value="80" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="20"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="buttonScale" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <ContentPresenter x:Name="content"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource FacilityAccentDimBrush}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource FacilityAccentBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="buttonScale" 
                                                         Storyboard.TargetProperty="ScaleX" 
                                                         To="1.04" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="buttonScale" 
                                                         Storyboard.TargetProperty="ScaleY" 
                                                         To="1.04" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="buttonScale" 
                                                         Storyboard.TargetProperty="ScaleX" 
                                                         To="1" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="buttonScale" 
                                                         Storyboard.TargetProperty="ScaleY" 
                                                         To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- TOGGLE BUTTON STYLES -->
    <Style x:Key="ToggleButton.Ghost" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Padding" Value="{DynamicResource Space.MD}" />
        <Setter Property="Height" Value="44" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Corner.LG}">
                        <ContentPresenter x:Name="content"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                             <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" /> <!-- Tokenized Tint -->
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToggleButton.Primary" TargetType="ToggleButton">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Neutral.White}" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Corner.LG}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.Brand.Primary.Deep}" />
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.9" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RADIO BUTTON BUTTON-LIKE STYLES -->
    <Style x:Key="RadioButton.Ghost" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Corner.MD}"
                            Padding="12,4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.Accent.Primary}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Neutral.White}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="Transparent" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tab Radio Button Style (Pill Shape) -->
    <Style x:Key="TabRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="Padding" Value="24,8" />
        <Setter Property="Height" Value="36" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Corner.Round}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.Accent.Primary}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Neutral.White}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact Icon Button -->
    <Style x:Key="CompactIconButtonStyle" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="4"/>
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="8"/>
    </Style>

    <!-- Invisible Clickable Button -->
    <Style x:Key="InvisibleClickableButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Aliases for Short Names -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource Button.Primary}"/>
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource Button.Ghost}"/>
    <Style x:Key="DayNightToggleStyle" TargetType="CheckBox">
        <Setter Property="Width" Value="64"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Outer container -->
                    <Border x:Name="Container" CornerRadius="16" BorderThickness="0">
                        <Border.Background>
                            <SolidColorBrush x:Name="ContainerBg" Color="#4CB8FF"/>
                        </Border.Background>
                        <!-- Inner shadow simulated with multiple borders or simple drop shadow on inner elements -->
                        
                        <Grid ClipToBounds="True">
                            <Grid.OpacityMask>
                                <VisualBrush>
                                    <VisualBrush.Visual>
                                        <Border Background="Black" CornerRadius="16" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}"/>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Grid.OpacityMask>
                            <!-- Inner shadow effect for cutout look -->
                            <Border BorderBrush="#10000000" BorderThickness="2" CornerRadius="16" Margin="-1"/>

                            <!-- Day Background -->
                            <Grid x:Name="DayBackground" Opacity="1">
                                <!-- Sun Glow -->
                                <Ellipse Width="36" Height="36" Fill="White" Opacity="0.15" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-2,0,0,0"/>
                                <Ellipse Width="50" Height="50" Fill="White" Opacity="0.08" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-9,0,0,0"/>
                                <Ellipse Width="64" Height="64" Fill="White" Opacity="0.04" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-16,0,0,0"/>
                                
                                <!-- Back Cloud -->
                                <Grid Opacity="0.8">
                                    <Grid.Effect>
                                        <DropShadowEffect ShadowDepth="1" BlurRadius="2" Opacity="0.25" Direction="270"/>
                                    </Grid.Effect>
                                    <Ellipse Fill="White" Width="20" Height="20" Margin="24,18,0,-4" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                    <Ellipse Fill="White" Width="30" Height="30" Margin="36,8,0,-10" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                    <Ellipse Fill="White" Width="18" Height="18" Margin="54,18,0,-2" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                    <Rectangle Fill="White" Height="12" Margin="32,0,-10,0" VerticalAlignment="Bottom"/>
                                </Grid>

                                <!-- Front Cloud -->
                                <Grid>
                                    <Grid.Effect>
                                        <DropShadowEffect ShadowDepth="1" BlurRadius="2" Opacity="0.2" Direction="270"/>
                                    </Grid.Effect>
                                    <Ellipse Fill="White" Width="16" Height="16" Margin="16,20,0,-4" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                    <Ellipse Fill="White" Width="26" Height="26" Margin="28,12,0,-10" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                    <Ellipse Fill="White" Width="26" Height="26" Margin="44,8,0,-10" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                    <Ellipse Fill="White" Width="18" Height="18" Margin="60,20,0,-4" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                    <Rectangle Fill="White" Height="8" Margin="24,0,-10,0" VerticalAlignment="Bottom"/>
                                </Grid>
                            </Grid>
                            
                            <!-- Night Background -->
                            <Grid x:Name="NightBackground" Opacity="0">
                                <!-- Moon Glow -->
                                <Ellipse Width="36" Height="36" Fill="White" Opacity="0.05" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-2,0"/>
                                <Ellipse Width="50" Height="50" Fill="White" Opacity="0.04" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-9,0"/>
                                <Ellipse Width="64" Height="64" Fill="White" Opacity="0.03" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-16,0"/>
                                
                                <!-- Dark Arcs -->
                                <Ellipse Width="60" Height="60" Stroke="#111722" StrokeThickness="3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-10,0" Opacity="0.4"/>
                                <Ellipse Width="42" Height="42" Stroke="#111722" StrokeThickness="3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,0" Opacity="0.4"/>
                                
                                <!-- Stars -->
                                <Ellipse Fill="White" Width="2" Height="2" Margin="10,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <Ellipse Fill="White" Width="2" Height="2" Margin="22,20,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <Ellipse Fill="White" Width="1.5" Height="1.5" Margin="30,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <!-- 4-point star -->
                                <Path Fill="White" Data="M 14,14 Q 14,16.5 11.5,16.5 Q 14,16.5 14,19 Q 14,16.5 16.5,16.5 Q 14,16.5 14,14 Z" Margin="0,0,0,0" Opacity="0.9"/>
                                <Path Fill="White" Data="M 26,10 Q 26,11.5 24.5,11.5 Q 26,11.5 26,13 Q 26,11.5 27.5,11.5 Q 26,11.5 26,10 Z" Opacity="0.7"/>
                            </Grid>
                            
                            <!-- Sliding Thumb -->
                            <Grid x:Name="Thumb" HorizontalAlignment="Left" Width="26" Height="26" Margin="3,0,0,0">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform" X="0" Y="0"/>
                                </Grid.RenderTransform>
                                
                                <Grid.Effect>
                                    <DropShadowEffect Direction="315" ShadowDepth="1" BlurRadius="3" Opacity="0.3"/>
                                </Grid.Effect>
                                
                                <!-- Sun -->
                                <Ellipse x:Name="SunShape" Fill="#FFD700" Opacity="1"/>
                                
                                <!-- Moon -->
                                <Grid x:Name="MoonShape" Opacity="0">
                                    <Ellipse Fill="#E2E8F0"/>
                                    <!-- Craters -->
                                    <Ellipse Fill="#94A3B8" Width="6" Height="6" Margin="12,5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.8"/>
                                    <Ellipse Fill="#94A3B8" Width="4" Height="4" Margin="5,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.8"/>
                                    <Ellipse Fill="#94A3B8" Width="8" Height="8" Margin="8,15,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.8"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- IsChecked=True (Night) -->
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X" To="32" Duration="0:0:0.4">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ColorAnimation Storyboard.TargetName="ContainerBg" Storyboard.TargetProperty="Color" To="#1C2433" Duration="0:0:0.4"/>
                                        <DoubleAnimation Storyboard.TargetName="DayBackground" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                        <DoubleAnimation Storyboard.TargetName="NightBackground" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.4"/>
                                        <DoubleAnimation Storyboard.TargetName="SunShape" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="MoonShape" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.4"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.4">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ColorAnimation Storyboard.TargetName="ContainerBg" Storyboard.TargetProperty="Color" To="#4CB8FF" Duration="0:0:0.4"/>
                                        <DoubleAnimation Storyboard.TargetName="DayBackground" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.4"/>
                                        <DoubleAnimation Storyboard.TargetName="NightBackground" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                        <DoubleAnimation Storyboard.TargetName="SunShape" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.4"/>
                                        <DoubleAnimation Storyboard.TargetName="MoonShape" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

