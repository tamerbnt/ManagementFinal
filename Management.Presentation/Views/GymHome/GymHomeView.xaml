<UserControl x:Class="Management.Presentation.Views.GymHome.GymHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Management.Presentation.ViewModels.GymHome"
             xmlns:behaviors="clr-namespace:Management.Presentation.Behaviors"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:conv="clr-namespace:Management.Presentation.Converters"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:local="clr-namespace:Management.Presentation.Views.GymHome"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1440"
             x:Name="GymHomeControl">
    
    <UserControl.Resources>
        <!-- Use Global Standardized Shadows and Brushes -->


        
        <!-- Laser Accents (Dynamic based on Facility) -->
        <DropShadowEffect x:Key="Glow.Blue" BlurRadius="25" ShadowDepth="0" Opacity="0.4" Color="{DynamicResource FacilityAccentColor}"/>
        <DropShadowEffect x:Key="Glow.Green" BlurRadius="20" ShadowDepth="0" Opacity="0.6" Color="{DynamicResource Color.Success}"/>
        
        <DropShadowEffect x:Key="Shadow.TextContrast" BlurRadius="4" ShadowDepth="1" Opacity="0.3" Color="Black"/>

        <conv:LeftMarginConverter x:Key="LeftMarginConverter"/>
        <conv:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>


    </UserControl.Resources>

    <!-- Dashboard Root Bounds: Locked strictly to Window size -->
    <Grid VerticalAlignment="Stretch" Margin="0,0,0,0">
        <i:Interaction.Triggers>
            <i:EventTrigger EventName="Loaded">
                <i:InvokeCommandAction Command="{Binding OnLoadedCommand}"/>
            </i:EventTrigger>
        </i:Interaction.Triggers>
        <!-- THE SKELETON LOADER -->
        <local:GymHomeSkeleton Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- THE ACTUAL CONTENT -->
        <Grid Margin="0" Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/> <!-- Optimized Lateral Gap -->
                <ColumnDefinition Width="420"/> <!-- Sidebar Column -->
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Header (Greeting) -->
                <RowDefinition Height="*"/>    <!-- Row 1: Multi-Zone Content -->
            </Grid.RowDefinitions>

            <!-- ====================================================================== -->
            <!-- SECTION 0: DASHBOARD HEADER (Greeting + Primary Action) -->
            <!-- ====================================================================== -->
            <Border Grid.Row="0" Grid.Column="0" 
                    Background="{DynamicResource CardBackgroundBrush}" 
                    CornerRadius="24" 
                    Padding="36,28" 
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />  <!-- Icon -->
                        <ColumnDefinition Width="*" />     <!-- Text -->
                    </Grid.ColumnDefinitions>

                    <!-- Gym Icon -->
                    <Path Data="{DynamicResource IconGym}" 
                          Grid.Column="0"
                          Style="{DynamicResource Style.Icon.Large}" 
                          Stroke="{DynamicResource TextPrimaryBrush}"
                          Margin="0,0,24,0"
                          VerticalAlignment="Center"/>

                    <!-- 3-Layer Text Stack -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Vertical">
                        <!-- Layer 1: Greeting Label (Good afternoon) - Accent Color, Small, Medium Weight -->
                        <TextBlock Text="{Binding GreetingLabel}" 
                                   FontSize="13" 
                                   FontWeight="Medium" 
                                   Foreground="{DynamicResource FacilityAccentBrush}" 
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,4"/>
                        <!-- Layer 2: Name - Large, SemiBold -->
                        <TextBlock Text="{Binding GreetingName}" 
                                   FontSize="54" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                   TextTrimming="CharacterEllipsis"
                                   FontFamily="Segoe UI Variable Display"
                                   Margin="0,-4,0,0"/>
                        <!-- Layer 3: Subtitle - Smaller, Secondary, with more top margin -->
                        <TextBlock Text="{DynamicResource Terminology.Home.Subtitle}" 
                                   FontSize="17" 
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" 
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,8,0,0"
                                   Opacity="0.7"/>
                    </StackPanel>


                </Grid>
            </Border>



            <!-- ====================================================================== -->
            <!-- ZONE 1: LEFT CONTENT AREA (Metrics + Core) -->
            <!-- ====================================================================== -->
            <Grid Grid.Row="1" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Metrics Strip -->
                    <RowDefinition Height="10"/>   <!-- Optimized Spacer -->
                    <RowDefinition Height="*"/>    <!-- Operational Core -->
                </Grid.RowDefinitions>

                <!-- SECTION 1: METRICS STRIP (Hero + Support Cards - Fluid Grid) -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/> <!-- Hero: People Inside -->
                        <ColumnDefinition Width="20"/>   <!-- Gap -->
                        <ColumnDefinition Width="1*"/>   <!-- Active Members -->
                        <ColumnDefinition Width="20"/>   <!-- Gap -->
                        <ColumnDefinition Width="1*"/>   <!-- Expiring Soon -->
                        <ColumnDefinition Width="20"/>   <!-- Gap -->
                        <ColumnDefinition Width="1*"/>   <!-- Revenue Today -->
                    </Grid.ColumnDefinitions>

                    <!-- HERO: ACTIVE MEMBERS CAROUSEL (Salon Style) -->
                    <Border Grid.Column="0" MinHeight="100" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="16" Padding="18,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>  <!-- Label row -->
                                <RowDefinition Height="*"/>     <!-- Content row -->
                                <RowDefinition Height="Auto"/>  <!-- Footer: arrows + counter -->
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Header label -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Path Data="{DynamicResource IconMembers}" Stroke="#0EA5E9" StrokeThickness="1.8" Fill="Transparent" 
                                      Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{DynamicResource Terminology.Home.PeopleInside}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Card.Foreground}" VerticalAlignment="Center" Opacity="0.6"/>
                            </StackPanel>

                            <!-- CONTENT: Occupancy (ALONE AT LEFT) -->
                            <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,0,0">
                                <TextBlock Text="{Binding OccupancyCount}" FontSize="38" FontWeight="Bold" Foreground="{DynamicResource Brush.Card.Foreground}"/>
                                <TextBlock FontSize="12" Opacity="0.4" Margin="2,-4,0,0" Foreground="{DynamicResource Brush.Card.Foreground}">
                                    <Run Text="/"/>
                                    <Run Text="{Binding MaxCapacity, Mode=OneWay}"/>
                                    <Run Text="{DynamicResource Terminology.Home.Capacity.MaxLabel}"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- TREND PILL: ▲/▼ % vs last hour -->
                            <Border Grid.Row="2" Grid.Column="0" CornerRadius="6" Padding="8,3"
                                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,6,0,0"
                                    Visibility="{Binding HasOccupancyTrend, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1A3D2B"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTrendPositive}" Value="False">
                                                <Setter Property="Background" Value="#3D1A1A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding OccupancyTrendText}" FontSize="11" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#34D399"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTrendPositive}" Value="False">
                                                    <Setter Property="Foreground" Value="#F87171"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <!-- ULTRA-THIN PROGRESS RING (AT RIGHT - HERO SIZE) -->
                            <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" 
                                    Width="100" Height="100" VerticalAlignment="Center" Margin="8,0,4,0"
                                    Background="Transparent">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOccupancyOverflow}" Value="True">
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="{DynamicResource FacilityAccentColor}" Opacity="0.8"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <lvc:PieChart Series="{Binding OccupancySeries}" 
                                              Background="Transparent"
                                              LegendPosition="Hidden" 
                                              TooltipPosition="Hidden"
                                              InitialRotation="-90"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ACTIVE MEMBERS TOTAL -->
                    <Border Grid.Column="2" MinHeight="100" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="16" Padding="18,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- HEADER -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,8">
                                <Path Data="{DynamicResource IconMembers}" Stroke="#34D399" StrokeThickness="1.8" Fill="Transparent" 
                                      Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{DynamicResource Terminology.Home.ActiveMembers}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Card.Foreground}" VerticalAlignment="Center" Opacity="0.6"/>
                            </StackPanel>
                            <!-- CONTENT -->
                            <TextBlock Grid.Row="1" Text="{Binding ActiveMembersTotal}" FontSize="38" FontWeight="Bold" Foreground="{DynamicResource Brush.Card.Foreground}" VerticalAlignment="Center"/>
                            <!-- DELTA vs yesterday -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0"
                                        Visibility="{Binding HasMembersTrend, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border CornerRadius="6" Padding="6,3" Margin="0,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1A3D2B"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMembersTrendPositive}" Value="False">
                                                    <Setter Property="Background" Value="#3D1A1A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding ActiveMembersDeltaText}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#34D399"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMembersTrendPositive}" Value="False">
                                                        <Setter Property="Foreground" Value="#F87171"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- EXPIRING SOON -->
                    <Border Grid.Column="4" MinHeight="100" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="16" Padding="18,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- HEADER -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,8">
                                <Path Data="{DynamicResource IconClock}" Stroke="#FBBF24" StrokeThickness="1.8" Fill="Transparent" 
                                      Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{DynamicResource Terminology.Home.ExpiringSoon}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Card.Foreground}" VerticalAlignment="Center" Opacity="0.6"/>
                            </StackPanel>
                            <!-- CONTENT -->
                            <Grid Grid.Row="1" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ExpiringSoonCount}" FontSize="38" FontWeight="Bold" Foreground="{DynamicResource Brush.Card.Foreground}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="10,0,0,6"
                                            Visibility="{Binding ExpiringSoonRatioText, Converter={StaticResource StringToVisibilityConverter}}">
                                    <TextBlock Text="{Binding ExpiringSoonRatioText}" FontSize="11" Opacity="0.55" Foreground="{DynamicResource Brush.Card.Foreground}"/>
                                </StackPanel>
                            </Grid>
                            <!-- PERCENTAGE row -->
                            <Border Grid.Row="2" CornerRadius="6" Padding="6,3" HorizontalAlignment="Left" Margin="0,6,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#3D2A1A"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHighExpiry}" Value="True">
                                                <Setter Property="Background" Value="#4D1A1A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#FBBF24"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHighExpiry}" Value="True">
                                                    <Setter Property="Foreground" Value="#F87171"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="{Binding ExpiringSoonPct, StringFormat='{}{0:F0}%'}"/>
                                    <Run Text="{DynamicResource Terminology.Home.Expiry.Label}"/>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- REVENUE TODAY -->
                    <Border Grid.Column="6" MinHeight="100" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="16" Padding="18,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- HEADER -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,12">
                                <Path Data="{DynamicResource IconFinance}" Stroke="#A78BFA" StrokeThickness="1.8" Fill="Transparent" 
                                      Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{DynamicResource Terminology.Home.RevenueToday}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Card.Foreground}" VerticalAlignment="Center" Opacity="0.6"/>
                            </StackPanel>
                            <!-- CONTENT -->
                            <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RevenueToday, Converter={StaticResource AbbreviatedCurrencyConverter}}" 
                                           FontSize="44" FontWeight="Bold" Foreground="{DynamicResource Brush.Card.Foreground}">
                                    <TextBlock.ToolTip>
                                        <ToolTip Content="{Binding RevenueToday, Converter={StaticResource AbbreviatedCurrencyConverter}, ConverterParameter=Full}" 
                                                 Style="{StaticResource ToolTip.Standard}"/>
                                    </TextBlock.ToolTip>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.2"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.2"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.2"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.2"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </Style.Triggers>
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform CenterX="0" CenterY="20"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Viewbox>
                            <!-- REVENUE PROGRESS BAR -->
                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                </Grid.RowDefinitions>
                                <!-- Label: X DA of Y DA target -->
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <TextBlock FontSize="10" Opacity="0.5" Foreground="{DynamicResource Brush.Card.Foreground}">
                                        <Run Text="{DynamicResource Terminology.Home.Target.Of}"/>
                                        <Run Text="{Binding DailyRevenueTarget, Converter={StaticResource AbbreviatedCurrencyConverter}}"/>
                                        <Run Text="{DynamicResource Terminology.Home.Target.Label}"/>
                                    </TextBlock>
                                    <TextBlock HorizontalAlignment="Right" FontSize="10" FontWeight="SemiBold" Foreground="#A78BFA">
                                        <Run Text="{Binding RevenueTodayProgress, StringFormat='{}{0:P0}'}"/>
                                    </TextBlock>
                                </Grid>
                                <!-- Track -->
                                <Border Grid.Row="1" CornerRadius="3" Background="#22A78BFA"/>
                                <!-- Fill -->
                                <Border Grid.Row="1" CornerRadius="3" HorizontalAlignment="Left" Background="#A78BFA">
                                    <Border.Width>
                                        <MultiBinding Converter="{StaticResource UniversalMultiplyConverter}">
                                            <Binding Path="RevenueTodayProgress"/>
                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                        </MultiBinding>
                                    </Border.Width>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- SECTION 2: OPERATIONAL CORE (Activity + Hub) -->
                <Grid Grid.Row="2" VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/> <!-- Expanded: Recent Activity fills space -->
                    </Grid.ColumnDefinitions>
                    <!-- Recent Activity Section -->
                    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="24" Padding="20" VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <Path Data="{DynamicResource IconHistory}" Stroke="#2DD4BF" StrokeThickness="1.8" Fill="Transparent" 
                                          Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="{DynamicResource Terminology.Home.RecentActivity}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Brush.Card.Foreground}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Top Accent Separator (Inset) - Remove it in favor of card top border -->
                            <!-- <Border Grid.Row="0" Height="2" Background="{DynamicResource FacilityAccentBrush}" VerticalAlignment="Bottom" Margin="10,0,10,0" Opacity="0.4"/> -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
                                <Grid>
                                    <!-- ACTIVITY LIST -->
                                    <ItemsControl ItemsSource="{Binding ActivityStream}" 
                                                  Visibility="{Binding IsActivityEmpty, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource Brush.Surface.Secondary}" CornerRadius="16" Padding="14,12" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/> <!-- Avatar -->
                                                            <ColumnDefinition Width="*"/>    <!-- Content -->
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <!-- AVATAR / ICON -->
                                                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="12" Background="#0B2E2A" Margin="0,0,14,0" VerticalAlignment="Center">
                                                            <Grid>
                                                                <TextBlock Text="{Binding AvatarInitials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="#2DD4BF" Opacity="0.8"/>
                                                                <TextBlock Text="{Binding Icon}" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="12" Margin="0,0,-4,-4"/>
                                                            </Grid>
                                                        </Border>
                                                        
                                                        <!-- 2-LINE GRID CONTENT -->
                                                        <Grid Grid.Column="1">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/> <!-- Line 1: Name + Time -->
                                                                <RowDefinition Height="Auto"/> <!-- Line 2: Status + Relative -->
                                                            </Grid.RowDefinitions>
                                                            
                                                            <!-- LINE 1: Identity & Exact Time -->
                                                            <TextBlock Grid.Row="0" Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource Brush.Card.Foreground}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Row="0" Text="{Binding Timestamp}" FontWeight="SemiBold" FontSize="12" Opacity="0.5" Foreground="{DynamicResource Brush.Card.Foreground}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            
                                                            <!-- LINE 2: Action & Relative Time -->
                                                            <TextBlock Grid.Row="1" Text="{Binding Status}" FontSize="13" Opacity="0.7" Foreground="{DynamicResource Brush.Card.Foreground}" Margin="0,2,0,0" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Row="1" Text="{Binding RelativeTime}" FontSize="12" Opacity="0.4" Foreground="{DynamicResource Brush.Card.Foreground}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,2,0,0"/>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </ScrollViewer>

                            <!-- EMPTY STATE ILLUSTRATION (Absolute centered) -->
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0"
                                        Visibility="{Binding IsActivityEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border Width="90" Height="90" Background="Transparent" Margin="0,0,0,10">
                                    <Grid>
                                        <Image Source="/Management.Presentation;component/Resources/Images/dashboard_activity_empty.png" 
                                               Stretch="Uniform" Opacity="1.0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <Viewbox Width="60" Height="60" Opacity="0.15">
                                            <Path Data="{DynamicResource IconHistory}" Fill="{DynamicResource Brush.Card.Foreground}"/>
                                        </Viewbox>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{DynamicResource Terminology.Home.Activity.EmptyState.Title}" 
                                           FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" 
                                           Foreground="{DynamicResource Brush.Card.Foreground}" Opacity="0.6"/>
                                <TextBlock Text="{DynamicResource Terminology.Home.Activity.EmptyState.Subtitle}" 
                                           FontSize="12" HorizontalAlignment="Center" 
                                           Foreground="{DynamicResource Brush.Card.Foreground}" Opacity="0.4" Margin="0,2,0,0"/>

                                <!-- ACTION BUTTON -->
                                <Button Command="{Binding RegisterMemberCommand}" 
                                        Margin="0,16,0,0"
                                        HorizontalAlignment="Center">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRemoteMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{DynamicResource IconPlus}" Fill="{DynamicResource Brush.Neutral.White}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Terminology.Home.Action.CreateMember}" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Neutral.White}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Background Scan Listener (TextBox) -->
                            <TextBox Width="1" Height="1" Opacity="0" Text="{Binding ScanInput, UpdateSourceTrigger=PropertyChanged}" behaviors:FocusBehavior.FocusOnVisible="True">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding ScanCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>

                            <!-- PEOPLE INSIDE AVATARS SECTION (Always Visible for now) -->
                            <StackPanel Grid.Row="2" Margin="0,20,0,0">
                                <!-- Bottom Accent Separator (Inset) -->
                                <Border Height="2" Background="{DynamicResource FacilityAccentBrush}" Margin="10,0,10,15" Opacity="0.4"/>

                                <TextBlock Text="{DynamicResource Terminology.Home.Avatars.Label}" FontSize="12" Foreground="{DynamicResource Brush.Card.Foreground}" Opacity="0.6" Margin="0,0,0,12"/>


                                <StackPanel Orientation="Horizontal">
                                    <!-- Overlapping Avatars ItemsControl -->
                                    <ItemsControl ItemsSource="{Binding ActiveAvatars}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="34" Height="34" CornerRadius="17" 
                                                        Background="{Binding DimColorHex}" 
                                                        BorderBrush="{Binding ColorHex}" 
                                                        BorderThickness="1.5"
                                                        Margin="{Binding OverlapMargin, Converter={StaticResource LeftMarginConverter}}">
                                                    <TextBlock Text="{Binding Initials}" 
                                                               Foreground="{Binding ColorHex}" 
                                                               FontSize="12" FontWeight="Bold" 
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Border.ToolTip>
                                                        <ToolTip Content="{Binding FullName}" Style="{StaticResource ToolTip.Standard}"/>
                                                    </Border.ToolTip>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Overflow Count (+X) -->
                                    <Border Width="34" Height="34" CornerRadius="17" 
                                            Background="#15FFFFFF" 
                                            BorderBrush="{DynamicResource FacilityAccentBrush}" 
                                            BorderThickness="1"
                                            Margin="-10,0,0,0"
                                            Visibility="{Binding ExtraActiveCount, Converter={StaticResource IntToVisibilityConverter}}">
                                        <TextBlock Text="{Binding ExtraActiveCount, StringFormat='+{0}'}" 
                                                   Foreground="{DynamicResource FacilityAccentBrush}" 
                                                   FontSize="12" FontWeight="Bold" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>

            <!-- ====================================================================== -->
            <!-- SECTION 2: RIGHT UTIILTY SIDEBAR (Unified Panel) -->
            <!-- ====================================================================== -->
            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="16" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Quick Actions List -->
                        <RowDefinition Height="*"/>    <!-- Guide / Alerts Section -->
                        <RowDefinition Height="Auto"/> <!-- Status / Clock Footer -->
                    </Grid.RowDefinitions>

                    <!-- ========================================== -->
                    <!-- 1. QUICK ACTIONS (Sleek Vertical List)     -->
                    <!-- ========================================== -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRemoteMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <!-- List Buttons Style -->
                        <StackPanel.Resources>
                            <Style TargetType="Button" x:Key="FlatListButton">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Height" Value="48"/>
                                <Setter Property="Padding" Value="8"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1AFFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#0DFFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </StackPanel.Resources>
                        
                        <TextBlock Text="{DynamicResource Terminology.Home.QuickActions}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" Margin="4,0,0,12"/>

                        <!-- List of separated buttons -->
                        <Border Background="{DynamicResource FacilitySidebarBrush}" CornerRadius="16" Padding="4,2" Margin="0,0,0,8">
                            <Button Style="{StaticResource FlatListButton}" Command="{Binding SellItemCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="{DynamicResource FacilityAccentDimBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Path Data="{DynamicResource IconPlus}" Stroke="{DynamicResource FacilityAccentBrush}" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource Terminology.Home.Action.QuickSale}" FontSize="13" Foreground="{DynamicResource Brush.Neutral.White}" VerticalAlignment="Center"/>
                                    <Path Grid.Column="2" Data="M0,0 L4,4 L0,8" Stroke="{DynamicResource Brush.Neutral.White}" StrokeThickness="1.5" MaxWidth="6" Stretch="Uniform" Opacity="0.3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </Border>

                        <Border Background="{DynamicResource FacilitySidebarBrush}" CornerRadius="16" Padding="4,2" Margin="0,0,0,8">
                            <Button Style="{StaticResource FlatListButton}" Command="{Binding RegisterMemberCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#15FFFFFF" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Path Data="{DynamicResource IconHistory}" Fill="{DynamicResource Brush.Neutral.White}" Opacity="0.8" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource Terminology.Home.Action.CreateMember}" FontSize="13" Foreground="{DynamicResource Brush.Neutral.White}" Opacity="0.9" VerticalAlignment="Center"/>
                                    <Path Grid.Column="2" Data="M0,0 L4,4 L0,8" Stroke="{DynamicResource Brush.Neutral.White}" StrokeThickness="1.5" MaxWidth="6" Stretch="Uniform" Opacity="0.3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </Border>

                        <Border Background="{DynamicResource FacilitySidebarBrush}" CornerRadius="16" Padding="4,2" Margin="0,0,0,8">
                            <Button Style="{StaticResource FlatListButton}" Command="{Binding ProcessWalkInCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#15FFFFFF" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Path Data="{DynamicResource IconMembers}" Fill="{DynamicResource Brush.Neutral.White}" Opacity="0.8" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource Terminology.Home.Action.WalkIn}" FontSize="13" Foreground="{DynamicResource Brush.Neutral.White}" Opacity="0.9" VerticalAlignment="Center"/>
                                    <Path Grid.Column="2" Data="M0,0 L4,4 L0,8" Stroke="{DynamicResource Brush.Neutral.White}" StrokeThickness="1.5" MaxWidth="6" Stretch="Uniform" Opacity="0.3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </Border>

                        <Border Background="{DynamicResource FacilitySidebarBrush}" CornerRadius="16" Padding="4,2" Margin="0,0,0,8">
                            <Button Style="{StaticResource FlatListButton}" Command="{Binding OpenMultiSaleCartCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#15FFFFFF" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Path Data="{DynamicResource IconCart}" Fill="{DynamicResource Brush.Neutral.White}" Opacity="0.8" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource Terminology.Home.Action.MultiSale}" FontSize="13" Foreground="{DynamicResource Brush.Neutral.White}" Opacity="0.9" VerticalAlignment="Center"/>
                                    <Path Grid.Column="2" Data="M0,0 L4,4 L0,8" Stroke="{DynamicResource Brush.Neutral.White}" StrokeThickness="1.5" MaxWidth="6" Stretch="Uniform" Opacity="0.3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </Border>

                        <!-- Separator -->
                        <Border Height="1" Background="{DynamicResource Brush.Border.Subtle}" Margin="0,16,0,0"/>
                    </StackPanel>

                    <!-- ========================================== -->
                    <!-- 2. GUIDE / ALERTS SWIPER                   -->
                    <!-- ========================================== -->
                    <Grid Grid.Row="1" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Header: Segmented Toggle -->
                        <Grid Grid.Row="0" Margin="4,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <!-- Guide Tab -->
                                <Grid Margin="0,0,24,0">
                                    <TextBlock Text="{DynamicResource Terminology.Home.Sidebar.Guide}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" Cursor="Hand">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Opacity" Value="0.4"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentSidebarMode}" Value="Guide">
                                                        <Setter Property="Opacity" Value="1.0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <TextBlock.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding SetSidebarModeCommand}" CommandParameter="Guide"/>
                                        </TextBlock.InputBindings>
                                    </TextBlock>
                                    <Border Height="2" VerticalAlignment="Bottom" Background="{DynamicResource FacilityAccentBrush}" Margin="0,0,0,-6" Width="12" HorizontalAlignment="Left" CornerRadius="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentSidebarMode}" Value="Guide">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Grid>

                                <!-- Alerts Tab -->
                                <Grid>
                                    <TextBlock Text="{DynamicResource Terminology.Home.Sidebar.Alerts}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" Cursor="Hand">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Opacity" Value="0.4"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentSidebarMode}" Value="Alerts">
                                                        <Setter Property="Opacity" Value="1.0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <TextBlock.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding SetSidebarModeCommand}" CommandParameter="Alerts"/>
                                        </TextBlock.InputBindings>
                                    </TextBlock>
                                    <Border Height="2" VerticalAlignment="Bottom" Background="{DynamicResource FacilityAccentBrush}" Margin="0,0,0,-6" Width="12" HorizontalAlignment="Left" CornerRadius="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentSidebarMode}" Value="Alerts">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Content Switcher -->
                        <Grid Grid.Row="1">
                            <!-- 1. GUIDE CONTENT -->
                            <Grid x:Name="GuideContent">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSidebarMode}" Value="Guide">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Swippable Card -->
                                <Border Grid.Row="0" Background="{DynamicResource FacilitySidebarBrush}" CornerRadius="12" BorderThickness="0" Padding="20" VerticalAlignment="Stretch" Cursor="Hand" ToolTip="Click to view next tip">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{Binding NextGuideTipCommand}"/>
                                    </Border.InputBindings>
                                    <StackPanel VerticalAlignment="Center">
                                        <Border Background="{DynamicResource FacilityAccentDimBrush}" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,16">
                                            <TextBlock Text="{Binding CurrentGuide.StepBadge, FallbackValue='STEP 1'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FacilityAccentBrush}"/>
                                        </Border>
                                        <TextBlock Text="{Binding CurrentGuide.Title, FallbackValue='Loading Guide...'}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Neutral.White}" Margin="0,0,0,10"/>
                                        <TextBlock Text="{Binding CurrentGuide.Description, FallbackValue='Please wait while the visual guide instructions are prepared and loaded.'}" FontSize="15" Foreground="{DynamicResource Brush.Neutral.White}" Opacity="0.9" TextWrapping="Wrap" LineHeight="22"/>
                                    </StackPanel>
                                </Border>
                                
                                <!-- Pagination Dots -->
                                <ListBox Grid.Row="1" ItemsSource="{Binding GuideTips}" SelectedItem="{Binding CurrentGuide, Mode=TwoWay}" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" Margin="0,16,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border Background="Transparent" Padding="3,6" Cursor="Hand">
                                                            <Border x:Name="Dot" Width="6" Height="6" CornerRadius="3" Background="{DynamicResource Brush.Text.Primary}" Opacity="0.2"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Dot" Property="Opacity" Value="1.0"/>
                                                                <Setter TargetName="Dot" Property="Background" Value="{DynamicResource FacilityAccentBrush}"/>
                                                                <Setter TargetName="Dot" Property="Width" Value="16"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Grid>

                            <!-- 2. ALERTS CONTENT -->
                            <Grid x:Name="AlertsContent">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSidebarMode}" Value="Alerts">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SystemAlerts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource FacilitySidebarBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderThickness="0">
                                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource Brush.Neutral.White}" Opacity="0.8" TextWrapping="Wrap"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>

                    </Grid>

                    <!-- ========================================== -->
                    <!-- 3. BOTTOM FOOTER (Time & Status)           -->
                    <!-- ========================================== -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                        <Border Height="1" Background="{DynamicResource Brush.Border.Subtle}" Margin="0,0,0,16"/>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Large Compact Clock -->
                            <TextBlock Grid.Column="0" Text="{Binding CurrentTime, FallbackValue='05:35'}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center"/>
                            
                            <!-- Date & Status Alignment Right -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentDate, FallbackValue='Sunday, Apr 19, 2026'}" FontSize="10" Foreground="{DynamicResource Brush.Text.Primary}" Opacity="0.6" HorizontalAlignment="Right" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource FacilityAccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Terminology.Home.Status.Online}" FontSize="10" Foreground="{DynamicResource FacilityAccentBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
