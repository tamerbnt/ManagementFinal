<Window x:Class="Management.Presentation.Views.Salon.AppointmentDetailModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:converters="clr-namespace:Management.Presentation.Converters"
        mc:Ignorable="d" 
        Title="{DynamicResource Terminology.Salon.AppointmentDetail.Title}"
        Width="520" Height="580"
        FlowDirection="{DynamicResource GlobalFlowDirection}"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        WindowStyle="None" 
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <!-- Root shell matching our ModalShellControl aesthetic -->
    <Border Background="{DynamicResource SurfaceBg}"
            Margin="30"
            CornerRadius="24"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="60" ShadowDepth="30" Direction="270" Opacity="0.18" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="80"/>   <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Custom Close Button -->
            <Button Grid.Row="0" 
                    Click="CloseButton_Click"
                    Width="32" Height="32"
                    Background="#F3F4F6"
                    BorderThickness="0"
                    Cursor="Hand"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Margin="16">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bgBorder" Background="{TemplateBinding Background}" CornerRadius="16" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Path Data="M18 6L6 18M6 6l12 12" 
                                  Stroke="#6B7280" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="Uniform" Margin="8"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FEE2E2"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.1" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- ===== HEADER ===== -->
            <Border Grid.Row="0" Padding="32,32,32,24">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Appointment Details"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   TextAlignment="Left"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Appointment.ClientName}"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <!-- Status Pill -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                            Padding="12,6" CornerRadius="12"
                            Background="{DynamicResource FacilityAccentDimBrush}">
                        <TextBlock Text="{Binding Appointment.Status}"
                                   Foreground="{DynamicResource FacilityAccentBrush}"
                                   FontWeight="SemiBold" FontSize="11"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== CONTENT ===== -->
            <ScrollViewer Grid.Row="1" Padding="32,0">
                <StackPanel>
                    <!-- Info Grid -->
                    <UniformGrid Columns="2" Margin="0,0,0,24">
                        <!-- Service -->
                        <Border Background="{DynamicResource SurfaceBg}" 
                                CornerRadius="16" Padding="16" Margin="0,0,8,0"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Service" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Appointment.ServiceName}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Stylist -->
                        <Border Background="{DynamicResource SurfaceBg}" 
                                CornerRadius="16" Padding="16" Margin="8,0,0,0"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Stylist" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Appointment.StaffName}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Schedule Card -->
                    <Border Background="{DynamicResource SurfaceBg}" 
                            CornerRadius="20" Padding="20"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Date" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M19 4H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2 M16 2v4 M8 2v4 M3 10h18" 
                                          Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.5" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Appointment.StartTime, StringFormat='{}{0:D}'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <Separator Grid.Column="1" HorizontalAlignment="Center" Width="1" Height="24" Background="{DynamicResource BorderBrush}"/>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Time" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,4" HorizontalAlignment="Right"/>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12 8v4l3 3m6-3a9 9 0 1 1-18 0 9 9 0 0 1 18 0z" 
                                          Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.5" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Appointment.StartTime, StringFormat='{}{0:HH:mm}'}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Notes Section -->
                    <StackPanel Margin="0,24,0,0" Visibility="{Binding Appointment.Notes, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}">
                        <TextBlock Text="Notes" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Appointment.Notes}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontStyle="Italic"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== FOOTER ===== -->
            <Border Grid.Row="2" Padding="32,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Button Command="{Binding CancelCommand}"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                                  Stroke="{DynamicResource StatusErrorBrush}" StrokeThickness="1.5" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Cancel Appointment" Foreground="{DynamicResource StatusErrorBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding UpdateStatusCommand}"
                            HorizontalAlignment="Right"
                            Width="180" Height="48"
                            Style="{StaticResource PrimaryButton}"
                            Background="{DynamicResource FacilityAccentBrush}">
                        <TextBlock Text="{Binding ActionButtonText}" 
                                   Foreground="White" FontWeight="Bold"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
