<UserControl x:Class="Management.Presentation.Controls.Premium.AtriumMarkAnimation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="100"
             x:Name="RootControl">

    <!--
        Atrium Mark — correct geometry derived from atrium_icon_transparent.png
        
        Canvas: 100×100
        Corner squares: 28×28 with CornerRadius=4, at corners (0,0),(72,0),(0,72),(72,72)
        Center gap: 4px on each side between corner squares and center square
        Center square: 36×36 outline at position (32,32)
        Perimeter of center square: 4 × 36 = 144 → StrokeDashArray="144,144"
    -->

    <Viewbox Stretch="Uniform">
        <Grid x:Name="RootLayout" Width="100" Height="100" ClipToBounds="True" CacheMode="BitmapCache">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="AnimationStates">

                    <!-- ═══════════════════════════════════════
                         STATIC: All elements fully rendered
                    ═══════════════════════════════════════ -->
                    <VisualState x:Name="Static">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ScaleBR" Storyboard.TargetProperty="ScaleX" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="ScaleBR" Storyboard.TargetProperty="ScaleY" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="CenterSquare" Storyboard.TargetProperty="StrokeDashOffset" To="0" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="CenterScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="CenterScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="CenterSquare" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="ScanLine" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="MarkScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="MarkScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0"/>
                        </Storyboard>
                    </VisualState>

                    <!-- ═══════════════════════════════════════
                         CONSTRUCTION: Corners build in, center traces itself.
                         RepeatBehavior=Forever so it keeps cycling during the
                         artificial delay (1500ms) before navigation.
                    ═══════════════════════════════════════ -->
                    <VisualState x:Name="Construction">
                        <Storyboard RepeatBehavior="Forever">

                            <!-- Reset all to hidden at start of each loop -->
                            <DoubleAnimation Storyboard.TargetName="ScaleTL" Storyboard.TargetProperty="ScaleX" To="0" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="ScaleTL" Storyboard.TargetProperty="ScaleY" To="0" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="ScaleTR" Storyboard.TargetProperty="ScaleX" To="0" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="ScaleTR" Storyboard.TargetProperty="ScaleY" To="0" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="ScaleBL" Storyboard.TargetProperty="ScaleX" To="0" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="ScaleBL" Storyboard.TargetProperty="ScaleY" To="0" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="ScaleBR" Storyboard.TargetProperty="ScaleX" To="0" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="ScaleBR" Storyboard.TargetProperty="ScaleY" To="0" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="CenterSquare" Storyboard.TargetProperty="StrokeDashOffset" To="144" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="ScanLine" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>

                            <!-- Phase 1: TL corner builds in from its top-left origin -->
                            <DoubleAnimation Storyboard.TargetName="ScaleTL" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.05">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="ScaleTL" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.05">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>

                            <!-- Phase 1: TR corner builds in from its top-right origin -->
                            <DoubleAnimation Storyboard.TargetName="ScaleTR" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.15">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="ScaleTR" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.15">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>

                            <!-- Phase 1: BL corner builds in from its bottom-left origin -->
                            <DoubleAnimation Storyboard.TargetName="ScaleBL" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.15">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="ScaleBL" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.15">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>

                            <!-- Phase 1: BR corner builds in from its bottom-right origin -->
                            <DoubleAnimation Storyboard.TargetName="ScaleBR" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.25">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="ScaleBR" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.25">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>

                            <!-- Phase 2: Center square traces its perimeter -->
                            <DoubleAnimation Storyboard.TargetName="CenterSquare" Storyboard.TargetProperty="StrokeDashOffset" From="144" To="0" Duration="0:0:0.7" BeginTime="0:0:0.45">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>

                            <!-- Phase 3: Brief hold, then fade out everything for the next loop -->
                            <DoubleAnimation Storyboard.TargetName="MarkScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0" BeginTime="0:0:1.15"/>
                            <DoubleAnimation Storyboard.TargetName="MarkScale" Storyboard.TargetProperty="ScaleX" From="1" To="0.9" Duration="0:0:0.25" BeginTime="0:0:1.35" AutoReverse="True">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="MarkScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0" BeginTime="0:0:1.15"/>
                            <DoubleAnimation Storyboard.TargetName="MarkScale" Storyboard.TargetProperty="ScaleY" From="1" To="0.9" Duration="0:0:0.25" BeginTime="0:0:1.35" AutoReverse="True">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>

                        </Storyboard>
                    </VisualState>

                    <!-- ═══════════════════════════════════════
                         PULSE: Corner squares still, center breathes — background sync
                    ═══════════════════════════════════════ -->
                    <VisualState x:Name="Pulse">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="PillarsRotate" Storyboard.TargetProperty="Angle" To="0" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="CenterSquare" Storyboard.TargetProperty="StrokeDashOffset" To="0" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="ScanLine" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="MarkScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="MarkScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="ScaleTL" Storyboard.TargetProperty="ScaleX" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="ScaleTL" Storyboard.TargetProperty="ScaleY" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="ScaleTR" Storyboard.TargetProperty="ScaleX" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="ScaleTR" Storyboard.TargetProperty="ScaleY" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="ScaleBL" Storyboard.TargetProperty="ScaleX" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="ScaleBL" Storyboard.TargetProperty="ScaleY" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="ScaleBR" Storyboard.TargetProperty="ScaleX" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="ScaleBR" Storyboard.TargetProperty="ScaleY" To="1" Duration="0"/>

                            <DoubleAnimation Storyboard.TargetName="CenterScale" Storyboard.TargetProperty="ScaleX" From="1.0" To="1.1" Duration="0:0:1.8" AutoReverse="True">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CenterScale" Storyboard.TargetProperty="ScaleY" From="1.0" To="1.1" Duration="0:0:1.8" AutoReverse="True">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CenterSquare" Storyboard.TargetProperty="Opacity" From="1.0" To="0.5" Duration="0:0:1.8" AutoReverse="True">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </VisualState>

                    <!-- ═══════════════════════════════════════
                         SPIN: Corner pillars rotate 360 around the center — Transitions
                    ═══════════════════════════════════════ -->
                    <VisualState x:Name="Spin">
                        <Storyboard>
                            <!-- Reset other states -->
                            <DoubleAnimation Storyboard.TargetName="CenterSquare" Storyboard.TargetProperty="StrokeDashOffset" To="0" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="ScanLine" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="MarkScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="MarkScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0"/>
                            
                            <!-- Snap rotation to start, then spin -->
                            <DoubleAnimation Storyboard.TargetName="PillarsRotate" Storyboard.TargetProperty="Angle" To="0" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="PillarsRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.30">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </VisualState>

                    <!-- ═══════════════════════════════════════
                         SCAN: Sweeping line — data processing / reports
                    ═══════════════════════════════════════ -->
                    <VisualState x:Name="Scan">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="CenterSquare" Storyboard.TargetProperty="StrokeDashOffset" To="0" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="CenterScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="CenterScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="CenterSquare" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="ScaleTL" Storyboard.TargetProperty="ScaleX" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="ScaleTL" Storyboard.TargetProperty="ScaleY" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="ScaleTR" Storyboard.TargetProperty="ScaleX" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="ScaleTR" Storyboard.TargetProperty="ScaleY" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="ScaleBL" Storyboard.TargetProperty="ScaleX" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="ScaleBL" Storyboard.TargetProperty="ScaleY" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="ScaleBR" Storyboard.TargetProperty="ScaleX" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="ScaleBR" Storyboard.TargetProperty="ScaleY" To="1" Duration="0"/>

                            <!-- Scan line sweeps top to bottom -->
                            <DoubleAnimation Storyboard.TargetName="ScanLineTranslate" Storyboard.TargetProperty="Y" From="-10" To="110" Duration="0:0:2.2"/>
                            <DoubleAnimation Storyboard.TargetName="ScanLine" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                            <DoubleAnimation Storyboard.TargetName="ScanLine" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.25" BeginTime="0:0:1.95"/>

                            <!-- Mark pulses when scan line passes center -->
                            <DoubleAnimation Storyboard.TargetName="MarkScale" Storyboard.TargetProperty="ScaleX" From="1.0" To="1.05" Duration="0:0:0.35" AutoReverse="True" BeginTime="0:0:0.9">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="MarkScale" Storyboard.TargetProperty="ScaleY" From="1.0" To="1.05" Duration="0:0:0.35" AutoReverse="True" BeginTime="0:0:0.9">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </VisualState>

                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Canvas Width="100" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas.RenderTransform>
                    <ScaleTransform x:Name="MarkScale" ScaleX="1.0" ScaleY="1.0" CenterX="50" CenterY="50"/>
                </Canvas.RenderTransform>

                <!--
                    Layout (100×100 canvas):
                    ┌──────────────────────────────────┐
                    │ [TL 28×28]   gap   [TR 28×28]    │
                    │   gap    [Center 36×36]   gap     │
                    │ [BL 28×28]   gap   [BR 28×28]    │
                    └──────────────────────────────────┘
                    Corners at: (0,0) (72,0) (0,72) (72,72)
                    Center at:  (32,32) — size 36×36
                -->

                <!-- PILLARS CONTAINER: Allows grouped rotation of the four corner elements -->
                <Canvas x:Name="PillarsContainer" Width="100" Height="100" RenderTransformOrigin="0.5,0.5" CacheMode="BitmapCache">
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="PillarsRotate" Angle="0"/>
                    </Canvas.RenderTransform>

                    <!-- TL Corner — scales from top-left origin (0,0) -->
                    <Border Width="28" Height="28" CornerRadius="4"
                            Canvas.Left="0" Canvas.Top="0"
                            Background="{Binding MarkForeground, ElementName=RootControl}">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ScaleTL" ScaleX="1" ScaleY="1" CenterX="0" CenterY="0"/>
                        </Border.RenderTransform>
                    </Border>

                    <!-- TR Corner — scales from top-right origin (100,0) -->
                    <Border Width="28" Height="28" CornerRadius="4"
                            Canvas.Left="72" Canvas.Top="0"
                            Background="{Binding MarkForeground, ElementName=RootControl}">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ScaleTR" ScaleX="1" ScaleY="1" CenterX="28" CenterY="0"/>
                        </Border.RenderTransform>
                    </Border>

                    <!-- BL Corner — scales from bottom-left origin (0,100) -->
                    <Border Width="28" Height="28" CornerRadius="4"
                            Canvas.Left="0" Canvas.Top="72"
                            Background="{Binding MarkForeground, ElementName=RootControl}">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ScaleBL" ScaleX="1" ScaleY="1" CenterX="0" CenterY="28"/>
                        </Border.RenderTransform>
                    </Border>

                    <!-- BR Corner — scales from bottom-right origin (100,100) -->
                    <Border Width="28" Height="28" CornerRadius="4"
                            Canvas.Left="72" Canvas.Top="72"
                            Background="{Binding MarkForeground, ElementName=RootControl}">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ScaleBR" ScaleX="1" ScaleY="1" CenterX="28" CenterY="28"/>
                        </Border.RenderTransform>
                    </Border>
                </Canvas>

                <!-- Center Square Outline — perimeter = 4×36 = 144 -->
                <Path x:Name="CenterSquare"
                      Stroke="{Binding MarkForeground, ElementName=RootControl}"
                      StrokeThickness="5"
                      StrokeLineJoin="Round"
                      Canvas.Left="32" Canvas.Top="32">
                    <Path.RenderTransform>
                        <ScaleTransform x:Name="CenterScale" ScaleX="1" ScaleY="1" CenterX="18" CenterY="18"/>
                    </Path.RenderTransform>
                    <Path.Data>
                        <RectangleGeometry Rect="0,0,36,36"/>
                    </Path.Data>
                    <Path.StrokeDashArray>
                        <DoubleCollection>144, 144</DoubleCollection>
                    </Path.StrokeDashArray>
                    <Path.StrokeDashOffset>0</Path.StrokeDashOffset>
                </Path>

                <!-- Scan Line — used only in Scan mode -->
                <Rectangle x:Name="ScanLine" Width="100" Height="2"
                           Canvas.Left="0" Canvas.Top="0"
                           Fill="{Binding MarkForeground, ElementName=RootControl}"
                           Opacity="0">
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="ScanLineTranslate" Y="-10"/>
                    </Rectangle.RenderTransform>
                </Rectangle>

            </Canvas>
        </Grid>
    </Viewbox>
</UserControl>
