<UserControl x:Class="Management.Presentation.Views.FinanceAndStaff.FinanceAndStaffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Management.Presentation.Converters"
             xmlns:local="clr-namespace:Management.Presentation.Views.FinanceAndStaff"
             xmlns:layout="clr-namespace:Management.Presentation.Components.Layout"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Management.Presentation.Behaviors"
             xmlns:vm="clr-namespace:Management.Presentation.ViewModels.Finance"
             xmlns:premium="clr-namespace:Management.Presentation.Controls.Premium"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="1080" d:DesignWidth="1440"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Background="Transparent">

	<UserControl.Resources>
		<converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
		<converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
		<converters:EqualToVisibilityConverter x:Key="EqualToVisibilityConverter"/>
	</UserControl.Resources>

	<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<!-- Header -->
				<RowDefinition Height="Auto"/>
				<!-- Search & Filter Bar -->
				<RowDefinition Height="*"/>
				<!-- Content -->
			</Grid.RowDefinitions>
			
			<!-- 1. Header & Primary Actions -->
			<Grid Grid.Row="0" Margin="{StaticResource MarginSectionBottom}">
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
					<Path Data="{StaticResource IconFinance}" 
						  Style="{StaticResource Style.Icon.Large}" 
						  Stroke="{DynamicResource TextPrimaryBrush}"
						  Margin="0,0,12,0"
						  VerticalAlignment="Center"/>
					<TextBlock Text="{DynamicResource Terminology.Staff.Header}" 
							   Style="{StaticResource Title1}" 
							   Foreground="{DynamicResource TextPrimaryBrush}"
							   VerticalAlignment="Center"/>
				</StackPanel>
			</Grid>

			<!-- 2. Search & Filter Bar -->
			<Grid Grid.Row="1" Margin="{StaticResource MarginSectionBottom}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<!-- Filters & Actions -->
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<!-- Status Filter Pills & Search -->
				<StackPanel Grid.Column="0" Orientation="Horizontal">
					<Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Left">
						<StackPanel Orientation="Horizontal">
							<RadioButton Content="{DynamicResource Terminology.Staff.Filter.All}" 
										 IsChecked="{Binding SelectedFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=All}" 
										 GroupName="ViewGroup"
										 Style="{StaticResource AppleFilterRadioButtonStyle}" Margin="0,0,4,0"/>
							<RadioButton Content="{DynamicResource Terminology.Staff.Filter.Active}" 
										 IsChecked="{Binding SelectedFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Active}" 
										 GroupName="ViewGroup"
										 Style="{StaticResource AppleFilterRadioButtonStyle}" Margin="0,0,4,0"/>
							<RadioButton Content="{DynamicResource Terminology.Staff.Filter.Inactive}" 
										 IsChecked="{Binding SelectedFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Inactive}" 
										 GroupName="ViewGroup"
										 Style="{StaticResource AppleFilterRadioButtonStyle}"/>
						</StackPanel>
					</Border>

					<!-- Search Card with Expansion Animation -->
					<ContentControl Margin="12,0,0,0" VerticalAlignment="Center">
						<ContentControl.Style>
							<Style TargetType="ContentControl">
								<Setter Property="Width" Value="300"/>
								<Style.Triggers>
									<Trigger Property="IsKeyboardFocusWithin" Value="True">
										<Trigger.EnterActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetProperty="Width" To="450" Duration="0:0:0.3">
														<DoubleAnimation.EasingFunction>
															<CubicEase EasingMode="EaseOut"/>
														</DoubleAnimation.EasingFunction>
													</DoubleAnimation>
												</Storyboard>
											</BeginStoryboard>
										</Trigger.EnterActions>
										<Trigger.ExitActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetProperty="Width" To="300" Duration="0:0:0.25">
														<DoubleAnimation.EasingFunction>
															<CubicEase EasingMode="EaseIn"/>
														</DoubleAnimation.EasingFunction>
													</DoubleAnimation>
												</Storyboard>
											</BeginStoryboard>
										</Trigger.ExitActions>
									</Trigger>
								</Style.Triggers>
							</Style>
						</ContentControl.Style>
						
						<premium:PremiumSearchBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
												 Placeholder="Search staff..."
												 Height="44"/>
					</ContentControl>
				</StackPanel>

				<!-- Right Actions -->
				<StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
					<!-- Secondary Action: Export -->
					<Button Style="{StaticResource Button.Secondary}" Command="{Binding ExportCommand}" Margin="0,0,12,0" Height="44" Padding="16,0">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Corner.LG}" Padding="{TemplateBinding Padding}">
									<Grid>
										<StackPanel x:Name="BtnContent" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
											<Path Data="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" 
												  Stroke="{TemplateBinding Foreground}"
												  Style="{StaticResource Style.Icon.Small}"
												  Margin="{StaticResource MarginIconRight}"/>
											<TextBlock Text="{DynamicResource Terminology.History.Action.Export}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" FontWeight="SemiBold"/>
										</StackPanel>
										<premium:AtriumMarkAnimation x:Name="BusyAnim" AnimationMode="Scan" MarkForeground="{TemplateBinding Foreground}" 
																	 Width="18" Height="18" Visibility="Collapsed" 
																	 HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Grid>
								</Border>
								<ControlTemplate.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
									</Trigger>
									<DataTrigger Binding="{Binding IsExporting}" Value="True">
										<Setter TargetName="BtnContent" Property="Visibility" Value="Collapsed"/>
										<Setter TargetName="BusyAnim" Property="Visibility" Value="Visible"/>
									</DataTrigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Button.Template>
					</Button>

					<!-- Secondary Action: Print -->
					<Button Style="{StaticResource Button.Secondary}" Command="{Binding PrintStaffListCommand}" Margin="0,0,12,0" Height="44" Padding="16,0">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Corner.LG}" Padding="{TemplateBinding Padding}">
									<Grid>
										<StackPanel x:Name="BtnContent" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
											<Path Data="{StaticResource IconPrinter}" 
												  Fill="{TemplateBinding Foreground}"
												  Style="{StaticResource Style.Icon.Small}"
												  Margin="{StaticResource MarginIconRight}"/>
											<TextBlock Text="{DynamicResource Terminology.Staff.Action.Print}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" FontWeight="SemiBold"/>
										</StackPanel>
										<premium:AtriumMarkAnimation x:Name="BusyAnim" AnimationMode="Scan" MarkForeground="{TemplateBinding Foreground}" 
																	 Width="18" Height="18" Visibility="Collapsed" 
																	 HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Grid>
								</Border>
								<ControlTemplate.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
									</Trigger>
									<DataTrigger Binding="{Binding IsPrinting}" Value="True">
										<Setter TargetName="BtnContent" Property="Visibility" Value="Collapsed"/>
										<Setter TargetName="BusyAnim" Property="Visibility" Value="Visible"/>
									</DataTrigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Button.Template>
					</Button>

					<!-- Primary Action: Add Staff -->
					<Button Style="{StaticResource Button.Pill.Primary}"
							Command="{Binding OpenAddStaffCommand}"
							Margin="0,0,24,0"
							Height="44">
						<StackPanel Orientation="Horizontal">
							<Path Data="{StaticResource IconPlus}" 
								   Stroke="White"
								   Style="{StaticResource Style.Icon.Small}"
								   Margin="{StaticResource MarginIconRight}"/>
							<TextBlock Text="{DynamicResource Terminology.Staff.Action.Add}"/>
						</StackPanel>
					</Button>

					<!-- Separator -->
					<Border Width="1" Height="24" Background="{DynamicResource SeparatorStroke}" Margin="0,0,24,0" Opacity="0.5"/>

					<Button Command="{Binding SwitchViewModeCommand}" 
							CommandParameter="{x:Static vm:StaffViewMode.Grid}"
							Style="{StaticResource IconButtonStyle}" 
							ToolTip="{DynamicResource Terminology.FinanceAndStaff.View.Grid}" Margin="0,0,8,0">
						<Path Data="{StaticResource IconDashboard}">
							<Path.Style>
								<Style TargetType="Path" BasedOn="{StaticResource Style.Icon.Small}">
									<Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}"/>
									<Style.Triggers>
										<DataTrigger Binding="{Binding ViewMode}" Value="{x:Static vm:StaffViewMode.Grid}">
											<Setter Property="Fill" Value="{DynamicResource BrandPrimaryBrush}"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Path.Style>
						</Path>
					</Button>
					<Button Command="{Binding SwitchViewModeCommand}" 
							CommandParameter="{x:Static vm:StaffViewMode.List}"
							Style="{StaticResource IconButtonStyle}" 
							ToolTip="{DynamicResource Terminology.FinanceAndStaff.View.List}">
						<Path Data="{StaticResource IconMenu}">
							<Path.Style>
								<Style TargetType="Path" BasedOn="{StaticResource Style.Icon.Small}">
									<Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}"/>
									<Style.Triggers>
										<DataTrigger Binding="{Binding ViewMode}" Value="{x:Static vm:StaffViewMode.List}">
											<Setter Property="Fill" Value="{DynamicResource BrandPrimaryBrush}"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Path.Style>
						</Path>
					</Button>
				</StackPanel>
			</Grid>

			<!-- 3. Content Area -->
			<Border Grid.Row="2" Background="Transparent">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<!-- Staff List Component -->
					<Border Grid.Column="0" Background="Transparent">
						<local:StaffList DataContext="{Binding}"/>
					</Border>

					<Border Grid.Column="1" 
						  Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource MultiplyValueConverter}, ConverterParameter=0.45}" 
						  Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                          Background="{DynamicResource CardBackgroundBrush}"
                          CornerRadius="32"
                          Margin="16,0,16,16"
                          Effect="{DynamicResource Shadow3}"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource BorderBrush}">
						<Border.RenderTransform>
							<TranslateTransform X="800"/>
						</Border.RenderTransform>
						<Border.Style>
							<Style TargetType="Border">
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsDetailOpen}" Value="True">
										<DataTrigger.EnterActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="800" To="0" Duration="0:0:0.4">
														<DoubleAnimation.EasingFunction>
															<CubicEase EasingMode="EaseOut"/>
														</DoubleAnimation.EasingFunction>
													</DoubleAnimation>
												</Storyboard>
											</BeginStoryboard>
										</DataTrigger.EnterActions>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Border.Style>

						<local:StaffDetailView DataContext="{Binding SelectedStaff}"/>
					</Border>

					<!-- Empty State Overlay (Z-Order: Top) -->
					<Grid Grid.Column="0"
						  VerticalAlignment="Center" 
						  HorizontalAlignment="Center"
						  Visibility="{Binding FilteredStaffMembers.Count, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=Inverse}">
						
						<Ellipse Width="240" Height="240" Fill="{DynamicResource FacilityAccentBrush}" Opacity="0.03" Margin="0,-40,0,0" />

						<StackPanel HorizontalAlignment="Center">
							<Border Width="80" Height="80" 
									Background="{DynamicResource FacilityAccentDimBrush}" 
									CornerRadius="40" 
									Margin="0,0,0,24">
								<Path Data="{StaticResource IconMembers}" 
									  Fill="{DynamicResource FacilityAccentBrush}"
									  Width="36" Height="36"
									  Stretch="Uniform"
									  HorizontalAlignment="Center"
									  VerticalAlignment="Center"/>
							</Border>

							<TextBlock Text="{DynamicResource Terminology.Staff.EmptyState}" 
									   FontSize="22" FontWeight="SemiBold"
									   Foreground="{DynamicResource TextPrimaryBrush}"
									   HorizontalAlignment="Center"
									   Margin="0,0,0,8"/>

							<TextBlock Text="{DynamicResource Terminology.Staff.EmptyState.Description}" 
									   FontSize="16"
									   Foreground="{DynamicResource TextSecondaryBrush}"
									   HorizontalAlignment="Center"
									   Margin="0,0,0,32"
									   TextAlignment="Center"
									   MaxWidth="320"
									   TextWrapping="Wrap"/>

							<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
								<Button Content="{DynamicResource Terminology.Staff.Action.Add}"
										Command="{Binding OpenAddStaffCommand}"
										Style="{StaticResource PrimaryButton}"
										MinWidth="180"
										Margin="0,0,12,0"/>
								
								<Button Content="{DynamicResource Terminology.Global.Action.ResetFilters}"
										Command="{Binding ResetFiltersCommand}"
										Style="{StaticResource SecondaryButton}"
										Padding="16,0"
										Visibility="{Binding SearchQuery, Converter={StaticResource StringToVisibilityConverter}}"/>
							</StackPanel>
						</StackPanel>
					</Grid>
				</Grid>
			</Border>
	</Grid>
</UserControl>
