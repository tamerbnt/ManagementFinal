<Window x:Class="Management.Presentation.Views.Salon.CompletionModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Terminology.Salon.Completion.Title}" Height="700" Width="880"
        FlowDirection="{DynamicResource GlobalFlowDirection}"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        WindowStyle="None" 
        AllowsTransparency="False"
        Background="{DynamicResource Brush.Window.Background}"
        WindowStartupLocation="CenterOwner">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                          GlassFrameThickness="-1"
                          CornerRadius="24"
                          ResizeBorderThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <!-- Root shell matching our ModalShellControl aesthetic -->
    <Border Background="{DynamicResource Brush.Window.Background}"
            CornerRadius="24"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="60" ShadowDepth="30" Direction="270" Opacity="0.18" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="100"/>  <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Custom Close Button -->
            <Button Grid.Row="0" 
                    Click="CloseButton_Click"
                    Width="32" Height="32"
                    Background="#F3F4F6"
                    BorderThickness="0"
                    Cursor="Hand"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Margin="24">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bgBorder" Background="{TemplateBinding Background}" CornerRadius="16" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Path Data="M18 6L6 18M6 6l12 12" 
                                  Stroke="#6B7280" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="Uniform" Margin="8"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FEE2E2"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.1" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- ===== HEADER ===== -->
            <Border Grid.Row="0" Padding="40,40,40,24">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Checkout"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   TextAlignment="Left"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding ClientName}"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding ServiceName}"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Icon / Branding -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                            Width="48" Height="48" CornerRadius="12"
                            Background="{DynamicResource FacilityAccentDimBrush}">
                        <Path Data="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2 M8 7a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"
                              Stroke="{DynamicResource FacilityAccentBrush}" StrokeThickness="2" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== CONTENT — Dual Column ===== -->
            <Grid Grid.Row="1" Margin="40,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>     <!-- Products -->
                    <ColumnDefinition Width="40"/>    <!-- Gutter -->
                    <ColumnDefinition Width="360"/>   <!-- Summary -->
                </Grid.ColumnDefinitions>

                <!-- Left: Product Selection -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="Add Products to Sale"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AvailableProducts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" VerticalAlignment="Top"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,12,12"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="ProductCard" 
                                                        Background="{DynamicResource SurfaceBg}"
                                                        CornerRadius="16" Padding="16"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding SKU}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,8"/>
                                                            <TextBlock Text="{Binding Price, StringFormat=C}" Foreground="{DynamicResource FacilityAccentBrush}" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                Width="28" Height="28" CornerRadius="8"
                                                                Background="{DynamicResource FacilityAccentDimBrush}">
                                                            <Path Data="M12 5v14M5 12h14" Stroke="{DynamicResource FacilityAccentBrush}" StrokeThickness="2" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ProductCard" Property="BorderBrush" Value="{DynamicResource FacilityAccentBrush}"/>
                                                        <Setter TargetName="ProductCard" Property="Background" Value="{DynamicResource FacilityAccentDimBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Right: Receipt Summary -->
                <Border Grid.Column="2" 
                        Background="{DynamicResource SurfaceBg}" 
                        CornerRadius="24" Padding="28"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Order Summary" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
                            <StackPanel>
                                <!-- Service Fee -->
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Service Fee" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding BasePrice, StringFormat=C}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>
                                
                                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,8,0,16"/>

                                <!-- Items -->
                                <ItemsControl ItemsSource="{Binding UsedProducts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,16">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding Quantity}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11"/>
                                                        <TextBlock Text=" x " Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11"/>
                                                        <TextBlock Text="{Binding Price, StringFormat=C}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Total, StringFormat=C}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Totals -->
                        <StackPanel Grid.Row="3">
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,20"/>
                            <Grid>
                                <TextBlock Text="Total Amount" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding TotalAmount, StringFormat=C}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource FacilityAccentBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== FOOTER ===== -->
            <Border Grid.Row="2" Padding="40,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Button Command="{Binding CancelCommand}"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand">
                        <TextBlock Text="Cancel" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                    </Button>

                    <Button Command="{Binding CompleteCommand}"
                            HorizontalAlignment="Right"
                            Width="260" Height="56"
                            Style="{StaticResource PrimaryButton}"
                            Background="{DynamicResource FacilityAccentBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2M6 14h12v8H6z" 
                                  Stroke="White" StrokeThickness="2" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Complete &amp; Print" Foreground="White" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
