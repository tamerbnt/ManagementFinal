<UserControl x:Class="Management.Presentation.Views.Settings.DiscountEditorModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Management.Presentation.ViewModels.Settings"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:DiscountEditorViewModel}"
             Background="Transparent">
    <UserControl.Resources>
        <!-- Segmented Style for Fixed/Percentage Toggle -->
        <Style x:Key="SegmentedButtonStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" 
                                CornerRadius="18" 
                                Background="Transparent" 
                                Padding="4">
                            <ContentPresenter x:Name="Content" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                        <Setter Property="FontSize" Value="13"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource Brush.Brand.Primary}"/>
                                <Setter TargetName="Content" Property="TextElement.FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Form -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,32">
                <Border Width="64" Height="64" 
                        Background="{DynamicResource Brush.Brand.Primary.Fade}" 
                        CornerRadius="32" 
                        HorizontalAlignment="Center" 
                        Margin="0,0,0,16">
                    <Path Data="{StaticResource IconTag}" 
                          Style="{DynamicResource Style.Icon.Large}" 
                          Stroke="{DynamicResource Brush.Brand.Primary}" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding Title}" 
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           HorizontalAlignment="Center"
                           Style="{StaticResource Title2}"/>
                <TextBlock Text="{DynamicResource Terminology.DiscountEditor.Configure}" 
                           Style="{StaticResource Caption}" 
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 2. Form Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,24" Padding="0,0,12,0">
                <StackPanel>
                    <!-- Basic Info -->
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="{DynamicResource Terminology.DiscountEditor.Name}" Style="{DynamicResource FormLabel}" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{DynamicResource Input.Field}"
                                 Tag="e.g. Loyalty Discount"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="Description (Optional)" Style="{DynamicResource FormLabel}" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{DynamicResource Input.Field}"
                                 Height="60" AcceptsReturn="True" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Separator Background="{DynamicResource SeparatorStroke}" Margin="0,0,0,24"/>

                    <!-- Discount Values -->
                    <TextBlock Text="{DynamicResource Terminology.DiscountEditor.Settings}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" FontSize="11"/>

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Terminology.DiscountEditor.Value}" Style="{DynamicResource FormLabel}" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding Value}" Style="{DynamicResource Input.Field}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Width="180">
                            <TextBlock Text="{DynamicResource Terminology.DiscountEditor.Type}" Style="{DynamicResource FormLabel}" Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource Brush.Surface.Secondary}" 
                                    CornerRadius="22" 
                                    Padding="4" 
                                    Height="44">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <RadioButton Grid.Column="0" 
                                                 Content="{DynamicResource Terminology.DiscountEditor.FixedAmount}" 
                                                 IsChecked="{Binding IsFixedAmount}" 
                                                 Style="{StaticResource SegmentedButtonStyle}"/>
                                    
                                    <RadioButton Grid.Column="1" 
                                                 Content="{DynamicResource Terminology.DiscountEditor.Percentage}" 
                                                 IsChecked="{Binding IsPercentage}" 
                                                 Style="{StaticResource SegmentedButtonStyle}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,24">
                        <TextBlock Text="Is Active" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium"/>
                        <CheckBox IsChecked="{Binding IsActive}" HorizontalAlignment="Right" Style="{StaticResource GlobalToggleSwitchStyle}"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. Footer -->
            <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,16,0,0">
                <Button Command="{Binding SaveCommand}" Content="{DynamicResource Terminology.DiscountEditor.Save}" Style="{DynamicResource PrimaryButton}" Height="40" Margin="0,0,0,12"/>
                <Button Command="{Binding CancelCommand}" Content="Cancel" Style="{DynamicResource GhostButton}" Height="40"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
