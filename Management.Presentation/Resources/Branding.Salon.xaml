<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Identity Layer: SALON FACILITY -->
    
    <!-- Sidebar -->
    <Color x:Key="FacilitySidebarBrush.Color">#66001F</Color>
    <SolidColorBrush x:Key="FacilitySidebarBrush" Color="{StaticResource FacilitySidebarBrush.Color}"/>
    
    <!-- Accents (Dusty Rose) -->
    <Color x:Key="FacilityAccentColor">#C4788A</Color>
    <Color x:Key="FacilityAccentShadowColor">#B3697A</Color>
    <LinearGradientBrush x:Key="FacilityAccentGradient" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#C4788A" Offset="0"/>
        <GradientStop Color="#D1899B" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="FacilityAccentBrush" Color="{StaticResource FacilityAccentColor}"/>
    <SolidColorBrush x:Key="FacilityAccentDimBrush" Color="{StaticResource FacilityAccentColor}" Opacity="0.15"/>
    
    <!-- Contrast Tokens (Safety) -->
    <SolidColorBrush x:Key="OnAccentPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OnAccentSecondary" Color="#FCE7F3"/> 
    <SolidColorBrush x:Key="RowOnAccentPrimary" Color="#1A1208"/> <!-- Deep espresso text on Dusty Rose -->
    <SolidColorBrush x:Key="RowOnAccentSecondary" Color="#4A1524"/> <!-- Deep Wine -->

    <!-- Aliases for compatibility -->
    <SolidColorBrush x:Key="AccentBrush" Color="#C4788A"/>
    <Color x:Key="AccentColor">#C4788A</Color>
    <SolidColorBrush x:Key="IllustrationBackgroundBrush" Color="#F5F3E7"/>
    <SolidColorBrush x:Key="OverlayBackdropBrush" Color="#80000000"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#0FFFFFFF" Opacity="0.06"/>
    <Color x:Key="AccentLightColor">#FCE7F3</Color>
    <SolidColorBrush x:Key="StatusRoseBackground" Color="#F5F3E7"/>

    <!-- Legacy/Alias Tokens -->
    <SolidColorBrush x:Key="Brush.Brand.Primary" Color="#C4788A"/>
    <SolidColorBrush x:Key="Brush.Brand.Primary.Deep" Color="#66001F"/>
    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#C4788A"/>
    
    <!-- Terminology -->
    <sys:String x:Key="TerminologyLabel">Client</sys:String>
</ResourceDictionary>
