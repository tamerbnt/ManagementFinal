<UserControl x:Class="Management.Presentation.Views.Auth.SplashOnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:Management.Presentation.Converters"
             xmlns:auth="clr-namespace:Management.Presentation.ViewModels.Auth"
             xmlns:local="clr-namespace:Management.Presentation.Views.Auth"
             xmlns:premium="clr-namespace:Management.Presentation.Controls.Premium"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="980">

    <UserControl.Resources>
        <!-- Converters and local styles -->
    </UserControl.Resources>

    <!-- Main Container Grid -->
    <Grid>
        <!-- Actual Content: Visible when NOT loading -->
        <Grid Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <!-- Row 0: Scrollable area with Atrium Logo, Title, Categories, and From Scratch Logo -->
                <RowDefinition Height="*"/>
                <!-- Row 1: Fixed / Sticky Bottom Actions (Always visible) -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════
                 ROW 0 — SCROLLABLE CONTENT & SCROLL INDICATOR
                 ══════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0">
                <ScrollViewer x:Name="CategoryScrollViewer"
                              Style="{DynamicResource Style.ScrollViewer.PremiumOverlay}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="36,12,36,16">
                        
                        <!-- HEADER: ATRIUM LOGO -->
                        <Grid Margin="0,0,0,4">
                            <Image Source="/Assets/atrium_header_logo.png" 
                                   Height="96" 
                                   HorizontalAlignment="Left" 
                                   Margin="-25,0,0,0" 
                                   Stretch="Uniform" 
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>

                        <!-- TITLE & SUBTITLE (Unclipped & wrapped) -->
                        <TextBlock Text="Choose Your Operating Engine" 
                                   FontSize="23" 
                                   FontWeight="Black" 
                                   Foreground="#0F172A" 
                                   TextWrapping="Wrap" 
                                   LineHeight="28" 
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Select the primary workflow for your business." 
                                   FontSize="13.5" 
                                   Foreground="#64748B" 
                                   TextWrapping="Wrap" 
                                   Margin="0,0,0,18"/>

                        <!-- FACILITY ARCHETYPES LIST -->
                        <ItemsControl ItemsSource="{Binding AvailableFacilities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="RootItem" Background="#F8FAFC" CornerRadius="12" Padding="12" BorderThickness="1.5" BorderBrush="Transparent" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Row Selection Click Surface -->
                                            <Button Command="{Binding DataContext.SelectFacilityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding IsAvailable}"
                                                    Grid.Column="0" Grid.ColumnSpan="4"
                                                    Panel.ZIndex="1"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="Transparent"/>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Category Icon -->
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" IsHitTestVisible="False">
                                                <Path Data="{Binding IconKey}" Fill="#64748B" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Name & Description -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0" IsHitTestVisible="False">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B"/>
                                                    <Border x:Name="BadgeBorder" Background="#FEF3C7" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                                        <TextBlock Text="{Binding BadgeText}" FontSize="9" FontWeight="ExtraBold" Foreground="#D97706"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#64748B" Margin="0,1,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <!-- INFO '!' BUTTON (Opens CategoryDetail Modal) -->
                                            <Button Grid.Column="2"
                                                    Panel.ZIndex="5"
                                                    Command="{Binding DataContext.OpenCategoryDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Width="26" Height="26"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center"
                                                    ToolTip="View Archetype Details">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="infoBorder" Width="24" Height="24" CornerRadius="12" Background="White" BorderBrush="#CBD5E1" BorderThickness="1">
                                                            <TextBlock Text="!" FontSize="12" FontWeight="Black" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="infoBorder" Property="Background" Value="#F1F5F9"/>
                                                                <Setter TargetName="infoBorder" Property="BorderBrush" Value="#0F172A"/>
                                                                <Setter Property="Foreground" Value="#0F172A"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="infoBorder" Property="Background" Value="#E2E8F0"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Check Circle (Radio selection state) -->
                                            <Border x:Name="CheckCircle" Grid.Column="3" Width="20" Height="20" CornerRadius="10" BorderThickness="1.5" BorderBrush="#CBD5E1" Background="Transparent" VerticalAlignment="Center" IsHitTestVisible="False">
                                                <Path x:Name="CheckIcon" Data="M9,16.17L4.83,12l-1.42,1.41L9,19 21,7l-1.41-1.41L9,16.17z" 
                                                      Fill="White" Width="12" Height="12" Stretch="Uniform" Visibility="Collapsed"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                            <Setter TargetName="RootItem" Property="Opacity" Value="0.40"/>
                                            <Setter TargetName="BadgeBorder" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="CheckCircle" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="RootItem" Property="Background" Value="#F8EFEB"/>
                                            <Setter TargetName="RootItem" Property="BorderBrush" Value="#C4785A"/>
                                            <Setter TargetName="CheckCircle" Property="Background" Value="#C4785A"/>
                                            <Setter TargetName="CheckCircle" Property="BorderBrush" Value="#C4785A"/>
                                            <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                <Condition Binding="{Binding IsSelected}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="RootItem" Property="BorderBrush" Value="#CBD5E1"/>
                                        </MultiDataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- "POWERED BY FROM SCRATCH" (In scrollable area) -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,14,0,24">
                            <TextBlock Text="Powered by" FontSize="10" Foreground="#94A3B8" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                            <Border Width="110" Height="70" Background="#111827" HorizontalAlignment="Center" Margin="0,4,0,0" ToolTip="Powered by From Scratch">
                                <Border.OpacityMask>
                                    <ImageBrush ImageSource="/Assets/from_scratch_logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border.OpacityMask>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Opacity" Value="0.8"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="1.0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- FLOATING SCROLL INDICATOR (Scroll-to-Bottom) -->
                <premium:ScrollIndicatorButton TargetScrollViewer="{Binding ElementName=CategoryScrollViewer}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Bottom"
                                               Margin="0,0,0,8"/>
            </Grid>

            <!-- ══════════════════════════════════════════════════════
                 ROW 1 — STICKY BOTTOM ACTION FOOTER (Always Visible)
                 ══════════════════════════════════════════════════════ -->
            <Border Grid.Row="1" Background="White" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Padding="36,12,36,20">
                <StackPanel>
                    <!-- Enter Workspace Button (Full Width) -->
                    <Button Command="{Binding EnterWorkspaceCommand}" Height="50" BorderThickness="0" Cursor="Hand" Margin="0,0,0,8">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="EnterBtn" Background="#0F172A" CornerRadius="16">
                                    <Grid>
                                        <TextBlock x:Name="btnText" Text="Enter Workspace" Foreground="White" FontSize="15.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <premium:AtriumMarkAnimation x:Name="busyAnim" AnimationMode="Construction" MarkForeground="White" Width="26" Height="26" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="EnterBtn" Property="Opacity" Value="0.4"/></Trigger>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="EnterBtn" Property="Background" Value="#1E293B"/></Trigger>
                                    <DataTrigger Binding="{Binding IsEnteringWorkspace}" Value="True">
                                        <Setter TargetName="btnText" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="busyAnim" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Remote View Button (Full Width) -->
                    <Button Command="{Binding EnterRemoteWorkspaceCommand}" Height="38" BorderThickness="0" Cursor="Hand" Background="Transparent">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="RemoteBtn" Background="Transparent" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12">
                                    <Grid>
                                        <TextBlock x:Name="btnText" Text="Remote View (Owner)" Foreground="#64748B" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <premium:AtriumMarkAnimation x:Name="busyAnim" AnimationMode="Construction" MarkForeground="#64748B" Width="20" Height="20" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="RemoteBtn" Property="Opacity" Value="0.4"/></Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="RemoteBtn" Property="Background" Value="#F1F5F9"/>
                                        <Setter TargetName="RemoteBtn" Property="BorderBrush" Value="#94A3B8"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsEnteringRemote}" Value="True">
                                        <Setter TargetName="btnText" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="busyAnim" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Skeleton Loader: Visible when loading -->
        <local:DiscoverySkeletonView Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
    </Grid>
</UserControl>
