<UserControl x:Class="Management.Presentation.Views.Members.QuickRegistrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Management.Presentation.ViewModels.Members"
             xmlns:premium="clr-namespace:Management.Presentation.Controls.Premium"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:QuickRegistrationViewModel}"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </UserControl.Resources>

    <premium:ModalShellControl Title="{Binding Title}"
                               Width="900" MaxWidth="900"
                               CancelCommand="{Binding CancelCommand}"
                               SaveCommand="{Binding RegisterCommand}"
                               PrimaryActionText="{DynamicResource Terminology.Global.Register}">
        <Grid>
            <ScrollViewer Loaded="FormScroll_Loaded"
                          VerticalScrollBarVisibility="Hidden">
                <StackPanel Margin="0,8,0,0">
                    <!-- 1. LEAD SEARCH (TOP SECTION) -->
            <Border Background="{DynamicResource Brush.Surface.Glass}" 
                    CornerRadius="16" 
                    Padding="24" 
                    Margin="0,0,0,32"
                    BorderBrush="{DynamicResource SeparatorStroke}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Terminology.Modal.QuickRegistration.ConvertLead}" Style="{StaticResource SectionTitle}"/>
                    <premium:PremiumSearchBox Text="{Binding LeadSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             Placeholder="{DynamicResource Terminology.Modal.QuickRegistration.Placeholder.SearchLeads}"
                                             IconData="{StaticResource IconSearch}"/>
                    
                    <!-- Search Results (Shown only if query active) -->
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <!-- Scanning Animation -->
                        <StackPanel Visibility="{Binding IsSearchingLeads, Converter={StaticResource BoolToVis}}" 
                                    Orientation="Horizontal" HorizontalAlignment="Center" Margin="20">
                            <premium:AtriumMarkAnimation Width="24" Height="24" IsScanning="True"/>
                            <TextBlock Text="Searching leads..." Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                        </StackPanel>

                        <ListBox ItemsSource="{Binding LeadResults}" 
                                 MaxHeight="250"
                                 Style="{StaticResource ListBox.SearchPopup}"
                                 ItemTemplate="{StaticResource MemberSearchResultTemplate}"
                                 Visibility="{Binding HasLeadResults, Converter={StaticResource BoolToVis}}"/>

                        <!-- No Results State -->
                        <TextBlock Text="No matches found" HorizontalAlignment="Center" Margin="20" Foreground="{DynamicResource Brush.Text.Tertiary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding LeadResults.Count}" Value="0"/>
                                                <Condition Binding="{Binding IsSearchingLeads}" Value="False"/>
                                                <Condition Binding="{Binding LeadSearchQuery.Length, Converter={StaticResource IsGreaterThanConverter}, ConverterParameter=1}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. MAIN FORM (2 COLUMNS) -->
            <Grid>
                <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/> <!-- Spacer -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Personal Data &amp; Gender -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Terminology.Modal.QuickRegistration.PersonalDetails}" Style="{StaticResource SectionTitle}"/>

                            <premium:PremiumSearchBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                                     Placeholder="{DynamicResource Terminology.Staff.Add.FullName}"
                                                     IconData="{StaticResource IconMembers}"
                                                     IsSearchMode="False"
                                                     Margin="0,0,0,24"/>

                            <premium:PremiumSearchBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                                     Placeholder="{DynamicResource Terminology.Staff.Add.Phone}"
                                                     IconData="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                                                     IsSearchMode="False"
                                                     Margin="0,0,0,24"/>

                            <premium:PremiumSearchBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                                     Placeholder="{DynamicResource Terminology.Staff.Add.Email}"
                                                     IconData="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z M22 6l-10 7L2 6"
                                                     IsSearchMode="False"
                                                     Margin="0,0,0,24"/>

                            <premium:PremiumSearchBox Text="{Binding Age, Converter={StaticResource NullableIntToStringConverter}, UpdateSourceTrigger=PropertyChanged}"
                                                     Placeholder="{DynamicResource Terminology.Member.Age}"
                                                     IconData="{StaticResource IconCalendar}"
                                                     IsSearchMode="False"
                                                     Margin="0,0,0,24"/>

                            <!-- Gender Segmented Toggle -->
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="{DynamicResource Terminology.Member.Gender}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,12"/>
                                <premium:SegmentedToggleControl SelectedGender="{Binding Gender, Mode=TwoWay}" Width="250" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right Column: Identification &amp; Plan -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Terminology.Modal.QuickRegistration.Identification}" Style="{StaticResource SectionTitle}"/>

                            <premium:PremiumSearchBox Text="{Binding CardId, UpdateSourceTrigger=PropertyChanged}"
                                                     Placeholder="{DynamicResource Terminology.Modal.QuickRegistration.Placeholder.CardId}"
                                                     IconData="{StaticResource IconTag}"
                                                     IsSearchMode="False"
                                                     Margin="0,0,0,24"/>

                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="{DynamicResource Terminology.Modal.QuickRegistration.MembershipPlan}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding Plans}" 
                                  SelectedItem="{Binding SelectedPlan}"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  Style="{StaticResource Input.ComboBox}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Salon Service Selection (Conditional) -->
                    <StackPanel Margin="0,0,0,24" Visibility="{Binding IsSalonFacility, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource Terminology.Modal.QuickRegistration.SalonService}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding SalonServices}" 
                                  SelectedItem="{Binding SelectedSalonService}"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  Style="{StaticResource Input.ComboBox}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="{DynamicResource Terminology.Modal.QuickRegistration.AcquisitionSource}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,8"/>
                        <ComboBox SelectedValue="{Binding Source}" 
                                  SelectedValuePath="Tag"
                                  Style="{StaticResource Input.ComboBox}">
                            <ComboBoxItem Content="{DynamicResource Terminology.Member.Source.Walkin}" Tag="Walk-in"/>
                            <ComboBoxItem Content="{DynamicResource Terminology.Member.Source.Facebook}" Tag="Facebook"/>
                            <ComboBoxItem Content="{DynamicResource Terminology.Member.Source.Instagram}" Tag="Instagram"/>
                            <ComboBoxItem Content="{DynamicResource Terminology.Member.Source.TikTok}" Tag="TikTok"/>
                            <ComboBoxItem Content="{DynamicResource Terminology.Member.Source.Referral}" Tag="Referral"/>
                            <ComboBoxItem Content="{DynamicResource Terminology.Member.Source.WordofMouth}" Tag="Word of Mouth"/>
                            <ComboBoxItem Content="{DynamicResource Terminology.Member.Source.Website}" Tag="Website"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="{DynamicResource TerminologyManualDiscountLabel}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding AvailableDiscounts}" 
                                  SelectedItem="{Binding SelectedDiscount}"
                                  Style="{StaticResource Input.ComboBox}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                        </StackPanel>
                    </Grid>

            <!-- 3. PRICING SUMMARY -->
            <Border Background="{DynamicResource SurfaceBgDim}" CornerRadius="12" Padding="20" Margin="0,32,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconCart}" Fill="{DynamicResource FacilityAccentBrush}" Width="20" Height="20" Margin="0,0,12,0" Stretch="Uniform"/>
                        <TextBlock Text="{DynamicResource Terminology.Modal.QuickRegistration.RegistrationTotal}" VerticalAlignment="Center" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Original Price (Strikethrough) -->
                        <TextBlock Text="{Binding OriginalTotalPrice, StringFormat='{}{0:N2} DA'}" 
                                   FontSize="14" Foreground="{DynamicResource Brush.Text.Tertiary}" TextDecorations="Strikethrough"
                                   Visibility="{Binding IsDiscounted, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Margin="0,0,12,0" VerticalAlignment="Bottom"/>
                        
                        <!-- Effective Total -->
                        <TextBlock Text="{Binding TotalPrice, StringFormat='{}{0:N2} DA'}" 
                                   FontSize="24" FontWeight="ExtraBold" Foreground="{DynamicResource FacilityAccentBrush}" 
                                   VerticalAlignment="Bottom"/>
                        
                        <!-- Promo/Discount Badge -->
                        <Border Background="{DynamicResource StatusSuccessBackground}" CornerRadius="12" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Bottom"
                                Visibility="{Binding IsDiscounted, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource StatusSuccessBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding AppliedPromotionName}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AppliedPromotionName}" Value="{x:Null}">
                                                <Setter Property="Text" Value="{Binding SelectedDiscount.Name}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
                </StackPanel>
            </ScrollViewer>
            <premium:ScrollIndicatorButton
                Loaded="FormScrollIndicator_Loaded"
                Panel.ZIndex="100"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,8"/>
        </Grid>
    </premium:ModalShellControl>
</UserControl>
