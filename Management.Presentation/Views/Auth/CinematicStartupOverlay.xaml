<UserControl x:Class="Management.Presentation.Views.Auth.CinematicStartupOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1280"
             x:Name="Root"
             PreviewMouseDown="OnSkipAnimation"
             PreviewKeyDown="OnSkipAnimation"
             Focusable="True"
             Loaded="OnLoaded"
             Background="#1A1510">

    <UserControl.Resources>
        <!-- The temperature-shifting color logic -->
        <SolidColorBrush x:Key="DynamicBrush" x:Name="DynamicBrush" Color="#C4785A"/>

        <!-- Pseudo-3D Pillar Brush -->
        <LinearGradientBrush x:Key="PillarBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#A05A3E" Offset="0.0"/>
            <GradientStop Color="{Binding Color, Source={StaticResource DynamicBrush}}" Offset="0.3"/>
            <GradientStop Color="{Binding Color, Source={StaticResource DynamicBrush}}" Offset="0.7"/>
            <GradientStop Color="#A05A3E" Offset="1.0"/>
        </LinearGradientBrush>

        <Storyboard x:Key="CinematicStartupStoryboard" Completed="OnAnimationCompleted">
            <!-- 400ms: Ground Line Sweeps — mirrors Entablature timing and ElasticEase exactly -->
            <DoubleAnimation Storyboard.TargetName="GroundScale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.3" BeginTime="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase Oscillations="1" Springiness="4" EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- 150ms: Pillars Rise (Grow to Tall Height) -->
            <!-- Top-Left -->
            <DoubleAnimation Storyboard.TargetName="ScaleTL" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.2" BeginTime="0:0:0.15"/>
            <!-- Bottom-Left -->
            <DoubleAnimation Storyboard.TargetName="ScaleBL" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.2" BeginTime="0:0:0.15"/>
            
            <!-- Diagonals (Top-Right, Wait.. Diagonals means TL+BR, TR+BL?) Let's do TR+BL at 190ms -->
            <!-- Actually, user said: left pillar at 0, right pillar at 80, diagonals at 40. -->
            <!-- Let's map to our 4 pillars: Left (TL+BL) at 150ms, Diagonals (TR? No, TR is right. Diagonals implies there are 3 pillars? No, 4 pillars.) -->
            <!-- Let's do: TL at 150, BL at 190, TR at 190, BR at 230 -->
            <DoubleAnimation Storyboard.TargetName="ScaleTR" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.2" BeginTime="0:0:0.19"/>
            <DoubleAnimation Storyboard.TargetName="ScaleBR" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.2" BeginTime="0:0:0.23"/>

            <!-- 400ms: Entablature Sweep & Snap -->
            <!-- 200ms duration, overshoot and snap -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EntablatureScale" Storyboard.TargetProperty="ScaleX" BeginTime="0:0:0.4">
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1.03">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ElasticEase Oscillations="1" Springiness="5" EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <!-- Wait, ElasticEase naturally overshoots and snaps back if Value=1.0. Let's set Value=1.0 with ElasticEase -->
            </DoubleAnimationUsingKeyFrames>
            
            <!-- Let's replace the above with a cleaner ElasticEase on a standard DoubleAnimation -->
            <DoubleAnimation Storyboard.TargetName="EntablatureScale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.3" BeginTime="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase Oscillations="1" Springiness="4" EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- 600ms: Center Square Asymmetric Trace -->
            <!-- Perimeter = 144 (4 × 36). Offset from 144 to 0. -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CenterSquare" Storyboard.TargetProperty="StrokeDashOffset" BeginTime="0:0:0.6">
                <SplineDoubleKeyFrame KeyTime="0:0:0.1" Value="108" KeySpline="0.2,0 0.8,1"/> <!-- 1st side -->
                <SplineDoubleKeyFrame KeyTime="0:0:0.25" Value="72" KeySpline="0.2,0 0.8,1"/> <!-- 2nd side (slower corner turn) -->
                <SplineDoubleKeyFrame KeyTime="0:0:0.35" Value="36" KeySpline="0.2,0 0.8,1"/> <!-- 3rd side -->
                <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="0" KeySpline="0.2,0 0.8,1"/> <!-- 4th side -->
            </DoubleAnimationUsingKeyFrames>

            <!-- 1000ms: Structural Compression -->
            <!-- Pillars compress to ScaleY=0.35 → exact 28px height (= logo corner block size: 28/80=0.35) -->
            <!-- Using QuarticEase for immense gravity feel -->
            <DoubleAnimation Storyboard.TargetName="ScaleTL" Storyboard.TargetProperty="ScaleY" To="0.35" Duration="0:0:0.2" BeginTime="0:0:1.0">
                <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ScaleTR" Storyboard.TargetProperty="ScaleY" To="0.35" Duration="0:0:0.2" BeginTime="0:0:1.0">
                <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ScaleBL" Storyboard.TargetProperty="ScaleY" To="0.35" Duration="0:0:0.2" BeginTime="0:0:1.0">
                <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ScaleBR" Storyboard.TargetProperty="ScaleY" To="0.35" Duration="0:0:0.2" BeginTime="0:0:1.0">
                <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- Entablature drops flush to top of mark (Canvas.Top=-54 + 54 = y=0, top edge of logo blocks) -->
            <DoubleAnimation Storyboard.TargetName="EntablatureTranslate" Storyboard.TargetProperty="Y" To="54" Duration="0:0:0.2" BeginTime="0:0:1.0">
                <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- Ground line rises flush to bottom of mark (Canvas.Top=154 - 54 = y=100, bottom edge of logo blocks) -->
            <DoubleAnimation Storyboard.TargetName="GroundLineTranslate" Storyboard.TargetProperty="Y" To="-54" Duration="0:0:0.2" BeginTime="0:0:1.0">
                <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- 1200ms: The Breath & Color Shift -->
            <DoubleAnimation Storyboard.TargetName="MarkScale" Storyboard.TargetProperty="ScaleX" To="1.12" Duration="0:0:0.3" BeginTime="0:0:1.2" AutoReverse="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MarkScale" Storyboard.TargetProperty="ScaleY" To="1.12" Duration="0:0:0.3" BeginTime="0:0:1.2" AutoReverse="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <ColorAnimation Storyboard.TargetName="DynamicBrush" Storyboard.TargetProperty="Color" From="#C4785A" To="#D4856A" Duration="0:0:0.6" BeginTime="0:0:1.2"/>

            <!-- 1200ms: Wordmark Rise — synchronized with The Breath -->
            <DoubleAnimation Storyboard.TargetName="WordmarkPanel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:1.2">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="WordmarkTranslate" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.4" BeginTime="0:0:1.2">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- 1100ms: Scaffolding Fades (Immediately after snap/compression) -->
            <DoubleAnimation Storyboard.TargetName="GroundLine" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" BeginTime="0:0:1.1"/>
            <DoubleAnimation Storyboard.TargetName="Entablature" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" BeginTime="0:0:1.1"/>

            <!-- 1900ms: Exit Expansion — logo grows as it fades (zoom-through, 1.0→1.5, overlaps opacity fade) -->
            <DoubleAnimation Storyboard.TargetName="MarkScale" Storyboard.TargetProperty="ScaleX" To="1.5" Duration="0:0:0.6" BeginTime="0:0:1.9">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MarkScale" Storyboard.TargetProperty="ScaleY" To="1.5" Duration="0:0:0.6" BeginTime="0:0:1.9">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- 2000ms: Overlay Fades Out (The Bloom) -->
            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.5" BeginTime="0:0:2.0"/>

        </Storyboard>
    </UserControl.Resources>

    <Border CornerRadius="24" Background="#1A1510" x:Name="BackgroundGrid" ClipToBounds="True">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform>
                <ScaleTransform x:Name="MarkScale" ScaleX="1.0" ScaleY="1.0"/>
            </StackPanel.RenderTransform>

            <Canvas Width="100" Height="100" x:Name="MarkCanvas">

            <!-- Ground Line -->
            <!-- Ground line — mirrors Entablature: same 6px height, same sweep, rises -54 on compression -->
            <Rectangle x:Name="GroundLine" Width="120" Height="6" Canvas.Left="-10" Canvas.Top="154" Fill="{StaticResource DynamicBrush}">
                <Rectangle.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="GroundScale" ScaleX="0" ScaleY="1" CenterX="0" CenterY="1"/>
                        <TranslateTransform x:Name="GroundLineTranslate" Y="0"/>
                    </TransformGroup>
                </Rectangle.RenderTransform>
            </Rectangle>

            <!-- 4 Corner Pillars — Width=28, Height=80 → ScaleY=0.35 compresses to exact 28×28 logo corner blocks -->
            <Rectangle x:Name="PillarTL" Width="28" Height="80" Canvas.Left="0" Canvas.Top="-52" RadiusX="4" RadiusY="4" Fill="{StaticResource PillarBrush}">
                <Rectangle.RenderTransform><ScaleTransform x:Name="ScaleTL" ScaleY="0" CenterY="80"/></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="PillarTR" Width="28" Height="80" Canvas.Left="72" Canvas.Top="-52" RadiusX="4" RadiusY="4" Fill="{StaticResource PillarBrush}">
                <Rectangle.RenderTransform><ScaleTransform x:Name="ScaleTR" ScaleY="0" CenterY="80"/></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="PillarBL" Width="28" Height="80" Canvas.Left="0" Canvas.Top="72" RadiusX="4" RadiusY="4" Fill="{StaticResource PillarBrush}">
                <Rectangle.RenderTransform><ScaleTransform x:Name="ScaleBL" ScaleY="0" CenterY="0"/></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="PillarBR" Width="28" Height="80" Canvas.Left="72" Canvas.Top="72" RadiusX="4" RadiusY="4" Fill="{StaticResource PillarBrush}">
                <Rectangle.RenderTransform><ScaleTransform x:Name="ScaleBR" ScaleY="0" CenterY="0"/></Rectangle.RenderTransform>
            </Rectangle>

            <!-- Center Square — 36×36 at (32,32), StrokeThickness=5, Perimeter=144 — matches AtriumMarkAnimation exactly -->
            <Path x:Name="CenterSquare" Stroke="{StaticResource DynamicBrush}" StrokeThickness="5" StrokeLineJoin="Miter" Canvas.Left="32" Canvas.Top="32">
                <Path.Data>
                    <RectangleGeometry Rect="0,0,36,36"/>
                </Path.Data>
                <Path.StrokeDashArray>
                    <DoubleCollection>144, 144</DoubleCollection>
                </Path.StrokeDashArray>
                <Path.StrokeDashOffset>144</Path.StrokeDashOffset>
            </Path>

            <!-- Entablature (heavy horizontal beam) -->
            <Rectangle x:Name="Entablature" Width="120" Height="6" Canvas.Left="-10" Canvas.Top="-54" Fill="{StaticResource DynamicBrush}">
                <Rectangle.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="EntablatureScale" ScaleX="0" CenterX="0"/>
                        <TranslateTransform x:Name="EntablatureTranslate" Y="0"/>
                    </TransformGroup>
                </Rectangle.RenderTransform>
            </Rectangle>
            
            </Canvas>

            <!-- ATRIUM Wordmark — Segoe UI Variable Display, SemiBold 18, 4-unit tracking, synchronized with The Breath -->
            <StackPanel x:Name="WordmarkPanel" Orientation="Horizontal" HorizontalAlignment="Center"
                        Margin="0,12,0,0" Opacity="0">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="WordmarkTranslate" Y="10"/>
                </StackPanel.RenderTransform>
                <TextBlock Text="A" FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontWeight="SemiBold" FontSize="18"
                           Foreground="{StaticResource DynamicBrush}" Margin="0,0,4,0"
                           TextOptions.TextFormattingMode="Display"
                           TextOptions.TextRenderingMode="ClearType"
                           UseLayoutRounding="True" SnapsToDevicePixels="True"/>
                <TextBlock Text="T" FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontWeight="SemiBold" FontSize="18"
                           Foreground="{StaticResource DynamicBrush}" Margin="0,0,4,0"
                           TextOptions.TextFormattingMode="Display"
                           TextOptions.TextRenderingMode="ClearType"
                           UseLayoutRounding="True" SnapsToDevicePixels="True"/>
                <TextBlock Text="R" FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontWeight="SemiBold" FontSize="18"
                           Foreground="{StaticResource DynamicBrush}" Margin="0,0,4,0"
                           TextOptions.TextFormattingMode="Display"
                           TextOptions.TextRenderingMode="ClearType"
                           UseLayoutRounding="True" SnapsToDevicePixels="True"/>
                <TextBlock Text="I" FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontWeight="SemiBold" FontSize="18"
                           Foreground="{StaticResource DynamicBrush}" Margin="0,0,4,0"
                           TextOptions.TextFormattingMode="Display"
                           TextOptions.TextRenderingMode="ClearType"
                           UseLayoutRounding="True" SnapsToDevicePixels="True"/>
                <TextBlock Text="U" FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontWeight="SemiBold" FontSize="18"
                           Foreground="{StaticResource DynamicBrush}" Margin="0,0,4,0"
                           TextOptions.TextFormattingMode="Display"
                           TextOptions.TextRenderingMode="ClearType"
                           UseLayoutRounding="True" SnapsToDevicePixels="True"/>
                <TextBlock Text="M" FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontWeight="SemiBold" FontSize="18"
                           Foreground="{StaticResource DynamicBrush}"
                           TextOptions.TextFormattingMode="Display"
                           TextOptions.TextRenderingMode="ClearType"
                           UseLayoutRounding="True" SnapsToDevicePixels="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
