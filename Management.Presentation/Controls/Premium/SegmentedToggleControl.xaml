<UserControl x:Class="Management.Presentation.Controls.Premium.SegmentedToggleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Height="44">
    
    <UserControl.Resources>
        <!-- Silent Premium Button Style: No hover flickers, just pure hit-testing -->
        <Style x:Key="SegmentedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#01FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" IsHitTestVisible="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#F3F4F6" CornerRadius="14" Padding="4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Selection pill (Animation target) -->
            <Border x:Name="SelectionPill" 
                    Grid.Column="0" 
                    Background="#FFFFFF" 
                    CornerRadius="10"
                    HorizontalAlignment="Left"
                    IsHitTestVisible="False">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="PillTranslate" X="0"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Direction="270" RenderingBias="Performance"/>
                </Border.Effect>
            </Border>

            <!-- Male Segment -->
            <Button Grid.Column="0" 
                    Content="{DynamicResource Terminology.Member.Gender.Male}" 
                    Click="MaleButton_Click"
                    Style="{StaticResource SegmentedButtonStyle}"
                    FontSize="14"
                    FontWeight="SemiBold" 
                    Foreground="#111827" 
                    Cursor="Hand"/>
            
            <!-- Female Segment -->
            <Button Grid.Column="1" 
                    Content="{DynamicResource Terminology.Member.Gender.Female}" 
                    Click="FemaleButton_Click"
                    Style="{StaticResource SegmentedButtonStyle}"
                    FontSize="14"
                    FontWeight="SemiBold" 
                    Foreground="#111827" 
                    Cursor="Hand"/>
        </Grid>
    </Border>
</UserControl>
