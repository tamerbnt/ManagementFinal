<UserControl x:Class="Management.Presentation.Views.Auth.SplashOnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:Management.Presentation.Converters"
             xmlns:auth="clr-namespace:Management.Presentation.ViewModels.Auth"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="980">

    <UserControl.Resources>
        <!-- The Floating Card Shadow Removed for Performance -->
    </UserControl.Resources>

    <!-- Simplified layout: The container is now managed by AuthWindow.CardBorder -->
    <Grid>
        <StackPanel VerticalAlignment="Top" Margin="40,16,40,24">
            
            <!-- HEADER -->
            <Grid Margin="0,8,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="/Assets/atrium_header_logo.png" Height="110" HorizontalAlignment="Left" Margin="-25,0,0,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>

            <TextBlock Text="Select Discovery" FontSize="26" FontWeight="Black" Foreground="#0F172A" Margin="0,0,0,4"/>
            <TextBlock Text="Choose your facility context." FontSize="14" Foreground="#64748B" Margin="0,0,0,24"/>

            <!-- Facility Picker -->
            <ScrollViewer VerticalScrollBarVisibility="Hidden" MaxHeight="240">
                        <ItemsControl ItemsSource="{Binding AvailableFacilities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectFacilityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,10" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="RootItem" Background="#F8FAFC" CornerRadius="12" Padding="12" BorderThickness="1.5" BorderBrush="Transparent">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                                                            <Path Data="{Binding IconKey}" Fill="#64748B" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#64748B" Margin="0,1,0,0"/>
                                                        </StackPanel>

                                                        <Border x:Name="CheckCircle" Grid.Column="2" Width="20" Height="20" CornerRadius="10" BorderThickness="1.5" BorderBrush="#CBD5E1" Background="Transparent" VerticalAlignment="Center">
                                                            <Path x:Name="CheckIcon" Data="M9,16.17L4.83,12l-1.42,1.41L9,19 21,7l-1.41-1.41L9,16.17z" 
                                                                  Fill="White" Width="12" Height="12" Stretch="Uniform" Visibility="Collapsed"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="RootItem" Property="Background" Value="#F0F9FF"/>
                                                        <Setter TargetName="RootItem" Property="BorderBrush" Value="#0EA5E9"/>
                                                        <Setter TargetName="CheckCircle" Property="Background" Value="#0EA5E9"/>
                                                        <Setter TargetName="CheckCircle" Property="BorderBrush" Value="#0EA5E9"/>
                                                        <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                            <Condition Binding="{Binding IsSelected}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter TargetName="RootItem" Property="BorderBrush" Value="#E2E8F0"/>
                                                    </MultiDataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
            </ScrollViewer>

            <!-- SUBMIT & BRANDING -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                    <Button Command="{Binding EnterWorkspaceCommand}" Height="52" BorderThickness="0" Cursor="Hand" Margin="0,0,0,8">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="EnterBtn" Background="#0F172A" CornerRadius="16">
                                    <TextBlock Text="Enter Workspace" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="EnterBtn" Property="Opacity" Value="0.4"/></Trigger>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="EnterBtn" Property="Background" Value="#1E293B"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Command="{Binding EnterRemoteWorkspaceCommand}" Height="40" BorderThickness="0" Cursor="Hand" Background="Transparent">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="RemoteBtn" Background="Transparent" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12">
                                    <TextBlock Text="Remote View (Owner)" Foreground="#64748B" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="RemoteBtn" Property="Opacity" Value="0.4"/></Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="RemoteBtn" Property="Background" Value="#F1F5F9"/>
                                        <Setter TargetName="RemoteBtn" Property="BorderBrush" Value="#94A3B8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- "Powered by From Scratch" -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="Powered by" FontSize="10" Foreground="#6B7280" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                    <Border Width="110" Height="80" Background="#111827" HorizontalAlignment="Center" Margin="0,4,0,0" ToolTip="Powered by From Scratch">
                        <Border.OpacityMask>
                            <ImageBrush ImageSource="/Assets/from_scratch_logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border.OpacityMask>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Opacity" Value="0.9"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="1.0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
