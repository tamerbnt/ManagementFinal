<UserControl x:Class="Management.Presentation.Views.Settings.PromotionsSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:premium="clr-namespace:Management.Presentation.Controls.Premium"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="700">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="{DynamicResource Terminology.Settings.Promotions.Title}" Style="{DynamicResource Title2}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{DynamicResource Terminology.Settings.Promotions.Subtitle}" Style="{DynamicResource Caption}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            
            <Button Content="{DynamicResource Terminology.Settings.Promotions.Action.Add}" 
                    HorizontalAlignment="Right" 
                    Style="{DynamicResource Button.Primary}"
                    Command="{Binding CreatePromotionCommand}"
                    Width="160" Height="40"/>
        </Grid>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="PromotionsScrollViewer" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Promotions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource ComponentBg}" 
                                    CornerRadius="16" 
                                    Width="300" 
                                    Margin="0,0,20,20" 
                                    Padding="20"
                                    BorderBrush="{DynamicResource SeparatorStroke}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding TargetType}" FontSize="11" Foreground="{DynamicResource FacilityAccentBrush}" FontWeight="Black"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Margin="0,0,0,16">
                                        <TextBlock Text="{Binding Description}" Style="{DynamicResource BodySmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxHeight="40" Margin="0,0,0,12"/>
                                        
                                        <Border Background="{DynamicResource SurfaceBgDim}" CornerRadius="8" Padding="12,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DiscountValue}" FontSize="18" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding DiscountType}" Style="{DynamicResource Caption}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        
                                        <TextBlock Text="{Binding Criteria}" Style="{DynamicResource Caption}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,8,0,0"/>
                                    </StackPanel>

                                    <Grid Grid.Row="2" Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{DynamicResource IconButtonStyle}" Command="{Binding DataContext.EditPromotionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,8,0">
                                                <Path Data="{StaticResource Icon.Edit}" Fill="{DynamicResource TextSecondaryBrush}" Style="{StaticResource Style.Icon.Small}"/>
                                            </Button>
                                            <Button Style="{DynamicResource IconButtonStyle}" Command="{Binding DataContext.DeletePromotionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <Path Data="{StaticResource Icon.Delete}" Fill="{DynamicResource StatusErrorBrush}" Style="{StaticResource Style.Icon.Small}"/>
                                            </Button>
                                        </StackPanel>
                                        
                                        <Border Background="{DynamicResource StatusSuccessBackground}" CornerRadius="8" Padding="8,2" HorizontalAlignment="Left" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{DynamicResource Terminology.Settings.Promotions.Status.Active}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource StatusSuccessBrush}"/>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <premium:ScrollIndicatorButton 
                TargetScrollViewer="{Binding ElementName=PromotionsScrollViewer}"
                Panel.ZIndex="100"
                HorizontalAlignment="Center" 
                VerticalAlignment="Bottom"
                Margin="0,0,0,16"/>
        </Grid>
    </Grid>
</UserControl>
