<UserControl x:Class="Management.Presentation.Views.Shop.ShopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:Management.Presentation.Converters"
             xmlns:local="clr-namespace:Management.Presentation.Views.Shop"
             xmlns:vm="clr-namespace:Management.Presentation.ViewModels.Shop"
             xmlns:premium="clr-namespace:Management.Presentation.Controls.Premium"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="1080" d:DesignWidth="1440"
             Background="Transparent">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
        <converters:EqualToVisibilityConverter x:Key="EqualToVisibilityConverter"/>
        <converters:WindowWidthToColumnsConverter x:Key="WindowWidthToColumnsConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Controls -->
            <RowDefinition Height="*"/>    <!-- Content -->
        </Grid.RowDefinitions>

            <!-- 1. Header & Actions -->
            <Grid Grid.Row="0" Margin="{StaticResource MarginSectionBottom}">
<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{DynamicResource Icon.Storefront}" 
                          Style="{StaticResource Style.Icon.Large}" 
                          Stroke="{DynamicResource TextPrimaryBrush}"
                          Margin="0,0,12,0"/>
                    <TextBlock Text="{DynamicResource Terminology.Shop.Header}" 
                               Style="{StaticResource Title1}" 
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
</Grid>

            <!-- 2. Controls Area (Filter & Toggle OR Selection Bar) -->
            <Grid Grid.Row="1" Margin="{StaticResource MarginSectionBottom}">
                <!-- 2a. Normal Filters (Hidden in Selection Mode) -->
                <Grid Visibility="{Binding IsSelectionMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Filters -->
                        <ColumnDefinition Width="*"/>    <!-- Search -->
                        <ColumnDefinition Width="Auto"/> <!-- Actions -->
                    </Grid.ColumnDefinitions>

                    <!-- Filter Bar -->
                    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="{DynamicResource Terminology.Shop.Filter.All}" IsChecked="{Binding FilterAll}" Style="{StaticResource AppleFilterRadioButtonStyle}"/>
                            <RadioButton Content="{DynamicResource Terminology.Shop.Filter.Supplements}" IsChecked="{Binding FilterSupplements}" Style="{StaticResource AppleFilterRadioButtonStyle}"/>
                            <RadioButton Content="{DynamicResource Terminology.Shop.Filter.Apparel}" IsChecked="{Binding FilterApparel}" Style="{StaticResource AppleFilterRadioButtonStyle}"/>
                            <RadioButton Content="{DynamicResource Terminology.Shop.Filter.Equipment}" IsChecked="{Binding FilterEquipment}" Style="{StaticResource AppleFilterRadioButtonStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Search Bar -->
                    <ContentControl Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Width" Value="300"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Width" To="450" Duration="0:0:0.3">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Width" To="300" Duration="0:0:0.25">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseIn"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                        <premium:PremiumSearchBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 Placeholder="Search products..."
                                                 IconData="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                                 Height="44"/>
                    </ContentControl>

                    <!-- View Mode Toggle (Standardized Atrium Pattern) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Primary Action: Add Product -->
                        <Button Style="{StaticResource Button.Pill.Primary}"
                                Command="{Binding OpenAddProductCommand}"
                                Margin="0,0,24,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{DynamicResource IconPlus}" 
                                       Stroke="White"
                                       Style="{StaticResource Style.Icon.Small}"
                                       Margin="{StaticResource MarginIconRight}"/>
                                <TextBlock Text="{DynamicResource Terminology.Shop.AddProduct}"/>
                            </StackPanel>
                        </Button>

                        <!-- Separator -->
                        <Border Width="1" Height="24" Background="{DynamicResource SeparatorStroke}" Margin="0,0,24,0" Opacity="0.5"/>

                        <!-- View Mode Switcher -->
                        <Button Command="{Binding SwitchViewModeCommand}" 
                                CommandParameter="{x:Static vm:ShopViewMode.Grid}"
                                Style="{StaticResource IconButtonStyle}" 
                                ToolTip="{DynamicResource Terminology.Shop.View.Grid}" Margin="0,0,8,0">
                            <Path Data="{StaticResource IconDashboard}">
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource Style.Icon.Small}">
                                        <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ViewMode}" Value="{x:Static vm:ShopViewMode.Grid}">
                                                <Setter Property="Fill" Value="{DynamicResource BrandPrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                        <Button Command="{Binding SwitchViewModeCommand}" 
                                CommandParameter="{x:Static vm:ShopViewMode.List}"
                                Style="{StaticResource IconButtonStyle}" 
                                ToolTip="{DynamicResource Terminology.Shop.View.List}">
                            <Path Data="{StaticResource IconMenu}">
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource Style.Icon.Small}">
                                        <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ViewMode}" Value="{x:Static vm:ShopViewMode.List}">
                                                <Setter Property="Fill" Value="{DynamicResource BrandPrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 2b. Multi-Selection Context Bar -->
                <Border Background="{DynamicResource FacilityAccentBrush}" 
                        CornerRadius="16" 
                        Padding="16,8"
                        Visibility="{Binding IsSelectionMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding SelectAll}" 
                                      Style="{StaticResource CircularSelectionCheckBoxStyle}"
                                      Foreground="White"/>
                            <TextBlock Text="{DynamicResource Terminology.Shop.SelectAll}" 
                                       Foreground="White" 
                                       VerticalAlignment="Center" 
                                       Margin="8,0,0,0"
                                       FontWeight="Medium"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding SelectedCount, Converter={StaticResource StringFormatConverter}, ConverterParameter='Terminology.Shop.ProductsSelected'}" 
                                       Foreground="White" 
                                       VerticalAlignment="Center" 
                                       Margin="4,0,0,0"
                                       Opacity="0.9"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Command="{Binding DeleteSelectedCommand}" 
                                    ToolTip="{DynamicResource Terminology.Shop.DeleteSelection}"
                                    Width="40" Height="40"
                                    Cursor="Hand"
                                    Margin="0,0,16,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid x:Name="Root">
                                            <Ellipse Fill="{DynamicResource StatusErrorBrush}" Effect="{DynamicResource Shadow2}"/>
                                            <Path Data="{DynamicResource IconDelete}" 
                                                  Stroke="White" 
                                                  StrokeThickness="2"
                                                  Width="18" Height="18"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleX="1.1" ScaleY="1.1" CenterX="20" CenterY="20"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Root" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95" CenterX="20" CenterY="20"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            
                            <Button Command="{Binding ClearSelectionCommand}" 
                                    Style="{StaticResource SecondaryButton}" 
                                    Foreground="White"
                                    Opacity="0.8">
                                <TextBlock Text="{DynamicResource Terminology.Global.Cancel}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. Content Area -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

<!-- A. GRID VIEW (Visual Shopping) -->
                    <Grid Grid.Column="0" Visibility="{Binding ViewMode, Converter={StaticResource EqualToVisibilityConverter}, ConverterParameter={x:Static vm:ShopViewMode.Grid}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <ListBox x:Name="ShopGridListBox" Grid.Row="0"
                             Style="{StaticResource ListBox.Modern}"
                             ItemsSource="{Binding Products}" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True"
                             SelectedItem="{Binding SelectedProduct}">
                    <ListBox.Visibility>
                        <Binding Path="ViewMode" Converter="{StaticResource EqualToVisibilityConverter}" ConverterParameter="{x:Static vm:ShopViewMode.Grid}"/>
                    </ListBox.Visibility>
                    
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                             <UniformGrid VerticalAlignment="Top">
                                <UniformGrid.Columns>
                                    <Binding Path="ActualWidth" 
                                             RelativeSource="{RelativeSource AncestorType=Window}" 
                                             Converter="{StaticResource WindowWidthToColumnsConverter}">
                                        <Binding.ConverterParameter>
                                            <sys:Double>1440</sys:Double>
                                        </Binding.ConverterParameter>
                                    </Binding>
                                </UniformGrid.Columns>
                            </UniformGrid>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <local:ProductListItem Margin="0,0,20,20"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                 </ListBox>

                  <premium:ScrollIndicatorButton 
                      TargetScrollViewer="{Binding ElementName=ShopGridListBox}"
                      Grid.Row="0"
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Bottom"
                      Margin="0,0,0,24"/>

                <!-- Load More Button (Grid View) -->
                <Button Grid.Row="1" 
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding LoadMoreCommand}"
                        Visibility="{Binding HasMoreItems, Converter={StaticResource BoolToVisibilityConverter}}"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{DynamicResource IconPlus}" Style="{StaticResource Style.Icon.Micro}" Stroke="{DynamicResource BrandPrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource Terminology.Global.Action.LoadMore}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>

                <!-- B. LIST VIEW (Inventory Management) -->
                <Grid Grid.Column="0" Visibility="{Binding ViewMode, Converter={StaticResource EqualToVisibilityConverter}, ConverterParameter={x:Static vm:ShopViewMode.List}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox x:Name="ShopListViewListBox" Grid.Row="0"
                             Style="{StaticResource ListBox.Modern}"
                             ItemsSource="{Binding InventoryItems}" 
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True"
                             SelectedItem="{Binding SelectedProduct}">
                     <ListBox.Visibility>
                        <Binding Path="ViewMode" Converter="{StaticResource EqualToVisibilityConverter}" ConverterParameter="{x:Static vm:ShopViewMode.List}"/>
                    </ListBox.Visibility>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingStyle}"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                             <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                             <!-- New Template for Inventory Rows -->
                            <local:InventoryListItem />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                 </ListBox>

                  <premium:ScrollIndicatorButton 
                      TargetScrollViewer="{Binding ElementName=ShopListViewListBox}"
                      Grid.Row="0"
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Bottom"
                      Margin="0,0,0,24"/>

                <!-- Load More Button (List View) -->
                <Button Grid.Row="1" 
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding LoadMoreCommand}"
                        Visibility="{Binding HasMoreItems, Converter={StaticResource BoolToVisibilityConverter}}"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{DynamicResource IconPlus}" Style="{StaticResource Style.Icon.Micro}" Stroke="{DynamicResource BrandPrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource Terminology.Global.Action.LoadMore}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>

                <!-- C. DETAIL SLIDE-OUT -->
                 <Border Grid.Column="1" 
                         Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource MultiplyValueConverter}, ConverterParameter=0.45}" 
                        Background="{DynamicResource CardBackgroundBrush}" 
                        CornerRadius="32"
                        Margin="16,0,16,16"
                        Effect="{DynamicResource Shadow3}"
                        Visibility="{Binding DataContext.IsDetailOpen, RelativeSource={RelativeSource AncestorType=local:ShopView}, Converter={StaticResource BoolToVisibilityConverter}}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}">
                    <Border.RenderTransform>
                        <TranslateTransform X="800"/>
                    </Border.RenderTransform>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsDetailOpen, RelativeSource={RelativeSource AncestorType=local:ShopView}}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 From="800" To="0" Duration="0:0:0.4">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 To="800" Duration="0:0:0.4">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseIn"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    
                    <local:ProductDetailView DataContext="{Binding SelectedProduct}"/>
                </Border>

            <!-- Empty State Overlay (Z-Order: Top of content) -->
            <Grid Grid.Column="0"
                  VerticalAlignment="Center" 
                  HorizontalAlignment="Center"
                  Visibility="{Binding Products.Count, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=Inverse}">
                
                <Ellipse Width="240" Height="240" Fill="{DynamicResource FacilityAccentBrush}" Opacity="0.03" Margin="0,-40,0,0" />

                <StackPanel HorizontalAlignment="Center">
                    <Border Width="80" Height="80" 
                            Background="{DynamicResource FacilityAccentDimBrush}" 
                            CornerRadius="40" 
                            Margin="0,0,0,24">
                        <Path Data="{DynamicResource Icon.Storefront}" 
                              Fill="{DynamicResource FacilityAccentBrush}"
                              Width="36" Height="36"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="{DynamicResource Terminology.Shop.EmptyState}" 
                               FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="{DynamicResource Terminology.Shop.EmptyState.Description}" 
                               FontSize="16"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,32"
                               TextAlignment="Center"
                               MaxWidth="320"
                               TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="{DynamicResource Terminology.Shop.Action.AddProduct}"
                                Command="{Binding OpenAddProductCommand}"
                                Style="{StaticResource PrimaryButton}"
                                MinWidth="180"
                                Margin="0,0,12,0"/>
                        
                        <Button Content="{DynamicResource Terminology.Global.Action.ResetFilters}"
                                Command="{Binding ResetFiltersCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="16,0"
                                Visibility="{Binding SearchText, Converter={StaticResource StringToVisibilityConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
