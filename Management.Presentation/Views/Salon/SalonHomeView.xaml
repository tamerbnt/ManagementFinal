<UserControl x:Class="Management.Presentation.Views.Salon.SalonHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Management.Presentation.ViewModels.Salon"
             xmlns:behaviors="clr-namespace:Management.Presentation.Behaviors"
             xmlns:local="clr-namespace:Management.Presentation.Views.Salon"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1440"
             x:Name="SalonHomeControl">
    
    <UserControl.Resources>
        <Style x:Key="CarouselButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <!-- Sleek Sidebar Action Button -->
        <Style x:Key="FlatListButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0DFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- Dashboard Root Bounds: Locked strictly to Window size -->
    <Grid VerticalAlignment="Stretch" Margin="0,0,0,0">
        <i:Interaction.Triggers>
            <i:EventTrigger EventName="Loaded">
                <i:InvokeCommandAction Command="{Binding InitializeAsyncCommand}"/>
            </i:EventTrigger>
        </i:Interaction.Triggers>
        <!-- THE SKELETON LOADER -->
        <local:SalonHomeSkeleton Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- THE ACTUAL CONTENT -->
        <Grid Margin="0" Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- SECTION 0: DASHBOARD HEADER (Greeting + Primary Action) -->
            <Border Grid.Row="0" Grid.Column="0" 
                    Background="{DynamicResource CardBackgroundBrush}" 
                    CornerRadius="24" 
                    Padding="36,28" 
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />  <!-- Icon -->
                        <ColumnDefinition Width="*" />     <!-- Text -->
                    </Grid.ColumnDefinitions>

                    <!-- Salon Icon -->
                    <Path Data="{DynamicResource IconSalon}" 
                          Grid.Column="0"
                          Style="{DynamicResource Style.Icon.Large}" 
                          Stroke="{DynamicResource TextPrimaryBrush}"
                          Margin="0,0,24,0"
                          VerticalAlignment="Center"/>

                    <!-- 3-Layer Text Stack -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Vertical">
                        <!-- Layer 1: Greeting Label (Good afternoon) - Accent Color, Small, Medium Weight -->
                        <TextBlock Text="{Binding GreetingLabel}" 
                                   FontSize="13" 
                                   FontWeight="Medium" 
                                   Foreground="{DynamicResource FacilityAccentBrush}" 
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,4"/>
                        <!-- Layer 2: Name - Large, SemiBold -->
                        <TextBlock Text="{Binding GreetingName}" 
                                   FontSize="54" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                   TextTrimming="CharacterEllipsis"
                                   FontFamily="Segoe UI Variable Display"
                                   Margin="0,-4,0,0"/>
                        <!-- Layer 3: Subtitle - Smaller, Secondary, with more top margin -->
                        <TextBlock Text="{DynamicResource Terminology.Home.Subtitle}" 
                                   FontSize="17" 
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" 
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,8,0,0"
                                   Opacity="0.7"/>
                    </StackPanel>
                </Grid>
            </Border>



            <!-- ZONE 1: CORE (Metrics + Activity) -->
            <Grid Grid.Row="1" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Hero + Metrics Strip -->
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- HERO + METRICS STRIP -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/> <!-- Next Appointment Hero -->
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1*"/>     <!-- Appointments -->
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1*"/>     <!-- Revenue -->
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1*"/>     <!-- Utilization -->
                    </Grid.ColumnDefinitions>

                    <!-- HERO: NEXT APPOINTMENT CAROUSEL -->
                    <Border Grid.Column="0" MinHeight="100" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="16" Padding="18,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>  <!-- Label row -->
                                <RowDefinition Height="*"/>     <!-- Content row -->
                                <RowDefinition Height="Auto"/>  <!-- Footer: arrows + counter -->
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Header label -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Path Data="{DynamicResource IconCalendar}" Stroke="{DynamicResource FacilityAccentBrush}" StrokeThickness="1.8" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{DynamicResource Terminology.Salon.Home.NextAppointment}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Card.Foreground}" VerticalAlignment="Center" Opacity="0.6"/>
                            </StackPanel>

                            <!-- CONTENT: appointment info -->
                            <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,0,0"
                                        Visibility="{Binding HasNoUpcoming, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding CurrentUpcoming.ClientName, FallbackValue='—'}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Brush.Card.Foreground}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding CurrentUpcoming.ServiceName, FallbackValue='—'}" FontSize="12" Foreground="{DynamicResource FacilityAccentBrush}" FontWeight="Medium"/>
                                <StackPanel Orientation="Horizontal" Opacity="0.5" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding CurrentUpcoming.StartTime, StringFormat=HH:mm}" FontSize="11" Foreground="{DynamicResource Brush.Card.Foreground}"/>
                                    <TextBlock Text=" • " Foreground="{DynamicResource Brush.Card.Foreground}"/>
                                    <TextBlock Text="{Binding CurrentUpcoming.StaffName}" FontSize="11" Foreground="{DynamicResource Brush.Card.Foreground}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- EMPTY STATE -->
                            <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,0,0"
                                        Visibility="{Binding HasNoUpcoming, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{DynamicResource Terminology.Salon.Home.NoUpcoming}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Brush.Card.Foreground}"/>
                                <TextBlock Text="Dashboard" FontSize="12" Opacity="0.4" Foreground="{DynamicResource Brush.Card.Foreground}"/>
                            </StackPanel>

                            <!-- CONTROLS (AT RIGHT - GYM STYLE) -->
                            <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0"
                                        Visibility="{Binding HasMultipleUpcoming, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <!-- Prev arrow -->
                                <Button Command="{Binding PreviousUpcomingCommand}" Style="{StaticResource CarouselButtonStyle}" Margin="0,0,0,8">
                                    <Path Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z"
                                          Fill="{DynamicResource Brush.Card.Foreground}" Width="16" Height="16" Stretch="Uniform" Opacity="0.4"/>
                                </Button>
                                <!-- Counter -->
                                <TextBlock Text="{Binding UpcomingPosition}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Card.Foreground}" HorizontalAlignment="Center" Opacity="0.6"/>
                                <!-- Next arrow -->
                                <Button Command="{Binding NextUpcomingCommand}" Style="{StaticResource CarouselButtonStyle}" Margin="0,8,0,0">
                                    <Path Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"
                                          Fill="{DynamicResource Brush.Card.Foreground}" Width="16" Height="16" Stretch="Uniform" Opacity="0.4"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- APPOINTMENTS COUNT -->
                    <Border Grid.Column="2" MinHeight="100" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="16" Padding="18,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- HEADER -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,8">
                                <Path Data="{DynamicResource IconCalendar}" Stroke="{DynamicResource FacilityAccentBrush}" StrokeThickness="1.8" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{DynamicResource Terminology.Dashboard.Stat.Appointments}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Card.Foreground}" VerticalAlignment="Center" Opacity="0.6"/>
                            </StackPanel>
                            <!-- CONTENT -->
                            <TextBlock Grid.Row="1" Text="{Binding AppointmentsTodayCount}" FontSize="38" FontWeight="Bold" Foreground="{DynamicResource Brush.Card.Foreground}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Text="today" FontSize="11" Opacity="0.4" Foreground="{DynamicResource Brush.Card.Foreground}" Margin="0,4,0,0"/>
                        </Grid>
                    </Border>

                    <!-- REVENUE -->
                    <Border Grid.Column="4" MinHeight="100" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="16" Padding="18,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- HEADER -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,12">
                                <Path Data="{DynamicResource IconFinance}" Stroke="#A78BFA" StrokeThickness="1.8" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{DynamicResource Terminology.Dashboard.Stat.Revenue}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Card.Foreground}" VerticalAlignment="Center" Opacity="0.6"/>
                            </StackPanel>
                            <!-- CONTENT -->
                            <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TotalRevenueToday, Converter={StaticResource AbbreviatedCurrencyConverter}}" 
                                           FontSize="38" FontWeight="Bold" Foreground="{DynamicResource Brush.Card.Foreground}"/>
                            </Viewbox>
                            <TextBlock Grid.Row="2" Text="gross revenue" FontSize="11" Opacity="0.4" Foreground="{DynamicResource Brush.Card.Foreground}" Margin="0,4,0,0"/>
                        </Grid>
                    </Border>

                    <!-- UTILIZATION -->
                    <Border Grid.Column="6" MinHeight="100" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="16" Padding="18,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- HEADER -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,8">
                                <Path Data="{DynamicResource IconApparatus}" Stroke="{DynamicResource FacilityAccentBrush}" StrokeThickness="1.8" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{DynamicResource Terminology.Salon.Home.ChairUtilization}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Card.Foreground}" VerticalAlignment="Center" Opacity="0.6"/>
                            </StackPanel>
                            <!-- CONTENT -->
                            <TextBlock Grid.Row="1" Text="{Binding ChairUtilization, StringFormat={}{0:P0}}" FontSize="38" FontWeight="Bold" Foreground="{DynamicResource Brush.Card.Foreground}" VerticalAlignment="Center"/>
                            <Border Grid.Row="2" Background="{DynamicResource Brush.Success}" CornerRadius="6" Padding="6,3" HorizontalAlignment="Left" Margin="0,6,0,0">
                                <TextBlock Text="{DynamicResource Terminology.Salon.Home.Optimal}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- RECENT ACTIVITY -->
                <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="24" Padding="20" Effect="{DynamicResource Shadow2}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header -->
                            <RowDefinition Height="Auto"/> <!-- Separator -->
                            <RowDefinition Height="*"/>    <!-- List -->
                        </Grid.RowDefinitions>
                        
                        <!-- Header -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <Path Data="{DynamicResource IconHistory}" Stroke="{DynamicResource FacilityAccentBrush}" StrokeThickness="1.8" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="{DynamicResource Terminology.Home.RecentActivity}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Brush.Card.Foreground}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Sub-header Separator (Gym Style Parity) -->
                        <Border Grid.Row="1" Height="1" Background="{DynamicResource FacilityAccentBrush}" Opacity="0.1" Margin="0,0,0,20"/>
                                            <!-- List & Empty State Container -->
                        <Grid Grid.Row="2">
                            <!-- THE LIST -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                          Visibility="{Binding IsActivityEmpty, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding ActivityStream}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Brush.Surface.Secondary}" CornerRadius="16" Padding="14,12" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/> <!-- Avatar -->
                                                        <ColumnDefinition Width="*"/>    <!-- Content -->
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <!-- AVATAR / ICON -->
                                                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="12" Background="{DynamicResource FacilityAccentDimBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                                        <Grid>
                                                            <TextBlock Text="{Binding AvatarInitials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource FacilityAccentBrush}" Opacity="0.8"/>
                                                            <TextBlock Text="{Binding Icon}" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="12" Margin="0,0,-4,-4"/>
                                                        </Grid>
                                                    </Border>
                                                    
                                                    <!-- 2-LINE GRID CONTENT -->
                                                    <Grid Grid.Column="1">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/> <!-- Line 1: Name + Time -->
                                                            <RowDefinition Height="Auto"/> <!-- Line 2: Status + Relative -->
                                                        </Grid.RowDefinitions>
                                                        
                                                        <!-- LINE 1: Identity & Exact Time -->
                                                        <TextBlock Grid.Row="0" Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource Brush.Card.Foreground}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Row="0" Text="{Binding Timestamp, StringFormat=HH:mm}" FontWeight="SemiBold" FontSize="12" Opacity="0.5" Foreground="{DynamicResource Brush.Card.Foreground}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        
                                                        <!-- LINE 2: Action & Relative Time -->
                                                        <TextBlock Grid.Row="1" Text="{Binding Status}" FontSize="13" Opacity="0.7" Foreground="{DynamicResource Brush.Card.Foreground}" Margin="0,2,0,0" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Row="1" Text="{Binding RelativeTime}" FontSize="12" Opacity="0.4" Foreground="{DynamicResource Brush.Card.Foreground}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,2,0,0"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- EMPTY STATE ILLUSTRATION (Absolute centered) -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0"
                                        Visibility="{Binding IsActivityEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Viewbox Width="60" Height="60" Opacity="0.1" Margin="0,0,0,10">
                                    <Path Data="{DynamicResource IconHistory}" Fill="{DynamicResource Brush.Card.Foreground}"/>
                                </Viewbox>
                                <TextBlock Text="A fresh start today." 
                                           FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" 
                                           Foreground="{DynamicResource Brush.Card.Foreground}" Opacity="0.6"/>
                                <TextBlock Text="All your client activities will appear here." 
                                           FontSize="12" HorizontalAlignment="Center" 
                                           Foreground="{DynamicResource Brush.Card.Foreground}" Opacity="0.4" Margin="0,2,0,0"/>

                                <!-- ACTION BUTTON -->
                                <Button Command="{Binding RegisterMemberCommand}" 
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0,16,0,0"
                                        HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{DynamicResource IconPlus}" Stroke="{DynamicResource Brush.Neutral.White}" StrokeThickness="1.8" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Terminology.Home.Action.CreateMember}" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Neutral.White}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ZONE 2: ACTION SIDEBAR (EXACT GYM PARITY) -->
            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" 
                    Background="{DynamicResource CardBackgroundBrush}" 
                    CornerRadius="16" 
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Quick Actions List -->
                        <RowDefinition Height="*"/>    <!-- Guide / Alerts Section -->
                        <RowDefinition Height="Auto"/> <!-- Status / Clock Footer -->
                    </Grid.RowDefinitions>

                    <!-- 1. QUICK ACTIONS (Sleek Vertical List) -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="QUICK ACTIONS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" Margin="4,0,0,12"/>

                        <!-- Quick Sale -->
                        <Border Background="{DynamicResource FacilitySidebarBrush}" CornerRadius="16" Padding="4,2" Margin="0,0,0,8">
                            <Button Style="{StaticResource FlatListButton}" Command="{Binding SellItemCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{DynamicResource IconPlus}" Stroke="{DynamicResource FacilityAccentBrush}" StrokeThickness="1.8" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource Terminology.Home.Action.QuickSale}" FontSize="13" Foreground="{DynamicResource Brush.Neutral.White}" VerticalAlignment="Center"/>
                                    <Path Grid.Column="2" Data="M0,0 L4,4 L0,8" Stroke="{DynamicResource Brush.Neutral.White}" StrokeThickness="1.5" MaxWidth="6" Stretch="Uniform" Opacity="0.3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </Border>

                        <!-- Create Member -->
                        <Border Background="{DynamicResource FacilitySidebarBrush}" CornerRadius="16" Padding="4,2" Margin="0,0,0,8">
                            <Button Style="{StaticResource FlatListButton}" Command="{Binding RegisterMemberCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{DynamicResource IconMembers}" Stroke="{DynamicResource Brush.Neutral.White}" StrokeThickness="1.8" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0.8"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource Terminology.Home.Action.CreateMember}" FontSize="13" Foreground="{DynamicResource Brush.Neutral.White}" Opacity="0.9" VerticalAlignment="Center"/>
                                    <Path Grid.Column="2" Data="M0,0 L4,4 L0,8" Stroke="{DynamicResource Brush.Neutral.White}" StrokeThickness="1.5" MaxWidth="6" Stretch="Uniform" Opacity="0.3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </Border>

                        <!-- Walk-in -->
                        <Border Background="{DynamicResource FacilitySidebarBrush}" CornerRadius="16" Padding="4,2" Margin="0,0,0,8">
                            <Button Style="{StaticResource FlatListButton}" Command="{Binding ProcessWalkInCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{DynamicResource IconHistory}" Stroke="{DynamicResource Brush.Neutral.White}" StrokeThickness="1.8" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0.8"/>
                                    <TextBlock Grid.Column="1" Text="Walk-in" FontSize="13" Foreground="{DynamicResource Brush.Neutral.White}" Opacity="0.9" VerticalAlignment="Center"/>
                                    <Path Grid.Column="2" Data="M0,0 L4,4 L0,8" Stroke="{DynamicResource Brush.Neutral.White}" StrokeThickness="1.5" MaxWidth="6" Stretch="Uniform" Opacity="0.3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </Border>

                        <!-- Multi-Sale -->
                        <Border Background="{DynamicResource FacilitySidebarBrush}" CornerRadius="16" Padding="4,2" Margin="0,0,0,8">
                            <Button Style="{StaticResource FlatListButton}" Command="{Binding OpenMultiSaleCartCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{DynamicResource IconCart}" Stroke="{DynamicResource Brush.Neutral.White}" StrokeThickness="1.8" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0.8"/>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource Terminology.Home.Action.MultiSale}" FontSize="13" Foreground="{DynamicResource Brush.Neutral.White}" Opacity="0.9" VerticalAlignment="Center"/>
                                    <Path Grid.Column="2" Data="M0,0 L4,4 L0,8" Stroke="{DynamicResource Brush.Neutral.White}" StrokeThickness="1.5" MaxWidth="6" Stretch="Uniform" Opacity="0.3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </Border>

                        <!-- Separator -->
                        <Border Height="1" Background="{DynamicResource Brush.Border.Subtle}" Margin="0,16,0,0"/>
                    </StackPanel>

                    <!-- 2. GUIDE / ALERTS SWIPER -->
                    <Grid Grid.Row="1" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Header: Segmented Toggle -->
                        <Grid Grid.Row="0" Margin="4,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <!-- Guide Tab -->
                                <Grid Margin="0,0,24,0">
                                    <TextBlock Text="GUIDE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" Cursor="Hand">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Opacity" Value="0.4"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentSidebarMode}" Value="Guide">
                                                        <Setter Property="Opacity" Value="1.0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <TextBlock.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding SetSidebarModeCommand}" CommandParameter="Guide"/>
                                        </TextBlock.InputBindings>
                                    </TextBlock>
                                    <Border Height="2" VerticalAlignment="Bottom" Background="{DynamicResource FacilityAccentBrush}" Margin="0,0,0,-6" Width="12" HorizontalAlignment="Left" CornerRadius="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentSidebarMode}" Value="Guide">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Grid>

                                <!-- Alerts Tab -->
                                <Grid>
                                    <TextBlock Text="ALERTS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" Cursor="Hand">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Opacity" Value="0.4"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentSidebarMode}" Value="Alerts">
                                                        <Setter Property="Opacity" Value="1.0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <TextBlock.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding SetSidebarModeCommand}" CommandParameter="Alerts"/>
                                        </TextBlock.InputBindings>
                                    </TextBlock>
                                    <Border Height="2" VerticalAlignment="Bottom" Background="{DynamicResource FacilityAccentBrush}" Margin="0,0,0,-6" Width="12" HorizontalAlignment="Left" CornerRadius="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentSidebarMode}" Value="Alerts">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Content Switcher -->
                        <Grid Grid.Row="1">
                            <!-- 1. GUIDE CONTENT -->
                            <Grid x:Name="GuideContent">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSidebarMode}" Value="Guide">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Swippable Card -->
                                <Border Grid.Row="0" Background="{DynamicResource FacilitySidebarBrush}" CornerRadius="12" BorderThickness="0" Padding="20" VerticalAlignment="Stretch" Cursor="Hand" ToolTip="Click to view next tip">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{Binding NextGuideTipCommand}"/>
                                    </Border.InputBindings>
                                    <StackPanel VerticalAlignment="Center">
                                        <Border Background="{DynamicResource FacilityAccentDimBrush}" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,16">
                                            <TextBlock Text="{Binding CurrentGuide.StepBadge, FallbackValue='STEP 1'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FacilityAccentBrush}"/>
                                        </Border>
                                        <TextBlock Text="{Binding CurrentGuide.Title, FallbackValue='Loading Guide...'}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Neutral.White}" Margin="0,0,0,10"/>
                                        <TextBlock Text="{Binding CurrentGuide.Description, FallbackValue='Please wait while the visual guide instructions are prepared and loaded.'}" FontSize="15" Foreground="{DynamicResource Brush.Neutral.White}" Opacity="0.9" TextWrapping="Wrap" LineHeight="22"/>
                                    </StackPanel>
                                </Border>
                                
                                <!-- Pagination Dots -->
                                <ListBox Grid.Row="1" ItemsSource="{Binding GuideTips}" SelectedItem="{Binding CurrentGuide, Mode=TwoWay}" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" Margin="0,16,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border Background="Transparent" Padding="3,6" Cursor="Hand">
                                                            <Border x:Name="Dot" Width="6" Height="6" CornerRadius="3" Background="{DynamicResource Brush.Text.Primary}" Opacity="0.2"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Dot" Property="Opacity" Value="1.0"/>
                                                                <Setter TargetName="Dot" Property="Background" Value="{DynamicResource FacilityAccentBrush}"/>
                                                                <Setter TargetName="Dot" Property="Width" Value="16"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Grid>

                            <!-- 2. ALERTS CONTENT -->
                            <Grid x:Name="AlertsContent">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSidebarMode}" Value="Alerts">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SystemAlerts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource FacilitySidebarBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderThickness="0">
                                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource Brush.Neutral.White}" Opacity="0.8" TextWrapping="Wrap"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- 3. BOTTOM FOOTER (Time & Status) -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                        <Border Height="1" Background="{DynamicResource Brush.Border.Subtle}" Margin="0,0,0,16"/>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Large Compact Clock -->
                            <TextBlock Grid.Column="0" Text="{Binding CurrentTime}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center"/>
                            
                            <!-- Date & Status Alignment Right -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentDate}" FontSize="10" Foreground="{DynamicResource Brush.Text.Primary}" Opacity="0.6" HorizontalAlignment="Right" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource FacilityAccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="All systems online" FontSize="10" Foreground="{DynamicResource FacilityAccentBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>


        </Grid>
    </Grid>
</UserControl>
