<UserControl x:Class="Management.Presentation.Views.Auth.TrialExpiredView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Management.Presentation.Views.Auth"
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="460"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="LicenseInputBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Height" Value="48"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource FacilityAccentBrush}"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="{DynamicResource FacilityAccentColor}" 
                                              BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <StackPanel VerticalAlignment="Top" Margin="40,28,40,36">

            <!-- ROW 1 — ATRIUM BRAND LOGO -->
            <Grid Margin="0,4,0,8">
                <Image Source="/Assets/atrium_header_logo.png"
                       Height="100"
                       HorizontalAlignment="Left"
                       Margin="-25,0,0,0"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Stretch="Uniform"
                       ToolTip="Atrium Management System"/>
            </Grid>

            <!-- ROW 2 — BADGE -->
            <Border Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1"
                    CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M13,17H11V15H13V17M13,13H11V7H13V13Z"
                          Fill="#D97706" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="EVALUATION PERIOD EXPIRED" FontSize="11" FontWeight="Bold" Foreground="#92400E"
                               FontFamily="Segoe UI Variable Display, Segoe UI"/>
                </StackPanel>
            </Border>

            <!-- ROW 3 — TITLE -->
            <TextBlock Text="Upgrade Your Plan"
                       FontSize="30" FontWeight="ExtraBold"
                       Foreground="#0F172A"
                       Margin="0,0,0,6"
                       FontFamily="Segoe UI Variable Display, Segoe UI"/>

            <!-- ROW 4 — SUBTITLE / EXPIRY NOTICE -->
            <TextBlock Text="{Binding ExpiryNotice}"
                       FontSize="13" Foreground="#6B7280"
                       TextWrapping="Wrap" LineHeight="18"
                       Margin="0,0,0,16"
                       FontFamily="Segoe UI Variable Display, Segoe UI"/>

            <!-- ROW 5 — DATA PRESERVATION GUARANTEE BANNER -->
            <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1"
                    CornerRadius="10" Padding="12" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Shield/Checkmark icon -->
                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="#DCFCE7" VerticalAlignment="Top" Margin="0,0,10,0">
                        <Path Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M10,17L6,13L7.41,11.59L10,14.17L16.59,7.58L18,9L10,17Z"
                              Fill="#16A34A" Width="14" Height="14" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="100% Data Preserved" FontSize="12" FontWeight="Bold" Foreground="#15803D"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"/>
                        <TextBlock Text="All your transactions, records, and database configurations remain fully intact. Simply enter a license key to resume operating immediately."
                                   FontSize="11" Foreground="#166534" Margin="0,2,0,0" TextWrapping="Wrap" LineHeight="15"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ROW 6 — LICENSE / VOUCHER KEY FIELD -->
            <StackPanel Margin="0,0,0,16">
                <!-- Label Row -->
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="ENTER VOUCHER / LICENSE KEY"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="#374151"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable Display, Segoe UI"/>
                </Grid>

                <Border Style="{StaticResource LicenseInputBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Key Icon -->
                        <Path Grid.Column="0"
                              Data="M7,14A2,2 0 0,1 5,12A2,2 0 0,1 7,10A2,2 0 0,1 9,12A2,2 0 0,1 7,14M12.65,10C11.83,7.67 9.61,6 7,6A6,6 0 0,0 1,12A6,6 0 0,0 7,18C9.61,18 11.83,16.33 12.65,14H17V18H21V14H23V10H12.65Z"
                              Fill="#D1D5DB"
                              Width="16" Height="16" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <!-- Text Input -->
                        <TextBox Grid.Column="1"
                                 Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#111827"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,12,0"
                                 CaretBrush="#C4785A"
                                 FontFamily="Segoe UI Variable Display, Segoe UI"
                                 Tag="ATR-XXXX-XXXX-XXXX"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ROW 7 — ERROR STATE -->
            <Border Background="{DynamicResource StatusErrorBackground}"
                    BorderBrush="{DynamicResource Brush.Danger}"
                    BorderThickness="1" CornerRadius="10" Padding="12,10"
                    Margin="0,0,0,14"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Data="M13,13H11V7H13M13,17H11V15H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"
                          Fill="{DynamicResource Brush.Danger}"
                          Width="14" Height="14" Stretch="Uniform"
                          VerticalAlignment="Top" Margin="0,2,0,0"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource Brush.Danger}"
                               FontSize="12" TextWrapping="Wrap" Margin="8,0,0,0"
                               FontFamily="Segoe UI Variable Display, Segoe UI"/>
                </Grid>
            </Border>

            <!-- ROW 8 — ACTIONS ROW (UPGRADE + EXIT) -->
            <Grid Margin="0,4,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- UPGRADE BUTTON -->
                <Button Grid.Column="0"
                        Command="{Binding RedeemCommand}"
                        Height="46"
                        IsDefault="True"
                        Margin="0,0,8,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="#E5E7EB"
                                    CornerRadius="10"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="BtnScale" ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="btnText"
                                               Text="Activate License"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="#9CA3AF"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"/>
                                    <Path x:Name="btnChevron"
                                          Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"
                                          Fill="#9CA3AF"
                                          Width="10" Height="10" Stretch="Uniform"
                                          Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    <ProgressBar x:Name="busyBar"
                                                 IsIndeterminate="True"
                                                 Width="50" Height="3"
                                                 Background="Transparent"
                                                 Foreground="White"
                                                 BorderThickness="0"
                                                 Visibility="Collapsed"
                                                 Margin="8,0,0,0"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="True">
                                    <Setter TargetName="border" Property="Background"
                                            Value="{DynamicResource FacilityAccentBrush}"/>
                                    <Setter TargetName="btnText" Property="Foreground" Value="White"/>
                                    <Setter TargetName="btnChevron" Property="Fill" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="#E5E7EB"/>
                                    <Setter TargetName="btnText" Property="Foreground" Value="#9CA3AF"/>
                                    <Setter TargetName="btnChevron" Property="Fill" Value="#9CA3AF"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 To="0.97" Duration="0:0:0.05"/>
                                                <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 To="0.97" Duration="0:0:0.05"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 To="1.0" Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 To="1.0" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter TargetName="btnText" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="btnChevron" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="busyBar" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- EXIT BUTTON -->
                <Button Grid.Column="1"
                        Command="{Binding ExitAppCommand}"
                        Width="100" Height="46">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="#F1F5F9"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Cursor="Hand">
                                <TextBlock Text="Exit App"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="#64748B"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                    <Setter Property="Foreground" Value="#334155"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- ROW 9 — "Powered by From Scratch" -->
            <Grid Margin="0,12,0,0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="Powered by"
                               FontSize="10" Foreground="#6B7280" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               FontFamily="Segoe UI Variable Display, Segoe UI"/>
                    <Border Width="110" Height="80" 
                            Background="#111827"
                            HorizontalAlignment="Center"
                            Margin="0,4,0,0"
                            ToolTip="Powered by From Scratch">
                        <Border.OpacityMask>
                            <ImageBrush ImageSource="/Assets/from_scratch_logo.png" 
                                        Stretch="Uniform" 
                                        RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border.OpacityMask>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Opacity" Value="0.9"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="1.0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>
            </Grid>

        </StackPanel>
    </Grid>
</UserControl>
