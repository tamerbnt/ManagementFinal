<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Identity Layer: GYM FACILITY (DARK MODE OVERRIDE) -->
    
    <!-- Sidebar - Deeper Navy for Dark Mode -->
    <Color x:Key="FacilitySidebarBrush.Color">#212842</Color>
    <SolidColorBrush x:Key="FacilitySidebarBrush" Color="{StaticResource FacilitySidebarBrush.Color}"/>
    
    <!-- Accents - Warm Gold Glow -->
    <Color x:Key="FacilityAccentColor">#C9A96E</Color>
    <Color x:Key="FacilityAccentShadowColor">#C9A96E</Color>
    
    <LinearGradientBrush x:Key="FacilityAccentGradient" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#C9A96E" Offset="0"/>
        <GradientStop Color="#E0C28A" Offset="1"/>
    </LinearGradientBrush>
    
    <SolidColorBrush x:Key="FacilityAccentBrush" Color="{StaticResource FacilityAccentColor}"/>
    <!-- Increased opacity for dark mode glow visibility -->
    <SolidColorBrush x:Key="FacilityAccentDimBrush" Color="{StaticResource FacilityAccentColor}" Opacity="0.25"/>
    
    <!-- Contrast Tokens -->
    <SolidColorBrush x:Key="OnAccentPrimary" Color="#0B1224"/> <!-- Deep Navy text on Cyan for visibility -->
    <SolidColorBrush x:Key="OnAccentSecondary" Color="#1E293B"/>
    
    <!-- Status Backgrounds (Deep/Rich Colors for Dark Mode) -->
    <SolidColorBrush x:Key="StatusErrorBackground" Color="#450A0A" Opacity="0.4"/> <!-- Deep Red -->
    <SolidColorBrush x:Key="StatusSuccessBackground" Color="#064E3B" Opacity="0.4"/> <!-- Deep Green -->
    
    <!-- Component Specific Overrides -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#333333"/>
    <SolidColorBrush x:Key="Brush.Card.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#1E293B" Opacity="0.6"/>
    
    <!-- Illustration & UI Toggles -->
    <Visibility x:Key="Visibility.HomeIllustration">Collapsed</Visibility>
    
    <!-- Aliases -->
    <SolidColorBrush x:Key="AccentBrush" Color="#C9A96E"/>
    <Color x:Key="AccentColor">#C9A96E</Color>
    <SolidColorBrush x:Key="IllustrationBackgroundBrush" Color="#1C2945"/>
    
    <sys:String x:Key="TerminologyLabel">Member</sys:String>
</ResourceDictionary>
