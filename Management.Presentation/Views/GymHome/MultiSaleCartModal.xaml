<UserControl x:Class="Management.Presentation.Views.GymHome.MultiSaleCartModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Management.Presentation.ViewModels.GymHome"
             xmlns:premium="clr-namespace:Management.Presentation.Controls.Premium"
             xmlns:converters="clr-namespace:Management.Presentation.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:MultiSaleCartViewModel}"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:CountToBooleanConverter x:Key="CountToBooleanConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="InverseNullToVisibilityConverter" Inverted="True"/>

        <!-- Missing icon aliases -->
        <StreamGeometry x:Key="IconMember">M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 7a4 4 0 1 0 0-8 4 4 0 0 0 0 8M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75</StreamGeometry>
        
        <!-- Selection Highlight Style -->
        <Style x:Key="SelectionItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" 
                                CornerRadius="12" 
                                BorderThickness="1.5" 
                                BorderBrush="#F3F4F6"
                                Background="{DynamicResource Brush.Surface.Glass}"
                                Padding="12"
                                Margin="0,0,0,8"
                                Cursor="Hand">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource FacilityAccentBrush}"/>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F0FDFA"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource FacilityAccentBrush}"/>
                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stepper Button Style -->
        <Style x:Key="StepperButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabToggleStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" CornerRadius="10" Padding="24,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                    </DataTemplate>
                                </ContentPresenter.ContentTemplate>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.06"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="#111827"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <premium:ModalShellControl Title="{Binding Title}"
                               Subtitle="{DynamicResource Terminology.GymHome.MultiSale.Subtitle}"
                               Width="900" 
                               CancelCommand="{Binding CancelCommand}"
                               SaveCommand="{Binding CheckoutCommand}"
                               PrimaryActionText="{DynamicResource Terminology.GymHome.MultiSale.Summary.Checkout}">

        <Grid Height="500" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Tabs -->
                <RowDefinition Height="*"/>    <!-- Split Content -->
            </Grid.RowDefinitions>

            <!-- 1. TABS -->
            <Border Grid.Row="0" Background="#F3F4F6" CornerRadius="14" Padding="4" HorizontalAlignment="Center" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="{DynamicResource Terminology.GymHome.MultiSale.Tab.Products}" 
                                 IsChecked="{Binding CurrentTab, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Products}"
                                 Command="{Binding SwitchTabCommand}"
                                 CommandParameter="Products"
                                 Style="{StaticResource TabToggleStyle}"/>
                    <RadioButton Content="{DynamicResource Terminology.GymHome.MultiSale.Tab.WalkIn}" 
                                 IsChecked="{Binding CurrentTab, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=WalkIn}"
                                 Command="{Binding SwitchTabCommand}"
                                 CommandParameter="WalkIn"
                                 Style="{StaticResource TabToggleStyle}"/>
                </StackPanel>
            </Border>

            <!-- 2. SPLIT LAYOUT -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*"/> <!-- Left: Selection -->
                    <ColumnDefinition Width="32"/>    <!-- Spacer -->
                    <ColumnDefinition Width="*"/>    <!-- Right: Control Panel (Stationary) -->
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: INDEPENDENT SCROLLING LIST -->
                <Grid Grid.Column="0">
                    <!-- Products View -->
                    <StackPanel Visibility="{Binding CurrentTab, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Products}">
                        <premium:PremiumSearchBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                 Placeholder="Search inventory..."
                                                 IconData="{StaticResource IconSearch}"
                                                 Margin="0,0,0,12"/>
                        
                        <ListBox ItemsSource="{Binding Products}" 
                                 SelectedItem="{Binding SelectedProduct}"
                                 ItemContainerStyle="{StaticResource SelectionItemStyle}"
                                 Style="{StaticResource PremiumListBox}"
                                 BorderThickness="0"
                                 Height="400"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"> 
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                            <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Price, StringFormat='{}{0:N2} DA'}" FontSize="14" FontWeight="Bold" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                        
                                        <!-- Row Unselect (VISIBLE ONLY WHEN SELECTED) -->
                                        <Button Grid.Column="2" 
                                                Command="{Binding DataContext.ClearSelectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{DynamicResource Button.Ghost}" Width="32" Height="32" Padding="8"
                                                Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" Fill="#EF4444" Stretch="Uniform"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!-- Walk-In View -->
                    <StackPanel Visibility="{Binding CurrentTab, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=WalkIn}">
                        <premium:PremiumSearchBox Text="{Binding WalkInSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                 Placeholder="Search walk-in plans..."
                                                 IconData="{StaticResource IconSearch}"
                                                 Margin="0,0,0,12"/>

                        <ListBox ItemsSource="{Binding FilteredWalkInPlans}" 
                                 SelectedItem="{Binding SelectedWalkInPlan}"
                                 ItemContainerStyle="{StaticResource SelectionItemStyle}"
                                 Style="{StaticResource PremiumListBox}"
                                 BorderThickness="0"
                                 Height="400"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                            <TextBlock Text="Standard Entry" FontSize="11" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Price, StringFormat='{}{0:N2} DA'}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>

                                        <!-- Row Unselect -->
                                        <Button Grid.Column="2" 
                                                Command="{Binding DataContext.ClearSelectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{DynamicResource Button.Ghost}" Width="32" Height="32" Padding="8"
                                                Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" Fill="#EF4444" Stretch="Uniform"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Grid>

                <!-- RIGHT COLUMN: INDEPENDENT SCROLLING CONTROLS -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Height="400">
                    <StackPanel>
                        <!-- 0. MEMBER SEARCH -->
                        <Border Background="{DynamicResource Brush.Surface.Card}" CornerRadius="16" Padding="12" Margin="0,0,0,16" BorderBrush="#F3F4F6" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Link Member (Optional)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,0,8"/>
                                
                                <Grid Visibility="{Binding SelectedMember, Converter={StaticResource InverseNullToVisibilityConverter}}">
                                    <premium:PremiumSearchBox Text="{Binding MemberSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                            Placeholder="Search members..."
                                                            IconData="{StaticResource IconSearch}"/>
                                    
                                    <!-- Search Results Popup -->
                                    <Popup IsOpen="{Binding SearchedMembers.Count, Converter={StaticResource CountToBooleanConverter}, Mode=OneWay}" 
                                           PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Grid}}"
                                           StaysOpen="False" AllowsTransparency="True" Placement="Bottom" PopupAnimation="Fade">
                                        <Border Background="White" CornerRadius="12" BorderThickness="1" BorderBrush="#E5E7EB" Width="260" Margin="4">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="15" ShadowDepth="5" Opacity="0.1"/>
                                            </Border.Effect>
                                            <ListBox ItemsSource="{Binding SearchedMembers}" BorderThickness="0" Background="Transparent" MaxHeight="250">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding PlacementTarget.DataContext.SelectMemberCommand, RelativeSource={RelativeSource AncestorType=Popup}}"
                                                                CommandParameter="{Binding}" Style="{DynamicResource Button.Ghost}" HorizontalContentAlignment="Left" Padding="12,8">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="13"/>
                                                                <TextBlock Text="{Binding PhoneNumber}" FontSize="11" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <!-- Selected Member Badge -->
                                <Border Background="#EFF6FF" CornerRadius="10" Padding="10,6" Visibility="{Binding SelectedMember, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconMember}" Fill="#3B82F6" Width="14" Height="14" Margin="0,0,8,0" Stretch="Uniform"/>
                                            <TextBlock Text="{Binding SelectedMember.FullName}" FontWeight="Bold" Foreground="#1E40AF" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Command="{Binding ClearSelectedMemberCommand}" HorizontalAlignment="Right" Style="{DynamicResource Button.Ghost}" Width="20" Height="20" Padding="5">
                                            <Path Data="{StaticResource IconClose}" Fill="#1E40AF" Stretch="Uniform"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 1. ACTIVE SELECTION DETAILS -->
                        <Border Background="{DynamicResource Brush.Surface.Card}" CornerRadius="16" Padding="20" Margin="0,0,0,16" BorderBrush="#F3F4F6" BorderThickness="1">
                            <Grid MinHeight="140">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <!-- EMPTY STATE -->
                                <TextBlock Text="Select an item to adjust quantity" 
                                         FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                         Visibility="{Binding IsControlPanelEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         Margin="0,20"/>

                                <!-- PRODUCT SELECTION CONTENT -->
                                <StackPanel Visibility="{Binding IsProductSelectionActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Active Selection" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                                        <Button Command="{Binding ClearSelectionCommand}" 
                                                Style="{DynamicResource Button.Ghost}"
                                                HorizontalAlignment="Right" Width="24" Height="24" Padding="6">
                                            <Path Data="{StaticResource IconClose}" Fill="#EF4444" Stretch="Uniform"/>
                                        </Button>
                                    </Grid>
                                    
                                    <TextBlock Text="{Binding SelectedProduct.Name}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" TextWrapping="Wrap"/>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding SelectedProductPricing.OriginalPrice.Amount, StringFormat='{}{0:N2} DA'}" 
                                                   FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}" TextDecorations="Strikethrough"
                                                   Visibility="{Binding SelectedProductPricing.IsDiscountApplied, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                                                   Margin="0,0,8,0" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="{Binding SelectedProductPricing.EffectivePrice.Amount, StringFormat='{}{0:N2} DA'}" 
                                                   FontSize="18" Foreground="{DynamicResource FacilityAccentBrush}" FontWeight="ExtraBold" VerticalAlignment="Bottom"/>
                                        
                                        <Border Background="#D1FAE5" CornerRadius="10" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Bottom"
                                                Visibility="{Binding SelectedProductPricing.IsDiscountApplied, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding SelectedProductPricing.AppliedPromotionName, FallbackValue=PROMO}" FontSize="9" FontWeight="Bold" Foreground="#047857"/>
                                        </Border>
                                    </StackPanel>
                                    
                                    <Grid Margin="0,16,0,0" HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Command="{Binding DecrementSelectedProductCommand}" Style="{StaticResource StepperButtonStyle}">
                                            <Path Data="M19,13H5V11H19V13Z" Fill="#4B5563" Stretch="Uniform" Margin="10"/>
                                        </Button>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedProductQuantity}" TextAlignment="Center" VerticalAlignment="Center" FontSize="22" FontWeight="ExtraBold" Foreground="{DynamicResource FacilityAccentBrush}"/>
                                        <Button Grid.Column="2" Command="{Binding IncrementSelectedProductCommand}" Style="{StaticResource StepperButtonStyle}">
                                            <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Fill="#4B5563" Stretch="Uniform" Margin="10"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <!-- WALK-IN SELECTION CONTENT -->
                                <StackPanel Visibility="{Binding IsWalkInSelectionActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Active Selection" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                                        <Button Command="{Binding ClearSelectionCommand}" 
                                                Style="{DynamicResource Button.Ghost}"
                                                HorizontalAlignment="Right" Width="24" Height="24" Padding="6">
                                            <Path Data="{StaticResource IconClose}" Fill="#EF4444" Stretch="Uniform"/>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="{Binding SelectedWalkInPlan.Name}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" TextWrapping="Wrap"/>
                                    <Grid Margin="0,16,0,0" HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Command="{Binding DecrementWalkInCommand}" Style="{StaticResource StepperButtonStyle}">
                                            <Path Data="M19,13H5V11H19V13Z" Fill="#4B5563" Stretch="Uniform" Margin="10"/>
                                        </Button>
                                        <TextBlock Grid.Column="1" Text="{Binding WalkInCount}" TextAlignment="Center" VerticalAlignment="Center" FontSize="22" FontWeight="ExtraBold" Foreground="{DynamicResource FacilityAccentBrush}"/>
                                        <Button Grid.Column="2" Command="{Binding IncrementWalkInCommand}" Style="{StaticResource StepperButtonStyle}">
                                            <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Fill="#4B5563" Stretch="Uniform" Margin="10"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 2. MINI CART -->
                        <Border Background="{DynamicResource Brush.Surface.Glass}" CornerRadius="16" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Mini Cart" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,0,12"/>
                                <ListBox ItemsSource="{Binding CartItems}" 
                                         Style="{StaticResource PremiumListBox}"
                                         MaxHeight="300">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" MaxWidth="110" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Price, StringFormat='{}{0:N2} DA'}" FontSize="11" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                                                        <!-- Promo Dot -->
                                                        <Ellipse Width="6" Height="6" Fill="#10B981" Margin="6,0,0,0" VerticalAlignment="Center" 
                                                                 Visibility="{Binding IsDiscounted, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Ellipse.ToolTip>
                                                                <ToolTip Content="Promotional Discount Applied"/>
                                                            </Ellipse.ToolTip>
                                                        </Ellipse>
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0}'}" FontSize="13" FontWeight="Bold" Margin="12,0" VerticalAlignment="Center"/>
                                                <Button Grid.Column="2" 
                                                        Command="{Binding DataContext.RemoveProductFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{DynamicResource Button.Ghost}" Width="24" Height="24" Padding="6">
                                                    <Path Data="{StaticResource IconClose}" Fill="#EF4444" Stretch="Uniform"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Guests Entry Item -->
                                <Grid Margin="0,4,0,0" Visibility="{Binding WalkInCount, Converter={StaticResource GreaterThanZeroConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedWalkInPlan.Name}" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="Guest Entry" FontSize="11" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding WalkInCount, StringFormat='x{0}'}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 3. SUMMARY -->
                        <Border Background="{DynamicResource Brush.Surface.Card}" CornerRadius="16" Padding="20" BorderBrush="#F3F4F6" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Products Total" FontSize="11" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                                    <TextBlock Text="{Binding ProductsTotal, StringFormat='{}{0:N2} DA'}" FontSize="12" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Services Total" FontSize="11" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                                    <TextBlock Text="{Binding WalkInTotal, StringFormat='{}{0:N2} DA'}" FontSize="12" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>
                                <Separator Background="#F3F4F6" Margin="0,0,0,12"/>
                                <StackPanel>
                                    <TextBlock Text="Grand Total" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding GrandTotal, StringFormat='{}{0:N2} DA'}" FontSize="20" FontWeight="ExtraBold" Foreground="{DynamicResource FacilityAccentBrush}" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </premium:ModalShellControl>
</UserControl>

