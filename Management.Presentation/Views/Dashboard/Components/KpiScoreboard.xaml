<UserControl x:Class="Management.Presentation.Views.Dashboard.Components.KpiScoreboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:Management.Presentation.Converters"
             mc:Ignorable="d" 
             d:DesignWidth="1200">
    <UserControl.Resources>
        <conv:KpiTrendToBrushConverter x:Key="KpiTrendToBrushConverter"/>

        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Surface.Border}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="MinHeight" Value="125"/>
            <Setter Property="MinWidth" Value="140"/>
        </Style>

        <Style x:Key="KpiValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Foreground" Value="{DynamicResource FacilityAccentBrush}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform x:Name="ValueScale" ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.2" Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <ElasticEase Oscillations="2" Springiness="3"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.2" Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <ElasticEase Oscillations="2" Springiness="3"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KpiLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="PeriodBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="PeriodTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}"/>
        </Style>

        <Style x:Key="ComparisonTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Margin="4">
            
            <!-- ====== GYM KPIS ====== -->
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsGymMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <!-- Churn Rate -->
                <Border Style="{StaticResource KpiCardStyle}">
                    <Grid>
                        <Ellipse Width="8" Height="8" Fill="#EF4444" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Border Style="{StaticResource PeriodBadgeStyle}">
                            <TextBlock Text="{Binding Summary.ChurnRate.PeriodLabel}" Style="{StaticResource PeriodTextStyle}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Bottom" Margin="0,15,0,0">
                            <TextBlock Text="{Binding Summary.ChurnRate.Value, StringFormat={}{0:N1}%}" Style="{StaticResource KpiValueStyle}"/>
                            <TextBlock Text="{DynamicResource Terminology.Dashboard.KPI.ChurnRate}" Style="{StaticResource KpiLabelStyle}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Summary.ChurnRate.PercentChange, StringFormat={}{0:+#.0}%}" 
                                         Foreground="{Binding Summary.ChurnRate, Converter={StaticResource KpiTrendToBrushConverter}}"
                                         FontWeight="Bold" FontSize="11" Margin="0,8,4,0"/>
                                <TextBlock Text="{Binding Summary.ChurnRate.ComparisonLabel}" Style="{StaticResource ComparisonTextStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Trial Conversion -->
                <Border Style="{StaticResource KpiCardStyle}">
                    <Grid>
                        <Ellipse Width="8" Height="8" Fill="#8B5CF6" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Border Style="{StaticResource PeriodBadgeStyle}">
                            <TextBlock Text="{Binding Summary.TrialConversionRate.PeriodLabel}" Style="{StaticResource PeriodTextStyle}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Bottom" Margin="0,15,0,0">
                            <TextBlock Text="{Binding Summary.TrialConversionRate.Value, StringFormat={}{0:N1}%}" Style="{StaticResource KpiValueStyle}"/>
                            <TextBlock Text="{DynamicResource Terminology.Dashboard.KPI.TrialConversion}" Style="{StaticResource KpiLabelStyle}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Summary.TrialConversionRate.PercentChange, StringFormat={}{0:+#.0}%}" 
                                         Foreground="{Binding Summary.TrialConversionRate, Converter={StaticResource KpiTrendToBrushConverter}}"
                                         FontWeight="Bold" FontSize="11" Margin="0,8,4,0"/>
                                <TextBlock Text="{Binding Summary.TrialConversionRate.ComparisonLabel}" Style="{StaticResource ComparisonTextStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Peak Capacity -->
                <Border Style="{StaticResource KpiCardStyle}">
                    <Grid>
                        <Ellipse Width="8" Height="8" Fill="#F59E0B" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Border Style="{StaticResource PeriodBadgeStyle}">
                            <TextBlock Text="{Binding Summary.PeakCapacityPercent.PeriodLabel}" Style="{StaticResource PeriodTextStyle}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Bottom" Margin="0,15,0,0">
                            <TextBlock Text="{Binding Summary.PeakCapacityPercent.Value, StringFormat={}{0:N0}%}" Style="{StaticResource KpiValueStyle}"/>
                            <TextBlock Text="{DynamicResource Terminology.Dashboard.KPI.PeakCapacity}" Style="{StaticResource KpiLabelStyle}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Summary.PeakCapacityPercent.PercentChange, StringFormat={}{0:+#}%}" 
                                         Foreground="{Binding Summary.PeakCapacityPercent, Converter={StaticResource KpiTrendToBrushConverter}}"
                                         FontWeight="Bold" FontSize="11" Margin="0,8,4,0"/>
                                <TextBlock Text="{Binding Summary.PeakCapacityPercent.ComparisonLabel}" Style="{StaticResource ComparisonTextStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- PT Upsell -->
                <Border Style="{StaticResource KpiCardStyle}">
                    <Grid>
                        <Ellipse Width="8" Height="8" Fill="#10B981" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Border Style="{StaticResource PeriodBadgeStyle}">
                            <TextBlock Text="{Binding Summary.PtUpsellRate.PeriodLabel}" Style="{StaticResource PeriodTextStyle}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Bottom" Margin="0,15,0,0">
                            <TextBlock Text="{Binding Summary.PtUpsellRate.Value, StringFormat={}{0:N1}%}" Style="{StaticResource KpiValueStyle}"/>
                            <TextBlock Text="{DynamicResource Terminology.Dashboard.KPI.PtUpsell}" Style="{StaticResource KpiLabelStyle}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Summary.PtUpsellRate.ComparisonLabel}" Style="{StaticResource ComparisonTextStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ====== SALON KPIS ====== -->
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsSalonMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <!-- Rebooking Rate -->
                <Border Style="{StaticResource KpiCardStyle}">
                    <Grid>
                        <Ellipse Width="8" Height="8" Fill="#EC4899" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Border Style="{StaticResource PeriodBadgeStyle}">
                            <TextBlock Text="{Binding Summary.SalonRebookingRate.PeriodLabel}" Style="{StaticResource PeriodTextStyle}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Bottom" Margin="0,15,0,0">
                            <TextBlock Text="{Binding Summary.SalonRebookingRate.Value, StringFormat={}{0:N1}%}" Style="{StaticResource KpiValueStyle}"/>
                            <TextBlock Text="{DynamicResource Terminology.Salon.BI.RebookingRate}" Style="{StaticResource KpiLabelStyle}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Summary.SalonRebookingRate.PercentChange, StringFormat={}{0:+#.0}%}" 
                                         Foreground="{Binding Summary.SalonRebookingRate, Converter={StaticResource KpiTrendToBrushConverter}}"
                                         FontWeight="Bold" FontSize="11" Margin="0,8,4,0"/>
                                <TextBlock Text="{Binding Summary.SalonRebookingRate.ComparisonLabel}" Style="{StaticResource ComparisonTextStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Retail Attach -->
                <Border Style="{StaticResource KpiCardStyle}">
                    <Grid>
                        <Ellipse Width="8" Height="8" Fill="#3B82F6" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Border Style="{StaticResource PeriodBadgeStyle}">
                            <TextBlock Text="{Binding Summary.SalonRetailAttachRate.PeriodLabel}" Style="{StaticResource PeriodTextStyle}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Bottom" Margin="0,15,0,0">
                            <TextBlock Text="{Binding Summary.SalonRetailAttachRate.Value, StringFormat={}{0:N1}%}" Style="{StaticResource KpiValueStyle}"/>
                            <TextBlock Text="{DynamicResource Terminology.Salon.BI.RetailAttach}" Style="{StaticResource KpiLabelStyle}"/>
                            <TextBlock Text="{Binding Summary.SalonRetailAttachRate.ComparisonLabel}" Style="{StaticResource ComparisonTextStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Chair Utilization -->
                <Border Style="{StaticResource KpiCardStyle}">
                    <Grid>
                        <Ellipse Width="8" Height="8" Fill="#F59E0B" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Border Style="{StaticResource PeriodBadgeStyle}">
                            <TextBlock Text="{Binding Summary.SalonChairUtilization.PeriodLabel}" Style="{StaticResource PeriodTextStyle}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Bottom" Margin="0,15,0,0">
                            <TextBlock Text="{Binding Summary.SalonChairUtilization.Value, StringFormat={}{0:N0}%}" Style="{StaticResource KpiValueStyle}"/>
                            <TextBlock Text="{DynamicResource Terminology.Salon.BI.ChairUtilization}" Style="{StaticResource KpiLabelStyle}"/>
                            <TextBlock Text="{Binding Summary.SalonChairUtilization.ComparisonLabel}" Style="{StaticResource ComparisonTextStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Avg Ticket -->
                <Border Style="{StaticResource KpiCardStyle}">
                    <Grid>
                        <Ellipse Width="8" Height="8" Fill="#10B981" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Border Style="{StaticResource PeriodBadgeStyle}">
                            <TextBlock Text="{Binding Summary.SalonAvgTicketValue.PeriodLabel}" Style="{StaticResource PeriodTextStyle}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Bottom" Margin="0,15,0,0">
                            <TextBlock Text="{Binding Summary.SalonAvgTicketValue.Value, StringFormat={}{0:N0} DA}" Style="{StaticResource KpiValueStyle}"/>
                            <TextBlock Text="{DynamicResource Terminology.Salon.BI.AvgTicket}" Style="{StaticResource KpiLabelStyle}"/>
                            <TextBlock Text="{Binding Summary.SalonAvgTicketValue.ComparisonLabel}" Style="{StaticResource ComparisonTextStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Common KPIs (Growth/Base) -->
            <Border Style="{StaticResource KpiCardStyle}">
                <Grid>
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource FacilityAccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <StackPanel VerticalAlignment="Bottom" Margin="0,15,0,0">
                        <TextBlock Text="{Binding Summary.ActiveMembers}" Style="{StaticResource KpiValueStyle}"/>
                        <TextBlock Text="{DynamicResource Terminology.Dashboard.KPI.ActiveBase}" Style="{StaticResource KpiLabelStyle}"/>
                        <TextBlock Text="{DynamicResource Terminology.Dashboard.KPI.TotalActive}" Style="{StaticResource ComparisonTextStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
