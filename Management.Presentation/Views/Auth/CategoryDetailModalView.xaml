<UserControl x:Class="Management.Presentation.Views.Auth.CategoryDetailModalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:auth="clr-namespace:Management.Presentation.ViewModels.Auth"
             mc:Ignorable="d" 
             d:DesignHeight="520" d:DesignWidth="780"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resources/Converters.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Modern Round Close Button -->
        <Style x:Key="ModalCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="16">
                            <Path x:Name="icon" 
                                  Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" 
                                  Fill="#64748B" Width="12" Height="12" Stretch="Uniform" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="icon" Property="Fill" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="icon" Property="Fill" Value="#C4785A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Carousel Arrow Button -->
        <Style x:Key="CarouselArrowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#CCFFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="#000000"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="White"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Main Card Container -->
    <Border Width="780" Height="510"
            Background="White"
            CornerRadius="24"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="45" ShadowDepth="12" Opacity="0.16" Direction="270" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <!-- Top Right Close "X" Button -->
            <Button Style="{StaticResource ModalCloseButtonStyle}"
                    Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,16,18,0"
                    Panel.ZIndex="10"
                    ToolTip="Close (Esc)"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Details & Features -->
                    <ColumnDefinition Width="*"/>
                    <!-- Right: Swipable Images / Visual Showcase -->
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- ══════════════════════════════════════════════════════
                     LEFT COLUMN — Archetype Information & Supported Features
                     ══════════════════════════════════════════════════════ -->
                <Grid Grid.Column="0" Margin="28,24,20,24">
                    <Grid.RowDefinitions>
                        <!-- Header / Title -->
                        <RowDefinition Height="Auto"/>
                        <!-- Scrollable Feature Breakdown -->
                        <RowDefinition Height="*"/>
                        <!-- Floating / Sticky Confirm Button -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <!-- Archetype Chip -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border CornerRadius="8" Padding="8,3" Background="#F1F5F9">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{Binding Facility.IconKey}" Fill="#475569" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="OPERATING ENGINE" FontSize="10" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Title -->
                        <TextBlock Text="{Binding Facility.Name}" FontSize="22" FontWeight="Black" Foreground="#0F172A" TextWrapping="Wrap" LineHeight="26" Margin="0,0,0,4"/>

                        <!-- Target Industries -->
                        <TextBlock Text="{Binding TargetIndustries}" FontSize="12" FontWeight="Medium" Foreground="#64748B" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- SCROLLABLE FEATURES CONTENT -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
                        <StackPanel Margin="0,0,8,0">
                            <!-- Detailed Archetype Description -->
                            <TextBlock Text="{Binding LongDescription}" FontSize="12.5" Foreground="#334155" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,14"/>

                            <!-- Divider / Section Title -->
                            <Border Height="1" Background="#F1F5F9" Margin="0,0,0,12"/>
                            <TextBlock Text="KEY SCREENS &amp; WORKFLOWS" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8"/>

                            <!-- Features List -->
                            <ItemsControl ItemsSource="{Binding Features}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Bullet Indicator Icon -->
                                            <Border Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="#F1F5F9" Margin="0,2,8,0" VerticalAlignment="Top">
                                                <Path Data="M9,16.17L4.83,12l-1.42,1.41L9,19 21,7l-1.41-1.41L9,16.17z" 
                                                      Fill="#0F172A" Width="9" Height="9" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Feature Text -->
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"/>
                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,1,0,0" LineHeight="15"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- CONFIRM SELECTION BUTTON -->
                    <Button Grid.Row="2"
                            Command="{Binding ConfirmCommand}"
                            Height="46"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder" Background="#0F172A" CornerRadius="14">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="M9,16.17L4.83,12l-1.42,1.41L9,19 21,7l-1.41-1.41L9,16.17z" 
                                                  Fill="White" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Select This Operating Engine" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="#1E293B"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="#334155"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- ══════════════════════════════════════════════════════
                     RIGHT COLUMN — Swipable Images Showcase (Empty for now)
                     ══════════════════════════════════════════════════════ -->
                <Grid Grid.Column="1" Margin="8,24,24,24">
                    <Border Background="#F8FAFC"
                            CornerRadius="20"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            ClipToBounds="True">
                        <Grid>
                            <!-- Empty Preview Carousel Viewport (Ready for future artwork) -->
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="16">
                                <!-- Clean placeholder frame with subtle border -->
                                <Border Background="White"
                                        CornerRadius="14"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1.5">
                                    <Grid>
                                        <!-- Ambient subtle pattern / illustration placeholder -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Border Width="56" Height="56" CornerRadius="28" Background="#F1F5F9" HorizontalAlignment="Center" Margin="0,0,0,12">
                                                <Path Data="M19,19H5V5H19M19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M13.96,12.29L11.21,15.83L9.25,13.47L6.5,17H17.5L13.96,12.29Z" 
                                                      Fill="#94A3B8" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Workflow Interface Preview" FontSize="13" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                                <TextBlock Text="Screen Slide " FontSize="11" Foreground="#94A3B8"/>
                                                <TextBlock Text="{Binding CurrentSlideNumber, FallbackValue='1'}" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                                <TextBlock Text=" of 4" FontSize="11" Foreground="#94A3B8"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- PREVIOUS SLIDE BUTTON -->
                            <Button Style="{StaticResource CarouselArrowButtonStyle}"
                                    Command="{Binding PrevSlideCommand}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0"
                                    ToolTip="Previous Slide">
                                <Path Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" 
                                      Fill="#475569" Width="11" Height="11" Stretch="Uniform"/>
                            </Button>

                            <!-- NEXT SLIDE BUTTON -->
                            <Button Style="{StaticResource CarouselArrowButtonStyle}"
                                    Command="{Binding NextSlideCommand}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0"
                                    ToolTip="Next Slide">
                                <Path Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" 
                                      Fill="#475569" Width="11" Height="11" Stretch="Uniform"/>
                            </Button>

                            <!-- DYNAMIC PAGINATION DOTS -->
                            <ItemsControl ItemsSource="{Binding Slides}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Bottom"
                                          Margin="0,0,0,24">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectSlideCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0" Padding="0" Margin="4,0" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="dot" Width="6" Height="6" CornerRadius="3" Background="#CBD5E1"/>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                                    <Binding Path="."/>
                                                                    <Binding Path="DataContext.CurrentSlideIndex" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter TargetName="dot" Property="Width" Value="18"/>
                                                            <Setter TargetName="dot" Property="Background" Value="#0F172A"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
