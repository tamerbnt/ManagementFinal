<UserControl x:Class="Management.Presentation.Views.Shell.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Management.Presentation.Views.Shell"
             xmlns:converters="clr-namespace:Management.Presentation.Converters"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:premium="clr-namespace:Management.Presentation.Controls.Premium"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="260">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:ResourceKeyToIconConverter x:Key="ResourceKeyToIconConverter"/>
        
        <!-- Sidebar Navigation Button Style (COINEST Floating) -->
        <Style x:Key="SidebarNavigationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MainBorder" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="{DynamicResource Corner.LG}"> <!-- Tokenized Rounds -->
                            <ContentPresenter x:Name="Presenter" 
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <ContentPresenter.RenderTransform>
                                    <TranslateTransform X="0" Y="0"/>
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Presenter" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="4" Duration="{StaticResource DurationStandard}">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Presenter" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="{StaticResource DurationStandard}">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseIn"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Border x:Name="SidebarBorder" 
            Background="{DynamicResource FacilitySidebarBrush}"
            CornerRadius="40"
            BorderThickness="1,1,0,0"
            BorderBrush="{DynamicResource Brush.Surface.Glass.Standard}"> <!-- Tokenized Highlight -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/> <!-- Breathing Room -->
                <RowDefinition Height="Auto"/> <!-- Logo Area -->
                <RowDefinition Height="*"/> <!-- Navigation Track -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
                <RowDefinition Height="24"/> <!-- Bottom Space -->
            </Grid.RowDefinitions>

            <!-- LOGO AREA (Interactive Engine Brand) -->
            <Button Grid.Row="1" Command="{Binding ToggleSidebarCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SidebarNavigationButtonStyle}">
                        <Setter Property="Margin" Value="16,0"/>
                        <Setter Property="Padding" Value="0,20"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Padding" Value="0,12"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="LogoRoot" Background="Transparent" MinHeight="80">
                            <!-- 1. COLLAPSED BACKGROUND -->
                            <Border x:Name="CollapsedLogoBg" 
                                    Width="44" Height="44" CornerRadius="22"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.Sidebar.Hover}"
                                    Opacity="0"/>

                            <!-- 2. SHARED LOGO INSTANCE -->
                            <Grid x:Name="LogoTransformContainer" HorizontalAlignment="Center" VerticalAlignment="Center" CacheMode="BitmapCache">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="LogoTranslate" Y="-16"/> 
                                </Grid.RenderTransform>
                                <Grid.Effect>
                                    <DynamicResource ResourceKey="ShadowGlow"/>
                                </Grid.Effect>

                                <premium:AtriumMarkAnimation x:Name="SidebarLogo"
                                                             Width="32" Height="32"
                                                             MarkForeground="White"
                                                             AnimationMode="Static"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 3. EXPANDED TEXT -->
                            <TextBlock x:Name="AtriumLabel"
                                       Text="atrium" 
                                       FontWeight="ExtraBold" 
                                       Foreground="{DynamicResource Brush.Neutral.White}" 
                                       FontSize="20"
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Bottom"
                                       Margin="0,8,0,0"
                                       Opacity="1"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CollapsedLogoBg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.20"/>
                                            <DoubleAnimation Storyboard.TargetName="SidebarLogo" Storyboard.TargetProperty="Width" To="28" Duration="0:0:0.20">
                                                <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="SidebarLogo" Storyboard.TargetProperty="Height" To="28" Duration="0:0:0.20">
                                                <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="LogoTranslate" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.20">
                                                <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="AtriumLabel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.10"/>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="AtriumLabel" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0.10" Value="{x:Static Visibility.Collapsed}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SidebarLogo" Storyboard.TargetProperty="AnimationMode">
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static premium:AtriumAnimationMode.Spin}"/>
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0.3" Value="{x:Static premium:AtriumAnimationMode.Static}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CollapsedLogoBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.20"/>
                                            <DoubleAnimation Storyboard.TargetName="SidebarLogo" Storyboard.TargetProperty="Width" To="32" Duration="0:0:0.20">
                                                <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="SidebarLogo" Storyboard.TargetProperty="Height" To="32" Duration="0:0:0.20">
                                                <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="LogoTranslate" Storyboard.TargetProperty="Y" To="-16" Duration="0:0:0.20">
                                                <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="AtriumLabel" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetName="AtriumLabel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.20"/>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SidebarLogo" Storyboard.TargetProperty="AnimationMode">
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static premium:AtriumAnimationMode.Spin}"/>
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0.3" Value="{x:Static premium:AtriumAnimationMode.Static}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- FLOATING TOGGLE (Integrated "Ear" Design) -->
            <Button Grid.Row="1" 
                    Command="{Binding ToggleSidebarCommand}"
                    Width="24" Height="24" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Center" 
                    Margin="0,0,-12,0"
                    Panel.ZIndex="10"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <!-- Outer Shell (Matches Sidebar Color for Seamless Integration) -->
                            <Border x:Name="OuterShell" 
                                    Background="{DynamicResource FacilitySidebarBrush}" 
                                    CornerRadius="12">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" Opacity="0.1" ShadowDepth="1" Color="Black"/>
                                </Border.Effect>
                                
                                <!-- Inner Accent Circle (The "Fill") -->
                                <Border x:Name="AccentFill" 
                                        Background="{DynamicResource FacilityAccentBrush}" 
                                        Margin="2"
                                        CornerRadius="10">
                                    <Path Data="{DynamicResource IconChevronLeft}"
                                          Fill="{DynamicResource Brush.Neutral.White}"
                                          Width="8" Height="8" 
                                          Stretch="Uniform" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="IconRotate" Angle="0"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AccentFill" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="IconRotate" Storyboard.TargetProperty="Angle" To="180" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="IconRotate" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- NAVIGATION (COINEST Floating Pillars) -->
            <ScrollViewer Grid.Row="2" 
                          VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <Grid Margin="0,12,0,12">
                    <!-- SELECTION RAIL (Fluid Motion Layer) -->
                    <Grid x:Name="SelectionRail" IsHitTestVisible="False" Margin="0,0">
                        <!-- GLOWING BLUE PILL INDICATOR -->
                        <Border x:Name="FluidIndicator">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="IndicatorTransform" Y="0"/>
                            </Border.RenderTransform>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Width" Value="248"/>
                                    <Setter Property="Height" Value="64"/>
                                    <Setter Property="Margin" Value="6,0"/>
                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                    <Setter Property="CornerRadius" Value="{DynamicResource Corner.LG}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="52" Duration="0:0:0.20">
                                                            <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <ThicknessAnimation Storyboard.TargetProperty="Margin" To="0" Duration="0:0:0.20">
                                                            <ThicknessAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
                                                        </ThicknessAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="248" Duration="0:0:0.20">
                                                            <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <ThicknessAnimation Storyboard.TargetProperty="Margin" To="6,0" Duration="0:0:0.20">
                                                            <ThicknessAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
                                                        </ThicknessAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                            <Setter Property="CornerRadius" Value="{DynamicResource Corner.XL}"/>
                                            <Setter Property="Width" Value="52"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="SelectionStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition From="*" To="*" GeneratedDuration="0:0:0.4">
                                            <VisualTransition.GeneratedEasingFunction>
                                                <CubicEase EasingMode="EaseInOut"/>
                                            </VisualTransition.GeneratedEasingFunction>
                                        </VisualTransition>
                                    </VisualStateGroup.Transitions>

                                    <VisualState x:Name="State0">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="IndicatorTransform" Storyboard.TargetProperty="Y" To="0" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="State1">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="IndicatorTransform" Storyboard.TargetProperty="Y" To="64" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="State2">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="IndicatorTransform" Storyboard.TargetProperty="Y" To="128" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="State3">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="IndicatorTransform" Storyboard.TargetProperty="Y" To="192" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="State4">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="IndicatorTransform" Storyboard.TargetProperty="Y" To="256" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="State5">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="IndicatorTransform" Storyboard.TargetProperty="Y" To="320" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="State6">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="IndicatorTransform" Storyboard.TargetProperty="Y" To="384" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="State7">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="IndicatorTransform" Storyboard.TargetProperty="Y" To="448" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <i:Interaction.Triggers>
                                <i:DataTrigger Binding="{Binding ActiveIndex}" Value="0">
                                    <i:GoToStateAction StateName="State0"/>
                                </i:DataTrigger>
                                <i:DataTrigger Binding="{Binding ActiveIndex}" Value="1">
                                    <i:GoToStateAction StateName="State1"/>
                                </i:DataTrigger>
                                <i:DataTrigger Binding="{Binding ActiveIndex}" Value="2">
                                    <i:GoToStateAction StateName="State2"/>
                                </i:DataTrigger>
                                <i:DataTrigger Binding="{Binding ActiveIndex}" Value="3">
                                    <i:GoToStateAction StateName="State3"/>
                                </i:DataTrigger>
                                <i:DataTrigger Binding="{Binding ActiveIndex}" Value="4">
                                    <i:GoToStateAction StateName="State4"/>
                                </i:DataTrigger>
                                <i:DataTrigger Binding="{Binding ActiveIndex}" Value="5">
                                    <i:GoToStateAction StateName="State5"/>
                                </i:DataTrigger>
                                <i:DataTrigger Binding="{Binding ActiveIndex}" Value="6">
                                    <i:GoToStateAction StateName="State6"/>
                                </i:DataTrigger>
                                <i:DataTrigger Binding="{Binding ActiveIndex}" Value="7">
                                    <i:GoToStateAction StateName="State7"/>
                                </i:DataTrigger>
                            </i:Interaction.Triggers>
                            
                            <!-- CoachPro Style: Solid Identity Pill -->
                            <Border.Background>
                                <DynamicResource ResourceKey="FacilityAccentGradient"/>
                            </Border.Background>
                            
                            <Border.BorderThickness>0</Border.BorderThickness>

                            <Border.Effect>
                                <DynamicResource ResourceKey="ShadowGlow"/>
                            </Border.Effect>
                            
                            <!-- No internal dot for CoachPro style, just solid gradient -->
                        </Border>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding MenuItems}" HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Floating Container -->
                                <Border x:Name="NavItemBorder" Background="Transparent" CornerRadius="{DynamicResource Corner.LG}" Height="64">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Margin" Value="6,0"/>
                                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                    <Setter Property="Margin" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavigationButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                        <Setter Property="ToolTip" Value="{Binding DisplayName}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                                            <Setter Property="Width" Value="52"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <Path x:Name="IconPath" Grid.Column="0"
                                                  Data="{Binding IconKey, Converter={StaticResource ResourceKeyToIconConverter}}"
                                                  Fill="{DynamicResource Brush.Sidebar.Text.Inactive}"
                                                  Stroke="{Binding Fill, RelativeSource={RelativeSource Self}}"
                                                  StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="20" Height="20" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                <Setter Property="Grid.ColumnSpan" Value="2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            
                                            <TextBlock x:Name="LabelText" Grid.Column="1" 
                                                       Text="{Binding DisplayName}" 
                                                       VerticalAlignment="Center" Margin="4,0,16,0"
                                                       Foreground="{DynamicResource Brush.Sidebar.Text.Inactive}"
                                                       FontSize="14" FontWeight="Medium">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Opacity" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                <Setter Property="Opacity" Value="0"/>
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <!-- REMOVED TextGlow to fix ghosting/blur issues -->
                                            </TextBlock>
                                        </Grid>
                                    </Button>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <!-- Using semi-transparent background for hover -->
                                        <Setter TargetName="NavItemBorder" Property="Background" Value="{DynamicResource Brush.Sidebar.Hover}"/> 
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="IconPath" Property="Fill" Value="{DynamicResource Brush.Sidebar.Text.Active}"/>
                                        <Setter TargetName="LabelText" Property="Foreground" Value="{DynamicResource Brush.Sidebar.Text.Active}"/>
                                        <Setter TargetName="LabelText" Property="FontWeight" Value="SemiBold"/>
                                        <!-- NO TEXT EFFECT -> FIXES GHOSTING -->
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
            
            <!-- SEPARATOR -->
            <Rectangle Grid.Row="2" VerticalAlignment="Bottom" Height="1" Margin="16,0" Opacity="0.2">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="White" Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- FOOTER (Premium Branding) -->
            <Grid Grid.Row="3" Margin="4,0,4,8">
                <StackPanel x:Name="BrandingStack" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Powered by" 
                               FontSize="10" 
                               Foreground="{DynamicResource Brush.Sidebar.Text.Inactive}" 
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontWeight="Medium"
                               Opacity="0.5"
                               FontFamily="Segoe UI Variable Display, Segoe UI">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="FontSize" Value="7"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="from scratch" 
                               FontSize="16" 
                               FontWeight="ExtraBold" 
                               Foreground="{DynamicResource Brush.Neutral.White}" 
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,0"
                               MaxWidth="200"
                               FontFamily="Segoe UI Variable Display, Segoe UI">
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
