<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- SALON — "Warm Linen" Palette (Alternate) -->
    <!-- Warm sandy/cream backgrounds recovered from commit a2b23dd -->

    <SolidColorBrush x:Key="WindowBg"              Color="#F0E7D5"/>
    <SolidColorBrush x:Key="ContentAreaBg"          Color="#F0E7D5"/>
    <SolidColorBrush x:Key="SurfaceBg"              Color="#FAF8F4"/>
    <SolidColorBrush x:Key="SurfaceBgDim"           Color="#F0E7D5"/>
    <SolidColorBrush x:Key="CardBackgroundBrush"    Color="#FAF8F4"/>
    <SolidColorBrush x:Key="CardBorderBrush"        Color="#DDD4BE"/>
    <SolidColorBrush x:Key="SurfaceBgSecondary"     Color="#F9FAFB"/>

    <SolidColorBrush x:Key="Brush.Window.Background"  Color="#F0E7D5"/>
    <SolidColorBrush x:Key="Brush.Surface.Background" Color="#FAF8F4"/>
    <SolidColorBrush x:Key="Brush.Surface.Primary"    Color="#FAF8F4"/>
    <SolidColorBrush x:Key="Brush.Surface.Header"     Color="#F0E7D5"/>
    <SolidColorBrush x:Key="Brush.Surface.Subtle"     Color="#F0E7D5"/>
    <SolidColorBrush x:Key="Brush.Border.Subtle"      Color="#DDD4BE"/>
    
    <!-- Row Contrast Tokens -->
    <SolidColorBrush x:Key="RowOnAccentPrimary"    Color="#1A1208"/>
    <SolidColorBrush x:Key="RowOnAccentSecondary"  Color="#4A1524"/>

    <!-- Accents (Soft Rose Pink) -->
    <Color x:Key="FacilityAccentColor">#F48FB1</Color>
    <Color x:Key="FacilityAccentShadowColor">#C25E80</Color>
    <LinearGradientBrush x:Key="FacilityAccentGradient" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#C25E80" Offset="0"/>
        <GradientStop Color="#F48FB1" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="FacilityAccentBrush" Color="{StaticResource FacilityAccentColor}"/>
    <SolidColorBrush x:Key="FacilityAccentDimBrush" Color="{StaticResource FacilityAccentColor}" Opacity="0.15"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#F48FB1"/>
    <Color x:Key="AccentColor">#F48FB1</Color>
    <Color x:Key="AccentLightColor">#FFF0F5</Color>

    <SolidColorBrush x:Key="Brush.Brand.Primary" Color="#F48FB1"/>
    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#F48FB1"/>

</ResourceDictionary>
