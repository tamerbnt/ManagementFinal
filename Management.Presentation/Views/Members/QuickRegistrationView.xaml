<UserControl x:Class="Management.Presentation.Views.Members.QuickRegistrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Management.Presentation.ViewModels.Members"
             xmlns:premium="clr-namespace:Management.Presentation.Controls.Premium"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:QuickRegistrationViewModel}"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </UserControl.Resources>

    <premium:ModalShellControl Title="{Binding Title}"
                               Width="820"
                               CancelCommand="{Binding CancelCommand}"
                               RegisterCommand="{Binding RegisterCommand}"
                               PrimaryActionText="{DynamicResource Terminology.Global.Register}">
        
        <StackPanel Margin="0,8,0,0">
            <!-- 1. LEAD SEARCH (TOP SECTION) -->
            <Border Background="{DynamicResource Brush.Surface.Glass}" 
                    CornerRadius="16" 
                    Padding="24" 
                    Margin="0,0,0,32"
                    BorderBrush="#F3F4F6"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Convert Existing Lead (Optional)" Style="{StaticResource SectionTitle}"/>
                    <premium:PremiumSearchBox Text="{Binding LeadSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             Placeholder="Search by Name or Phone..."
                                             IconData="{StaticResource IconSearch}"/>
                    
                    <!-- Search Results (Shown only if query active) -->
                    <ListBox ItemsSource="{Binding LeadResults}" 
                             SelectedItem="{Binding SelectedLead}"
                             Visibility="{Binding LeadResults.Count, Converter={StaticResource IntToVisibilityConverter}}"
                             MaxHeight="150" Margin="0,12,0,0"
                             Style="{StaticResource PremiumListBox}"/>
                </StackPanel>
            </Border>

            <!-- 2. MAIN FORM (2 COLUMNS) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/> <!-- Spacer -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Personal Data & Gender (New Layout) -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Personal Details" Style="{StaticResource SectionTitle}"/>
                    
                    <premium:PremiumSearchBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                             Placeholder="{DynamicResource Terminology.Staff.Add.FullName}"
                                             IconData="{StaticResource IconMembers}"
                                             Margin="0,0,0,24"/>

                    <premium:PremiumSearchBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                             Placeholder="{DynamicResource Terminology.Staff.Add.Phone}"
                                             IconData="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                                             Margin="0,0,0,24"/>

                    <premium:PremiumSearchBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                             Placeholder="{DynamicResource Terminology.Staff.Add.Email}"
                                             IconData="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z M22 6l-10 7L2 6"
                                             Margin="0,0,0,24"/>

                    <!-- Gender Segmented Toggle (Integrated from Column 2) -->
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="{DynamicResource Terminology.Member.Gender}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,0,12"/>
                        <premium:SegmentedToggleControl SelectedGender="{Binding Gender, Mode=TwoWay}" Width="250" HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right Column: Identification & Plan -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Identification &amp; Membership" Style="{StaticResource SectionTitle}"/>
                    
                    <premium:PremiumSearchBox Text="{Binding CardId, UpdateSourceTrigger=PropertyChanged}"
                                             Placeholder="Card ID / RFID"
                                             IconData="{StaticResource IconTag}"
                                             Margin="0,0,0,24"/>

                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="Membership Plan" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding Plans}" 
                                  SelectedItem="{Binding SelectedPlan}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource Input.ComboBox}"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Acquisition Source" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,0,8"/>
                        <ComboBox SelectedValue="{Binding Source}" 
                                  SelectedValuePath="Content"
                                  Style="{StaticResource Input.ComboBox}">
                            <ComboBoxItem Content="Walk-in"/>
                            <ComboBoxItem Content="Social Media"/>
                            <ComboBoxItem Content="Referral"/>
                            <ComboBoxItem Content="Advertisement"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </premium:ModalShellControl>
</UserControl>
