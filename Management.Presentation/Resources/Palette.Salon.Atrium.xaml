<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- SALON — "Atrium" Palette (Brand) -->
    <!-- Warm terracotta surfaces only -->
    <!-- Salon accent (Dusty Rose #C4788A) stays owned by Branding.Salon.xaml -->

    <!-- ── Surfaces ────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="WindowBg"              Color="#F7F3EF"/>
    <SolidColorBrush x:Key="ContentAreaBg"          Color="#F7F3EF"/>
    <SolidColorBrush x:Key="SurfaceBg"              Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceBgDim"           Color="#F2EDE9"/>
    <SolidColorBrush x:Key="CardBackgroundBrush"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush"        Color="#E8DDD8"/>
    <SolidColorBrush x:Key="SurfaceBgSecondary"     Color="#F2EDE9"/>

    <SolidColorBrush x:Key="Brush.Window.Background"  Color="#F7F3EF"/>
    <SolidColorBrush x:Key="Brush.Surface.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Surface.Primary"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Surface.Header"     Color="#F7F3EF"/>
    <SolidColorBrush x:Key="Brush.Surface.Subtle"     Color="#F2EDE9"/>
    <SolidColorBrush x:Key="Brush.Border.Subtle"      Color="#E8DDD8"/>

    <!-- ── On-Accent Row Contrast Tokens ──────────────────────── -->
    <!-- Matching existing Salon palette values — contrast safe on Dusty Rose #C4788A -->
    <SolidColorBrush x:Key="RowOnAccentPrimary"    Color="#1A1208"/>
    <SolidColorBrush x:Key="RowOnAccentSecondary"  Color="#4A1524"/>

</ResourceDictionary>
