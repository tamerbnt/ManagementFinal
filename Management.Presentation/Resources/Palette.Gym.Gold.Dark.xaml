<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- GYM — "Classic Gold" Palette (Classic) - DARK OVERRIDE -->
    <!-- Contains only the accent colors to preserve dark mode backgrounds -->

    <!-- Gold accent — #C9A96E -->
    <Color  x:Key="FacilityAccentColor">       #C9A96E</Color>
    <Color  x:Key="FacilityAccentShadowColor"> #C9A96E</Color>
    <SolidColorBrush x:Key="FacilityAccentBrush"    Color="#C9A96E"/>
    <SolidColorBrush x:Key="FacilityAccentDimBrush" Color="#C9A96E" Opacity="0.15"/>
    <SolidColorBrush x:Key="AccentBrush"            Color="#C9A96E"/>
    <Color  x:Key="AccentColor">               #C9A96E</Color>
    <Color  x:Key="AccentLightColor">          #FDE68A</Color>
    <SolidColorBrush x:Key="Brush.Brand.Primary"      Color="#C9A96E"/>
    <SolidColorBrush x:Key="BrandPrimaryBrush"         Color="#C9A96E"/>

    <LinearGradientBrush x:Key="FacilityAccentGradient" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#C9A96E" Offset="0"/>
        <GradientStop Color="#E0C28A" Offset="1"/>
    </LinearGradientBrush>

    <!-- On-Accent Row Tokens: text/icons on top of the gold active row background -->
    <!-- Primary: deep warm-brown #3B1F00 on #C9A96E gold = ~5.8:1 contrast ✅ WCAG AA -->
    <!-- Secondary: slightly lighter brown for muted text = ~4.6:1 ✅ WCAG AA -->
    <SolidColorBrush x:Key="RowOnAccentPrimary"   Color="#3B1F00"/>
    <SolidColorBrush x:Key="RowOnAccentSecondary"  Color="#5C3410"/>

</ResourceDictionary>
