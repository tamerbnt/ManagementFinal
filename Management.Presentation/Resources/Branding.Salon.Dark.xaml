<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Identity Layer: SALON FACILITY (DARK MODE OVERRIDE) -->
    
    <!-- Sidebar - Burgundy (Consistent with Light Theme) -->
    <Color x:Key="FacilitySidebarBrush.Color">#66001F</Color>
    <SolidColorBrush x:Key="FacilitySidebarBrush" Color="{StaticResource FacilitySidebarBrush.Color}"/>
    
    <!-- Accents - Dusty Rose Glow -->
    <Color x:Key="FacilityAccentColor">#C4788A</Color>
    <Color x:Key="FacilityAccentShadowColor">#B3697A</Color>
    
    <LinearGradientBrush x:Key="FacilityAccentGradient" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#C4788A" Offset="0"/>
        <GradientStop Color="#D1899B" Offset="1"/>
    </LinearGradientBrush>
    
    <SolidColorBrush x:Key="FacilityAccentBrush" Color="{StaticResource FacilityAccentColor}"/>
    <SolidColorBrush x:Key="FacilityAccentDimBrush" Color="{StaticResource FacilityAccentColor}" Opacity="0.25"/>
    
    <!-- Background Overrides (Deep Espresso) -->
    <SolidColorBrush x:Key="WindowBg" Color="#1A1208" />
    <SolidColorBrush x:Key="ContentAreaBg" Color="#1A1208" />
    <SolidColorBrush x:Key="Brush.Window.Background" Color="#1A1208"/>
    <SolidColorBrush x:Key="Brush.Content.Background" Color="#1A1208"/>
    <SolidColorBrush x:Key="Brush.Surface.Background" Color="#1A1208"/>
    
    <!-- Card Overrides (Dark Warm Brown) -->
    <SolidColorBrush x:Key="SurfaceBg" Color="#261A10" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#261A10" />
    <SolidColorBrush x:Key="Brush.Surface.Primary" Color="#261A10"/>
    <SolidColorBrush x:Key="Brush.Surface.Card" Color="#261A10"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#35281E"/>
    <SolidColorBrush x:Key="Brush.Surface.Glass" Color="#261A10" Opacity="0.8"/>

    <!-- Contrast Tokens -->
    <SolidColorBrush x:Key="OnAccentPrimary" Color="#1A1208"/> <!-- Deep espresso text on Dusty Rose -->
    <SolidColorBrush x:Key="OnAccentSecondary" Color="#261A10"/>
    <SolidColorBrush x:Key="RowOnAccentPrimary" Color="#1A1208"/>
    <SolidColorBrush x:Key="RowOnAccentSecondary" Color="#261A10"/>
    
    <!-- Status Backgrounds (Deep/Rich Colors for Dark Mode) -->
    <SolidColorBrush x:Key="StatusErrorBackground" Color="#450A0A" Opacity="0.4"/> <!-- Deep Red -->
    <SolidColorBrush x:Key="StatusSuccessBackground" Color="#064E3B" Opacity="0.4"/> <!-- Deep Green -->
    
    <!-- Aliases -->
    <SolidColorBrush x:Key="AccentBrush" Color="#C4788A"/>
    <Color x:Key="AccentColor">#C4788A</Color>
    <SolidColorBrush x:Key="IllustrationBackgroundBrush" Color="#1A1208"/>
    <SolidColorBrush x:Key="Brush.Card.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#1FFFFFFF" Opacity="0.06"/>
    
    <sys:String x:Key="TerminologyLabel">Client</sys:String>
</ResourceDictionary>
