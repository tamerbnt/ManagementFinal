<UserControl x:Class="Management.Presentation.Views.FinanceAndStaff.StaffDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:Management.Presentation.Converters"
             xmlns:local="clr-namespace:Management.Presentation.Views.FinanceAndStaff"
             xmlns:vm="clr-namespace:Management.Presentation.ViewModels.Finance"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="400"
             Background="Transparent">

    <UserControl.Resources>
        <converters:NameToBrushConverter x:Key="NameToBrushConverter"/>
        <converters:NameToInitialConverter x:Key="NameToInitialConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:IntToVisibilityConverter x:Key="ZeroIsVisibleConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Stats -->
            <RowDefinition Height="*"/>    <!-- Content/Tabs -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Top Right Close Button -->
        <Button Width="32" Height="32" 
                Style="{StaticResource IconButtonStyle}" 
                Command="{Binding DataContext.CloseDetailCommand, RelativeSource={RelativeSource AncestorType=local:FinanceAndStaffView}}"
                HorizontalAlignment="Right" VerticalAlignment="Top" Grid.Row="0" Margin="0,24,24,0" Panel.ZIndex="10">
            <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextTertiaryBrush}" Width="12" Height="12" Stretch="Uniform"/>
        </Button>

        <!-- 1. Profile Header -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,24,24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                    <Ellipse Width="48" Height="48" Fill="{Binding FullName, Converter={StaticResource NameToBrushConverter}}"/>
                    <TextBlock Text="{Binding FullName, Converter={StaticResource NameToInitialConverter}}" 
                               FontSize="16" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding FullName}" Style="{StaticResource Title2}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=local:FinanceAndStaffView}, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                        <TextBox Text="{Binding FullName, Mode=TwoWay}" Style="{StaticResource Input.Field}" Width="200"
                                 Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=local:FinanceAndStaffView}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        
                        <ContentControl Content="{Binding Role}" 
                                        Style="{StaticResource GlobalRoleBadgeStyle}" 
                                        VerticalAlignment="Center"
                                        Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Stats Bar -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBgDim}" CornerRadius="12" Margin="24,24,24,16" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="{DynamicResource Terminology.Staff.Detail.Joined}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding HireDate, StringFormat='{}{0:yyyy}'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrandPrimaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" Width="1" VerticalAlignment="Stretch" Margin="0,4"/>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="{DynamicResource Terminology.Staff.Detail.Permissions}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Permissions.Count}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrandPrimaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="3" Background="{DynamicResource BorderBrush}" Width="1" VerticalAlignment="Stretch" Margin="0,4"/>

                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                    <TextBlock Text="{DynamicResource Terminology.Staff.Detail.Status}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding EmploymentStatus}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrandPrimaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Tabs -->
        <TabControl Grid.Row="2" Style="{StaticResource PremiumTabControl}" Margin="24,0">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem" BasedOn="{StaticResource GlobalDetailTabStyle}">
                    <Setter Property="Margin" Value="0,0,16,0"/>
                </Style>
            </TabControl.ItemContainerStyle>
            <TabItem Header="{DynamicResource Terminology.Staff.Tab.Overview}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="{DynamicResource Terminology.Members.Detail.ContactInfo}" Style="{StaticResource Title3}" Margin="0,0,0,12"/>
                        
                        <!-- Email -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="{DynamicResource Terminology.Members.Detail.Email}" Style="{StaticResource Caption}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                            <TextBlock Text="{Binding Email}" Style="{StaticResource Body}"
                                       Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=local:FinanceAndStaffView}, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                            <TextBox Text="{Binding Email, Mode=TwoWay}" Style="{StaticResource Input.Field}"
                                     Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=local:FinanceAndStaffView}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                        
                        <!-- Phone -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="{DynamicResource Terminology.Members.Detail.Phone}" Style="{StaticResource Caption}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                            <TextBlock Text="{Binding PhoneNumber}" Style="{StaticResource Body}"
                                       Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=local:FinanceAndStaffView}, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                            <TextBox Text="{Binding Phone, Mode=TwoWay}" Style="{StaticResource Input.Field}"
                                     Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=local:FinanceAndStaffView}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                        
                        <!-- Hire Date -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="{DynamicResource Terminology.Staff.Detail.Joined}" Style="{StaticResource Caption}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                            <TextBlock Text="{Binding HireDate, StringFormat='{}{0:MMM dd, yyyy}'}" Style="{StaticResource Body}"/>
                        </StackPanel>

                        <!-- Salary & Payment Day -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Terminology.Staff.Detail.Salary}" Style="{StaticResource Caption}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                <TextBlock Text="{Binding Salary, StringFormat='{}{0:N2} DA'}" Style="{StaticResource Body}"
                                           Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=local:FinanceAndStaffView}, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                <TextBox Text="{Binding Salary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Field}"
                                         Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=local:FinanceAndStaffView}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Terminology.Staff.Detail.PayDay}" Style="{StaticResource Caption}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                <TextBlock Text="{Binding PaymentDay}" Style="{StaticResource Body}"
                                           Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=local:FinanceAndStaffView}, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                <TextBox Text="{Binding PaymentDay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.Field}"
                                         Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=local:FinanceAndStaffView}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            

        </TabControl>

        
        
        <!-- 4. Sticky Footer -->
        <Border Grid.Row="3" Padding="24,16" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="0,0,32,32" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="-2" Opacity="0.05" Color="Black"/>
            </Border.Effect>
            <Grid>
                <!-- View Mode: Edit / Delete -->
                <Grid Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=local:FinanceAndStaffView}, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" Content="{DynamicResource Terminology.Global.Edit}" 
                            Style="{StaticResource SecondaryButton}" 
                            Height="40"
                            Command="{Binding DataContext.EditStaffCommand, RelativeSource={RelativeSource AncestorType=local:FinanceAndStaffView}}"
                            CommandParameter="{Binding}"/>
                    
                    <Button Grid.Column="2" Content="{DynamicResource Terminology.Global.Delete}" 
                            Style="{StaticResource SecondaryButton}" 
                            Foreground="{DynamicResource StatusErrorBrush}"
                            Height="40"
                            Command="{Binding DataContext.DeleteStaffCommand, RelativeSource={RelativeSource AncestorType=local:FinanceAndStaffView}}"/>
                </Grid>

                <!-- Edit Mode: Save / Cancel -->
                <Grid Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=local:FinanceAndStaffView}, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" Content="{DynamicResource Terminology.Global.Cancel}" 
                            Style="{StaticResource SecondaryButton}" 
                            Height="40"
                            Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType=local:FinanceAndStaffView}}"/>

                    <Button Grid.Column="2" Content="{DynamicResource Terminology.Members.Action.SaveChanges}" 
                            Style="{StaticResource PrimaryButton}" 
                            Height="40"
                            Command="{Binding DataContext.SaveStaffCommand, RelativeSource={RelativeSource AncestorType=local:FinanceAndStaffView}}"/>
                </Grid>
            </Grid>
        </Border>
        


    </Grid>
</UserControl>
