<UserControl x:Class="Management.Presentation.Views.Shell.DashboardView"
             x:Name="DashboardRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:data="clr-namespace:Management.Presentation.Components.Data"
             xmlns:controls="clr-namespace:Management.Presentation.Resources.Controls"
             xmlns:shell="clr-namespace:Management.Presentation.ViewModels.Shell"
             xmlns:converters="clr-namespace:Management.Presentation.Converters"
             xmlns:dashcomps="clr-namespace:Management.Presentation.Components.Dashboard"
             xmlns:dash="clr-namespace:Management.Presentation.Views.Dashboard.Components"
             xmlns:views="clr-namespace:Management.Presentation.Views.Dashboard"
             xmlns:premium="clr-namespace:Management.Presentation.Controls.Premium"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="Transparent">
    <UserControl.Resources>
        <controls:BindingProxy x:Key="Proxy" Data="{Binding}" />
        <converters:TerminologyConverter x:Key="TerminologyConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToVisibilityInverseConverter x:Key="BoolToVisibilityInverseConverter"/>
        <converters:EqualToVisibilityConverter x:Key="EqualToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>

        <!-- Mini Mode Toggle for Detail/Summary switching in Cards -->
        <Style x:Key="Style.MiniModeToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="28" />
            <Setter Property="Width" Value="80" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Background="{DynamicResource Brush.Surface.Header}" CornerRadius="14" BorderBrush="{DynamicResource Brush.Surface.Border}" BorderThickness="1">
                            <Grid>
                                <!-- Icons -->
                                <Grid Margin="8,0">
                                    <Path x:Name="GraphIcon" Data="M19,3H5C3.89,3 3,3.9 3,5V19C3,20.1 3.89,21 5,21H19C20.1,21 21,20.1 21,19V5C21,3.9 20.1,3 19,3M9,17H7V10H9V17M13,17H11V7H13V17M17,17H15V12H17V17Z" 
                                          Fill="#94A3B8" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Left" />
                                    <Path x:Name="ListIcon" Data="M3,4H21V6H3V4M3,9H21V11H3V9M3,14H21V16H3V14M3,19H21V21H3V19Z" 
                                          Fill="#94A3B8" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Right" />
                                </Grid>
                                <!-- Thumb -->
                                <Border x:Name="Thumb" Background="{DynamicResource Brush.Surface.Primary}" Width="36" Height="22" CornerRadius="11" HorizontalAlignment="Left" Margin="2">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.1" Color="#000000"/>
                                    </Border.Effect>
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="ThumbTransform" X="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X" To="38" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Premium Dashboard Mode Toggle Style (Segmented Control) -->
        <Style x:Key="Style.DashboardModeToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="44" />
            <Setter Property="Width" Value="250" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <!-- Outer Track (Flat Gray Pill) -->
                            <Border x:Name="Track" 
                                    Background="#F1F5F9" 
                                    CornerRadius="22" 
                                    BorderThickness="0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                                <Setter Property="Background" Value="#1E293B"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Animated Thumb (The White Moving Pill, behind text) -->
                            <Border x:Name="Thumb" 
                                    Background="White" 
                                    CornerRadius="19" 
                                    Margin="3" 
                                    HorizontalAlignment="Left"
                                    Width="122"
                                    Effect="{DynamicResource Shadow.Level2}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                                <Setter Property="Background" Value="#334155"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform" X="0" />
                                </Border.RenderTransform>
                            </Border>

                            <!-- Permanent Text Labels -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="OpsText"
                                           Grid.Column="0"
                                           Text="Operations View" 
                                           FontWeight="Bold" 
                                           FontSize="12" 
                                           Foreground="#1E293B" 
                                           VerticalAlignment="Center" 
                                           HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock x:Name="BizText"
                                           Grid.Column="1"
                                           Text="Business View" 
                                           FontWeight="SemiBold" 
                                           FontSize="12" 
                                           Foreground="#64748B" 
                                           VerticalAlignment="Center" 
                                           HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                        
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                 <!-- Move Thumb to Right -->
                                 <Trigger.EnterActions>
                                     <BeginStoryboard>
                                         <Storyboard>
                                             <DoubleAnimation Storyboard.TargetName="ThumbTransform" 
                                                              Storyboard.TargetProperty="X" 
                                                              To="122" Duration="0:0:0.35">
                                                 <DoubleAnimation.EasingFunction>
                                                     <QuarticEase EasingMode="EaseInOut" />
                                                 </DoubleAnimation.EasingFunction>
                                             </DoubleAnimation>
                                         </Storyboard>
                                     </BeginStoryboard>
                                 </Trigger.EnterActions>
                                 <Trigger.ExitActions>
                                     <BeginStoryboard>
                                         <Storyboard>
                                             <DoubleAnimation Storyboard.TargetName="ThumbTransform" 
                                                              Storyboard.TargetProperty="X" 
                                                              To="0" Duration="0:0:0.35">
                                                 <DoubleAnimation.EasingFunction>
                                                     <QuarticEase EasingMode="EaseInOut" />
                                                 </DoubleAnimation.EasingFunction>
                                             </DoubleAnimation>
                                         </Storyboard>
                                     </BeginStoryboard>
                                 </Trigger.ExitActions>

                                 <!-- Update Text Styles for Business Mode -->
                                 <Setter TargetName="OpsText" Property="FontWeight" Value="SemiBold" />
                                 <Setter TargetName="OpsText" Property="Foreground" Value="#64748B" />
                                 <Setter TargetName="BizText" Property="FontWeight" Value="Bold" />
                                 <Setter TargetName="BizText" Property="Foreground" Value="#1E293B" />
                            </Trigger>
                            
                            <!-- Maintain Dark Mode overrides when toggled -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
                                    <Condition Binding="{Binding IsDarkMode}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="BizText" Property="Foreground" Value="White" />
                                <Setter TargetName="OpsText" Property="Foreground" Value="#94A3B8" />
                            </MultiDataTrigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                 <Setter TargetName="Thumb" Property="Effect" Value="{DynamicResource Shadow.Level3}" />
                            </Trigger>

                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Opacity" Value="0.6"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BounceValueStyle" TargetType="TextBlock">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.1" Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <ElasticEase Oscillations="2" Springiness="3"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.1" Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <ElasticEase Oscillations="2" Springiness="3"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Row 0: Header -->
            <RowDefinition Height="Auto" /> <!-- Row 1: Bento Stats -->
            <RowDefinition Height="*" />    <!-- Row 2: Content (Chart + Activity) -->
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <Grid Margin="0,0,0,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="{DynamicResource IconDashboard}" 
                      Style="{DynamicResource Style.Icon.Large}" 
                      Stroke="{DynamicResource TextPrimaryBrush}"
                      Margin="0,0,12,0"
                      VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Terminology.Dashboard.Title}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource Terminology.Dashboard.Subtitle}" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusinessMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
            
            <!-- Context Action & Toggle -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                
                <!-- Unified Header Actions -->
                <StackPanel Orientation="Horizontal">
                    
                    <!-- Switch View Button -->
                    <!-- Segmented Control View Switcher -->
                    <Border Background="{DynamicResource Brush.Surface.Header}" CornerRadius="8" Padding="4" Margin="0,0,12,0" BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="{DynamicResource Terminology.Dashboard.Action.OperationsView}" 
                                         IsChecked="{Binding IsBusinessMode, Converter={StaticResource InverseBoolConverter}}" 
                                         Style="{StaticResource SegmentedRadioButtonStyle}"/>
                            <RadioButton Content="{DynamicResource Terminology.Dashboard.Action.BusinessView}" 
                                         IsChecked="{Binding IsBusinessMode}" 
                                         Style="{StaticResource SegmentedRadioButtonStyle}"/>
                        </StackPanel>
                    </Border>


                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ========================== -->
                <!-- DYNAMIC DASHBOARD CONTENT -->
        <ContentControl Grid.Row="1" Grid.RowSpan="2" Focusable="False">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Content">
                        <Setter.Value>
                            <views:OperationsDashboardView />
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusinessMode}" Value="True">
                            <Setter Property="Content">
                                <Setter.Value>
                                    <views:BusinessDashboardView />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>


        
        <!-- Loading Overlay -->
        <controls:SkeletonLoader Grid.RowSpan="3" 
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                 VerticalAlignment="Top" Height="200" Margin="0,100,0,0"/>

    </Grid>
</UserControl>


