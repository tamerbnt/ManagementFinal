<UserControl x:Class="Management.Presentation.Views.Shell.TopBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:converters="clr-namespace:Management.Presentation.Converters"
             xmlns:premium="clr-namespace:Management.Presentation.Controls.Premium"
             mc:Ignorable="d" 
             d:DesignHeight="80" d:DesignWidth="800">
    <UserControl.Resources>
        <converters:RelativeTimeConverter x:Key="RelativeTimeConverter" />
        
        <!-- Redesigned Search Bar Style -->
        <Style x:Key="TopBarSearchTextBox" TargetType="TextBox">
            <Setter Property="Width" Value="320"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="52,0,10,0"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10">
                            <Grid>
                                <!-- Search Icon -->
                                <Path x:Name="SearchIcon"
                                      Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" 
                                      Fill="{DynamicResource FacilityAccentBrush}" 
                                      Width="24" Height="24" 
                                      HorizontalAlignment="Left" 
                                      Margin="16,0,0,0" 
                                      VerticalAlignment="Center"/>

                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                                
                                <!-- Placeholder -->
                                <TextBlock x:Name="Placeholder" 
                                           Text="{DynamicResource Terminology.TopBar.SearchPlaceholder}" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           VerticalAlignment="Center" 
                                           Margin="52,0,0,0" 
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"
                                           FontSize="16"/>
                                
                                <!-- Shortcut Key indicator -->


                                <!-- Loading Spinner -->
                                <Path x:Name="LoadingSpinner"
                                      Visibility="Collapsed"
                                      Data="M12,4V2A10,10 0 0,0 2,12H4A8,8 0 0,1 12,4Z"
                                      Fill="{DynamicResource FacilityAccentBrush}"
                                      Width="16" Height="16"
                                      HorizontalAlignment="Right"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSearchLoading}" Value="True">
                                <Setter TargetName="LoadingSpinner" Property="Visibility" Value="Visible"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="SpinSearch">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="LoadingSpinner"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             From="0" To="360" Duration="0:0:1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="SpinSearch"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource FacilityAccentBrush}"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width" To="400" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <CircleEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width" To="320" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CircleEase EasingMode="EaseIn"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SeparatorStroke}" SnapsToDevicePixels="True">
        <Grid Background="Transparent" VerticalAlignment="Stretch" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Search Bar (left-aligned) -->
                <ColumnDefinition Width="*"/> <!-- Flexible spacer -->
                <ColumnDefinition Width="Auto"/> <!-- Actions (Notifications + Profile) -->
                <ColumnDefinition Width="Auto"/> <!-- Window Controls -->
            </Grid.ColumnDefinitions>

        <!-- Ctrl+K binding handled at MainWindow level -->

        <!-- SEARCH BAR (Expanding Dropdown) -->
        <Grid Grid.Column="0" VerticalAlignment="Top" Margin="0,0,0,0">
            <StackPanel HorizontalAlignment="Left">
                <TextBox x:Name="GlobalSearchBox"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource TopBarSearchTextBox}"
                         Loaded="OnSearchTextBoxLoaded">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SubmitSearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                
                <Popup x:Name="SearchPopup" 
                       AllowsTransparency="True"
                       IsOpen="{Binding IsSearchPopupOpen, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=GlobalSearchBox}"
                       Placement="Bottom"
                       VerticalOffset="8"
                       StaysOpen="False"
                       PopupAnimation="Fade">
                    <Border Background="{DynamicResource CardBackgroundBrush}" 
                            CornerRadius="14" 
                            BorderThickness="1" 
                            BorderBrush="{DynamicResource BorderBrush}"
                            Width="{Binding ElementName=GlobalSearchBox, Path=ActualWidth}"
                            MinHeight="100"
                            Padding="2"
                            Margin="12">

                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500">
                                <ItemsControl ItemsSource="{Binding SearchResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.ExecuteSearchItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{DynamicResource Button.Ghost}"
                                                    Focusable="False"
                                                    Click="OnSearchItemClicked"
                                                    HorizontalContentAlignment="Stretch"
                                                    Height="64"
                                                    Padding="12,8"
                                                    Margin="0,0"
                                                    Cursor="Hand">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="48"/> <!-- Icon Column -->
                                                        <ColumnDefinition Width="*"/> <!-- Title/Subtitle Column -->
                                                        <ColumnDefinition Width="Auto"/> <!-- Category Column -->
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource SurfaceBg}" HorizontalAlignment="Left">
                                                        <Path x:Name="TypeIcon" Width="18" Height="18" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <Border Grid.Column="2" Background="{DynamicResource SurfaceBg}" CornerRadius="4" Padding="6,3" VerticalAlignment="Center" Opacity="0.6">
                                                        <TextBlock Text="{Binding Group}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="8" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Button>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Group}" Value="MEMBERS">
                                                    <Setter TargetName="TypeIcon" Property="Data" Value="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Group}" Value="CLIENTS">
                                                    <Setter TargetName="TypeIcon" Property="Data" Value="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Group}" Value="STAFF">
                                                    <Setter TargetName="TypeIcon" Property="Data" Value="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"/>
                                                    <Setter TargetName="TypeIcon" Property="Fill" Value="{DynamicResource FacilityAccentBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Group}" Value="INVENTORY">
                                                    <Setter TargetName="TypeIcon" Property="Data" Value="M20,6H16V5A2,2 0 0,0 14,3H10A2,2 0 0,0 8,5V6H4A2,2 0 0,0 2,8V19A2,2 0 0,0 4,21H20A2,2 0 0,0 22,19V8A2,2 0 0,0 20,6M10,5H14V6H10V5M20,19H4V8H20V19M12,12A2,2 0 0,1 14,14A2,2 0 0,1 12,16A2,2 0 0,1 10,14A2,2 0 0,1 12,12Z"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Group}" Value="PLANS">
                                                    <Setter TargetName="TypeIcon" Property="Data" Value="M19,3H5C3.89,3 3,3.89 3,5V19C3,20.1 3.89,21 5,21H19C20.1,21 21,20.1 21,19V5C21,3.89 20.1,3 19,3M19,19H5V5H19V19M7,10H9V17H7V10M11,7H13V17H11V7M15,13H17V17H15V13Z"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Group}" Value="NAVIGATION">
                                                    <Setter TargetName="TypeIcon" Property="Data" Value="M12,2L4.5,20.29L5.21,21L12,18L18.79,21L19.5,20.29L12,2Z"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Popup>
            </StackPanel>
        </Grid>

        <!-- CONSOLIDATED ACTION & WINDOW CONTROL CARD -->
        <Border Grid.Column="2" Grid.ColumnSpan="2" 
                Height="60" 
                Background="{DynamicResource SurfaceBg}" 
                CornerRadius="14" 
                BorderThickness="1" 
                BorderBrush="{DynamicResource SeparatorStroke}"
                VerticalAlignment="Top" 
                HorizontalAlignment="Right"
                Margin="0,0,0,0"
                Padding="10,0"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel Orientation="Horizontal">
                <!-- Theme Toggle -->
                <premium:ThemeSegmentedToggle IsDarkTheme="{Binding IsDarkTheme, Mode=TwoWay}"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Center"
                                              shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                
                <Border Width="1" Background="{DynamicResource SeparatorStroke}" Margin="8,12" Opacity="0.3"/>
                
                <!-- 1. Sync Button -->
                <Button Command="{Binding ManualSyncCommand}"
                        ToolTip="{Binding LastSyncText}"
                        Style="{DynamicResource Button.Ghost}"
                        Width="40" Height="40"
                        Padding="0"
                        VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path x:Name="SyncIcon"
                          Data="M12,18A6,6 0 0,1 6,12C6,11 6.25,10.03 6.7,9.2L5.24,7.74C4.46,8.97 4,10.43 4,12A8,8 0 0,0 12,20V23L16,19L12,15M12,4V1L8,5L12,9V6A6,6 0 0,1 18,12C18,13 17.75,13.97 17.3,14.8L18.76,16.26C19.54,15.03 20,13.57 20,12A8,8 0 0,0 12,4Z"
                          Fill="{DynamicResource TextPrimaryBrush}"
                          Width="16" Height="16"
                          Stretch="Uniform">
                        <Path.RenderTransform>
                            <RotateTransform CenterX="7" CenterY="7"/>
                        </Path.RenderTransform>
                    </Path>
                </Button>

                <Border Width="1" Background="{DynamicResource SeparatorStroke}" Margin="8,12" Opacity="0.3"/>

                <!-- 2. Notifications -->
                <Grid>
                    <ToggleButton x:Name="NotifToggle" 
                                  Style="{DynamicResource ToggleButton.Ghost}"
                                  Width="40" Height="40"
                                  Padding="0"
                                  VerticalAlignment="Center"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid>
                            <Path Data="M12,21A2,2 0 0,0 14,19H10A2,2 0 0,0 12,21M18,15V10C18,6.93 16.36,4.36 13.5,3.68V3A1.5,1.5 0 0,0 12,1.5A1.5,1.5 0 0,0 10.5,3V3.68C7.63,4.36 6,6.92 6,10V15L4,17V18H20V17L18,15Z" 
                                  Fill="{DynamicResource TextPrimaryBrush}" 
                                  Width="16" Height="16" 
                                  Stretch="Uniform" />
                            <Border Background="{DynamicResource StatusErrorBrush}" 
                                    Width="6" Height="6" 
                                    CornerRadius="3"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,2,2,0"
                                    Visibility="{Binding NotificationCount, Converter={StaticResource IntToVisibilityConverter}}"/>
                        </Grid>
                    </ToggleButton>

                    <Popup IsOpen="{Binding IsChecked, ElementName=NotifToggle}" 
                           AllowsTransparency="True"
                           StaysOpen="False" 
                           PlacementTarget="{Binding ElementName=NotifToggle}"
                           Placement="Bottom" 
                           VerticalOffset="12"
                           HorizontalOffset="-134">
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="0" Width="300" Margin="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SeparatorStroke}">
                                    <Grid>
                                        <TextBlock Text="{DynamicResource Terminology.TopBar.Notifications}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" VerticalAlignment="Center"/>
                                        <Button Command="{Binding MarkAllAsReadCommand}" Style="{DynamicResource Button.Ghost}" HorizontalAlignment="Right" Padding="8,4" Height="Auto">
                                            <TextBlock Text="{DynamicResource Terminology.TopBar.MarkAllAsRead}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="1" MinHeight="200" MaxHeight="400">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Notifications}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{DynamicResource Button.Ghost}" Command="{Binding DataContext.MarkAsReadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Padding="0" Margin="0,1" Cursor="Hand">
                                                        <Border Padding="16,12" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SurfaceBg}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Top" Background="{DynamicResource SurfaceBgDim}">
                                                                    <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" Data="M11,9H13V7H11V9M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z"/>
                                                                </Border>
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                    <TextBlock Text="{Binding Message}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>

                <Border Width="1" Background="{DynamicResource SeparatorStroke}" Margin="8,12" Opacity="0.3"/>

                <!-- 3. Profile -->
                <Grid>
                    <ToggleButton x:Name="ProfileToggle" 
                                  Style="{DynamicResource ToggleButton.Ghost}"
                                  Padding="4,0"
                                  VerticalAlignment="Center"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="8,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UserName}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding UserRole}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10"/>
                            </StackPanel>
                            <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource Brush.Brand.Primary}">
                                <TextBlock Text="{Binding UserInitials}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </ToggleButton>

                    <Popup IsOpen="{Binding IsChecked, ElementName=ProfileToggle}" 
                           AllowsTransparency="True"
                           StaysOpen="False" 
                           PlacementTarget="{Binding ElementName=ProfileToggle}"
                           Placement="Bottom" 
                           VerticalOffset="12"
                           HorizontalOffset="-100">
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Padding="8" Width="200" Margin="12">
                            <StackPanel>
                                <Button Command="{Binding OpenProfileCommand}" Style="{DynamicResource Button.Ghost}" Padding="12,10" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{DynamicResource IconUsers}" Fill="{DynamicResource TextSecondaryBrush}" Width="14" Height="14" Margin="0,0,12,0" Stretch="Uniform"/>
                                        <TextBlock Text="Account Settings" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding OpenSettingsCommand}" Style="{DynamicResource Button.Ghost}" Padding="12,10" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{DynamicResource IconSettings}" Fill="{DynamicResource TextSecondaryBrush}" Width="14" Height="14" Margin="0,0,12,0" Stretch="Uniform"/>
                                        <TextBlock Text="Facility Preferences" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Button>
                                <Border Height="1" Background="{DynamicResource SeparatorStroke}" Margin="8,4" Opacity="0.5"/>
                                <Button Command="{Binding LogoutCommand}" Style="{DynamicResource Button.Ghost}" Padding="12,10" HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M16,17V14H9V10H16V7L21,12L16,17M14,2A2,2 0 0,1 16,4V6H14V4H5V20H14V18H16V20A2,2 0 0,1 14,22H5A2,2 0 0,1 3,20V4A2,2 0 0,1 5,2H14Z" Fill="{DynamicResource StatusErrorBrush}" Width="14" Height="14" Margin="0,0,12,0" Stretch="Uniform"/>
                                        <TextBlock Text="Log out" FontSize="13" Foreground="{DynamicResource StatusErrorBrush}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <Border Width="1" Background="{DynamicResource SeparatorStroke}" Margin="8,12" Opacity="0.3"/>

                <!-- 4. Window Controls -->
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Click="OnMinimize" Width="44" Height="44" Style="{DynamicResource Button.Ghost}" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{DynamicResource Terminology.Global.Minimize}">
                        <Path Data="M0,5 L12,5" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" Width="12" Height="10" Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button Click="OnMaximize" Width="44" Height="44" Style="{DynamicResource Button.Ghost}" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{DynamicResource Terminology.Global.Maximize}">
                        <Path x:Name="IconPath" Data="M0,2 L8,2 L8,10 L0,10 Z M3,0 L11,0 L11,8 L3,8" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="Transparent"/>
                    </Button>
                    <Button Click="OnClose" Width="44" Height="44" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{DynamicResource Terminology.Global.Close}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E81123"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="M0,0 L12,12 M12,0 L0,12" Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>



        </Grid>
    </Border>
</UserControl>
