<Window x:Class="Management.Presentation.Views.Salon.BookingModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:premium="clr-namespace:Management.Presentation.Controls.Premium"
        xmlns:converters="clr-namespace:Management.Presentation.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="{DynamicResource Terminology.Salon.Booking.Title}"
        Height="auto" Width="820"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        FlowDirection="{DynamicResource GlobalFlowDirection}">



    <Window.Resources>
        <!-- Resource keys from Converters.xaml are globally available via App.xaml -->
        <!-- We only define local styles or unique converters here -->
        
        <Style x:Key="InputLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="ToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <premium:ModalShellControl Title="{DynamicResource Terminology.Salon.Booking.Title}"
                               Subtitle="{DynamicResource Terminology.Salon.Booking.Subtitle}"
                               CancelCommand="{Binding CancelCommand}"
                               SaveCommand="{Binding BookCommand}"
                               PrimaryActionText="{DynamicResource Terminology.Salon.Booking.Action.Confirm}"
                               IsBusy="{Binding IsLoading}">
        
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: CLIENT & SERVICE -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource Terminology.Salon.Booking.ClientService}" Style="{StaticResource InputLabel}"/>

                <!-- Premium Segmented Toggle -->
                <Border Background="{DynamicResource Brush.Surface.Tertiary}" CornerRadius="22" Padding="4" Height="44" Margin="0,0,0,20" HorizontalAlignment="Left" Width="300">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Selection Pill -->
                        <Border Grid.Column="0" Background="{DynamicResource Brush.Surface.Background}" CornerRadius="18" 
                                HorizontalAlignment="Stretch" IsHitTestVisible="False" Loaded="SelectionPill_Loaded">
                            <Border.RenderTransform>
                                <TranslateTransform X="0"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.1" Direction="270"/>
                            </Border.Effect>
                        </Border>

                        <Button Content="{DynamicResource Terminology.Salon.Booking.ExistingMember}" Click="ExistingMember_Click" Style="{StaticResource ToggleButtonStyle}" BorderThickness="0" Background="Transparent" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="1" Content="{DynamicResource Terminology.Salon.Booking.QuickRegister}" Click="QuickRegister_Click" Style="{StaticResource ToggleButtonStyle}" BorderThickness="0" Background="Transparent" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                    </Grid>
                </Border>

                <!-- CLIENT SELECTION AREA -->
                <Border Background="{DynamicResource Brush.Surface.Secondary}" CornerRadius="20" Padding="20" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Margin="0,0,0,20">
                    <StackPanel>
                        <!-- 1. EXISTING MEMBER MODE -->
                        <StackPanel Visibility="{Binding IsExistingClientMode, Converter={StaticResource BoolToVis}}">
                            
                            <!-- Search State -->
                            <StackPanel Visibility="{Binding ShowSearchPanel, Converter={StaticResource BoolToVis}}">
                                <premium:PremiumSearchBox 
                                    Text="{Binding ClientSearchText, UpdateSourceTrigger=PropertyChanged}"
                                    Placeholder="{DynamicResource Terminology.Salon.Booking.SearchMember}"
                                    IconData="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                                    Margin="0,0,0,10"/>

                                <ListBox ItemsSource="{Binding FilteredClients}"
                                         SelectedValue="{Binding SelectedClientId}"
                                         SelectedValuePath="Id"
                                         MaxHeight="180" BorderThickness="0" Background="Transparent"
                                         Visibility="{Binding FilteredClients.Count, Converter={StaticResource IntToVisibilityConverter}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="12,8" CornerRadius="12" Margin="0,2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Dim}"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Tertiary}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource Brush.Accent.Dim}" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding FullName[0]}" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                                   FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                        <TextBlock Text="{Binding Phone}" FontSize="11" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </StackPanel>

                            <!-- Selected Client Card -->
                            <Border Background="{DynamicResource Brush.Accent.Dim}" CornerRadius="16" Padding="16"
                                    Visibility="{Binding HasSelectedClient, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource Brush.Surface.Background}" Margin="0,0,12,0">
                                        <Path Data="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2 M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z" 
                                              Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.5" Stretch="Uniform" Margin="12"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedClient.FullName}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                        <TextBlock Text="{Binding SelectedClient.Phone}" FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{DynamicResource Terminology.Salon.Booking.Change}" Command="{Binding ClearSelectedClientCommand}" 
                                            Style="{StaticResource ToggleButtonStyle}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 2. QUICK REGISTER MODE -->
                        <StackPanel Visibility="{Binding IsExistingClientMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <premium:PremiumSearchBox 
                                Text="{Binding SelectedClientName, UpdateSourceTrigger=PropertyChanged}"
                                Placeholder="{DynamicResource Terminology.Salon.Booking.EnterName}"
                                IconData="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2 M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"
                                Margin="0,0,0,16"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <premium:PremiumSearchBox Grid.Column="0"
                                    Text="{Binding Age, UpdateSourceTrigger=PropertyChanged}"
                                    Placeholder="{DynamicResource Terminology.Salon.Booking.Age}"
                                    IconData="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                
                                <ComboBox Grid.Column="2" ItemsSource="{Binding AcquisitionSources}"
                                          SelectedItem="{Binding AcquisitionSource}"
                                          Style="{StaticResource Input.ComboBox}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SERVICE SECTION -->
                <TextBlock Text="{DynamicResource Terminology.Salon.Booking.Service}" Style="{StaticResource InputLabel}"/>
                <ComboBox ItemsSource="{Binding AvailableServices}"
                          SelectedValue="{Binding SelectedServiceId}"
                          SelectedValuePath="Id"
                          Style="{StaticResource Input.ComboBox}"
                          Margin="0,0,0,20">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="{DynamicResource Terminology.Salon.Booking.Price}" Style="{StaticResource InputLabel}"/>
                <premium:PremiumSearchBox
                    Text="{Binding Price, StringFormat=N2}"
                    IconData="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"
                    IsEnabled="False"
                    IsSearchMode="False"/>
            </StackPanel>

            <!-- RIGHT COLUMN: STAFF & SCHEDULE -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="{DynamicResource Terminology.Salon.Booking.StaffSchedule}" Style="{StaticResource InputLabel}"/>
                
                <ComboBox ItemsSource="{Binding QualifiedStaff}"
                           SelectedValue="{Binding SelectedStaffId}"
                           SelectedValuePath="Id"
                           Style="{StaticResource Input.ComboBox}"
                           Margin="0,0,0,20">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FullName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="{DynamicResource Terminology.Salon.Booking.Date}" Style="{StaticResource InputLabel}"/>
                <DatePicker SelectedDate="{Binding BookingDate}" Style="{StaticResource DatePickerField}" Margin="0,0,0,20"/>

                <TextBlock Text="{DynamicResource Terminology.Salon.Booking.Time}" Style="{StaticResource InputLabel}"/>
                <premium:PremiumSearchBox
                    Text="{Binding BookingTime, StringFormat=\{0:hh\\:mm\}}"
                    Placeholder="09:00"
                    IconData="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                    IsSearchMode="False"
                    Margin="0,0,0,20"/>

                <TextBlock Text="{DynamicResource Terminology.Salon.Booking.Notes}" Style="{StaticResource InputLabel}"/>
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource Input.Field}"
                         Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                         Padding="12" VerticalContentAlignment="Top"/>
            </StackPanel>
        </Grid>
    </premium:ModalShellControl>
</Window>
