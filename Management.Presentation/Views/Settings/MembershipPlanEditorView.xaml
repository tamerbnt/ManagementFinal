<UserControl x:Class="Management.Presentation.Views.Settings.MembershipPlanEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Management.Presentation.Views.Settings"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Management.Presentation.Behaviors"
             mc:Ignorable="d" 
             d:DesignWidth="400" d:DesignHeight="800">

    <Border Padding="24">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Form -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,32">
                <Border Width="64" Height="64" 
                        Background="{DynamicResource Brush.Brand.Primary.Fade}" 
                        CornerRadius="32" 
                        HorizontalAlignment="Center" 
                        Margin="0,0,0,16">
                    <Path Data="{StaticResource Icon.Sliders}" 
                          Style="{DynamicResource Style.Icon.Large}" 
                          Stroke="{DynamicResource Brush.Brand.Primary}" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center"/>
                </Border>
                <TextBlock Foreground="{DynamicResource Brush.Text.Primary}"
                           HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Title2}">
                            <Setter Property="Text" Value="{DynamicResource Terminology.Settings.Editor.Title.Add}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                    <Setter Property="Text" Value="{DynamicResource Terminology.Settings.Editor.Title.Edit}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{DynamicResource Terminology.Settings.Editor.Title}" 
                           Style="{DynamicResource Text.Caption}" 
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 2. Form Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,24" Padding="0,0,12,0">
                <StackPanel>
                    <!-- Plan Name -->
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="{DynamicResource Terminology.Settings.Editor.PlanName}" Style="{DynamicResource FormLabel}" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource Input.Field}"/>
                    </StackPanel>

                    <!-- Price & Duration -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="{DynamicResource Terminology.Settings.Editor.PriceUSD}" Style="{DynamicResource FormLabel}" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding Price}" Style="{DynamicResource Input.Field}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="{DynamicResource Terminology.Settings.Editor.DurationDays}" Style="{DynamicResource FormLabel}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" 
                                          SelectedIndex="{Binding SelectedDurationIndex}" 
                                          Style="{DynamicResource Input.ComboBox}">
                                    <ComboBoxItem Content="1 Month"/>
                                    <ComboBoxItem Content="3 Months"/>
                                    <ComboBoxItem Content="1 Year"/>
                                    <ComboBoxItem Content="Other"/>
                                </ComboBox>
                                <TextBox Grid.Column="1" 
                                         Text="{Binding DurationDays}" 
                                         Style="{DynamicResource Input.Field}" 
                                         Width="80" 
                                         Margin="8,0,0,0" 
                                         Visibility="{Binding IsCustomDuration, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Sessions Per Week -->
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="Sessions Per Week (0 = Unlimited)" Style="{DynamicResource FormLabel}" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding SessionsPerWeek}" Style="{DynamicResource Input.Field}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,24">
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="{DynamicResource Terminology.Settings.Editor.IsActive}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium"/>
                            <CheckBox IsChecked="{Binding IsActive}" HorizontalAlignment="Right" Style="{StaticResource GlobalToggleSwitchStyle}"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="Personal Training" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium"/>
                            <CheckBox IsChecked="{Binding IsPersonalTraining}" HorizontalAlignment="Right" Style="{StaticResource GlobalToggleSwitchStyle}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Gender Rules -->
                    <StackPanel Margin="0,0,0,32">
                        <TextBlock Text="{DynamicResource Terminology.Settings.Editor.GenderRestriction}" Style="{DynamicResource FormLabel}" Margin="0,0,0,8"/>
                        
                        <Border Background="{DynamicResource SurfaceBgDim}" CornerRadius="22" Padding="4" Height="44">
                            <ListBox SelectedIndex="{Binding GenderRule}" 
                                     Background="Transparent"
                                     BorderThickness="0"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Setter Property="Padding" Value="0,4"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="18">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource SurfaceBg}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                        </Trigger>
                                                        <MultiTrigger>
                                                            <MultiTrigger.Conditions>
                                                                <Condition Property="IsMouseOver" Value="True"/>
                                                                <Condition Property="IsSelected" Value="False"/>
                                                            </MultiTrigger.Conditions>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                        </MultiTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                
                                <ListBoxItem Content="{DynamicResource Terminology.Settings.Editor.Gender.Unrestricted}"/>
                                <ListBoxItem Content="{DynamicResource Terminology.Settings.Editor.Gender.Male}"/>
                                <ListBoxItem Content="{DynamicResource Terminology.Settings.Editor.Gender.Female}"/>
                            </ListBox>
                        </Border>
                    </StackPanel>

                    <!-- Scheduling -->
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="{DynamicResource Terminology.Settings.Editor.AccessSchedule}" Style="{DynamicResource FormLabel}" VerticalAlignment="Center"/>
                            <Button Command="{Binding AddWindowCommand}" Content="{DynamicResource Terminology.Settings.Editor.AddWindow}" HorizontalAlignment="Right" Style="{DynamicResource GhostButton}"/>
                        </Grid>
                        
                        <ItemsControl ItemsSource="{Binding ScheduleWindows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Borderless row concept -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Day Selector Pill -->
                                        <Border Grid.Column="0" CornerRadius="22" 
                                                Background="{DynamicResource SurfaceBg}" 
                                                BorderThickness="1" 
                                                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                                Height="44"
                                                Margin="0,0,12,0"
                                                Padding="12,0">
                                            <ComboBox SelectedIndex="{Binding DayOfWeek}" 
                                                      BorderThickness="0" 
                                                      Background="Transparent" 
                                                      VerticalAlignment="Center" 
                                                      HorizontalContentAlignment="Stretch">
                                                <ComboBox.Resources>
                                                    <Style TargetType="ComboBoxItem">
                                                        <Setter Property="Padding" Value="12,8"/>
                                                    </Style>
                                                </ComboBox.Resources>
                                                <ComboBoxItem Content="{DynamicResource Terminology.Days.Sunday}"/>
                                                <ComboBoxItem Content="{DynamicResource Terminology.Days.Monday}"/>
                                                <ComboBoxItem Content="{DynamicResource Terminology.Days.Tuesday}"/>
                                                <ComboBoxItem Content="{DynamicResource Terminology.Days.Wednesday}"/>
                                                <ComboBoxItem Content="{DynamicResource Terminology.Days.Thursday}"/>
                                                <ComboBoxItem Content="{DynamicResource Terminology.Days.Friday}"/>
                                                <ComboBoxItem Content="{DynamicResource Terminology.Days.Saturday}"/>
                                            </ComboBox>
                                        </Border>

                                        <!-- Unified Time Range Capsule (Pill shaped) -->
                                        <Border Grid.Column="1" CornerRadius="18" 
                                                Background="{DynamicResource SurfaceBg}" 
                                                BorderThickness="1" 
                                                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                                Height="44"
                                                Padding="16,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Clock symbol as visual indicator -->
                                                <Path Grid.Column="0" Data="{StaticResource IconClock}" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                
                                                <TextBox Grid.Column="1" Text="{Binding StartTime}" 
                                                         BorderThickness="0" 
                                                         Background="Transparent" 
                                                         HorizontalContentAlignment="Center" 
                                                         VerticalAlignment="Center" 
                                                         FontFamily="Consolas" 
                                                         FontSize="16"
                                                         FontWeight="SemiBold"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                                         Tag="09:00"/>
                                                         
                                                <TextBlock Grid.Column="2" Text="→" 
                                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                                           VerticalAlignment="Center" 
                                                           Margin="12,0"/>
                                                           
                                                <TextBox Grid.Column="3" Text="{Binding EndTime}" 
                                                         BorderThickness="0" 
                                                         Background="Transparent" 
                                                         HorizontalContentAlignment="Center" 
                                                         VerticalAlignment="Center" 
                                                         FontFamily="Consolas"
                                                         FontSize="16" 
                                                         FontWeight="SemiBold"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                                         Tag="17:00"/>
                                            </Grid>
                                        </Border>

                                        <!-- Clean Delete Button -->
                                        <Button Grid.Column="2" 
                                                Command="{Binding DataContext.RemoveWindowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}"
                                                Style="{DynamicResource IconButtonStyle}" 
                                                Background="Transparent"
                                                BorderThickness="0"
                                                ToolTip="Delete Schedule"
                                                Foreground="{DynamicResource Brush.Functional.Error}"
                                                Margin="8,0,0,0">
                                            <Path Data="{StaticResource IconDelete}" Fill="{DynamicResource Brush.Functional.Error}" Stretch="Uniform" Width="18" Height="18"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. Footer -->
            <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,16,0,0">
                <Button Command="{Binding SaveCommand}" Content="{DynamicResource Terminology.Settings.Editor.SaveChanges}" Style="{DynamicResource PrimaryButton}" Height="40" Margin="0,0,0,12"/>
                <Button Command="{Binding CancelCommand}" Content="{DynamicResource Terminology.Settings.Editor.Cancel}" Style="{DynamicResource GhostButton}" Height="40"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
