<UserControl x:Class="Management.Presentation.Controls.Premium.PremiumSearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Height="44">
    <Border Background="{DynamicResource Brush.Surface.Card}" CornerRadius="24">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Surface.Border}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource FacilityAccentBrush}"/>
                        <Setter Property="BorderThickness" Value="2"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid Margin="16,0" MouseDown="Container_MouseDown" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search Icon (Geometry Support) -->
            <Path Grid.Column="0" Data="{Binding IconData, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                  Fill="{DynamicResource Brush.Text.Secondary}" Stretch="Uniform" Width="18" Height="18" VerticalAlignment="Center"
                  Visibility="{Binding IconData, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource StringToVisibilityConverter}}"/>

            <!-- Input Field -->
            <TextBox x:Name="PART_TextBox" Grid.Column="1" Background="Transparent" BorderThickness="0" VerticalAlignment="Stretch" VerticalContentAlignment="Center" 
                     Margin="12,0" FontSize="16" Foreground="{DynamicResource Brush.Text.Primary}" 
                     CaretBrush="{DynamicResource Brush.Brand.Primary}"
                     Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                     Tag="{Binding Placeholder, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TextBox">
                                    <Grid>
                                        <TextBlock Text="{TemplateBinding Tag}" Foreground="{DynamicResource Brush.Text.Secondary}" Visibility="{TemplateBinding Text, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Inverse}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                        <ScrollViewer x:Name="PART_ContentHost"/>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <!-- Clear (X) Button (Normally collapsed until text is typed) -->
            <Button Grid.Column="2" Width="20" Height="20" Background="#E5E7EB" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"
                    Visibility="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource StringToVisibilityConverter}}"
                    Command="{x:Static ApplicationCommands.Stop}">
                <Button.CommandBindings>
                    <CommandBinding Command="ApplicationCommands.Stop" Executed="ClearText_Executed"/>
                </Button.CommandBindings>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" 
                                  Fill="#6B7280" Stretch="Uniform" Margin="5"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</UserControl>
