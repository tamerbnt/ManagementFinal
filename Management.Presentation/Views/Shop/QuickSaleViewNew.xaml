<UserControl x:Class="Management.Presentation.Views.Shop.QuickSaleViewNew"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Management.Presentation.ViewModels.Shop"
             xmlns:converters="clr-namespace:Management.Presentation.Converters"
             xmlns:premium="clr-namespace:Management.Presentation.Controls.Premium"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:QuickSaleViewModel, IsDesignTimeCreatable=True}"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:CountToBooleanConverter x:Key="CountToBooleanConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="InverseNullToVisibilityConverter" Inverted="True"/>
        
        <!-- Missing icon aliases -->
        <StreamGeometry x:Key="IconMember">M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 7a4 4 0 1 0 0-8 4 4 0 0 0 0 8M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75</StreamGeometry>
        
        <Style x:Key="SelectionItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="OuterBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16,12"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterBorder" Property="Background" Value="#F9FAFB"/>
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource FacilityAccentDimBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="OuterBorder" Property="Background" Value="#F0F9FF"/>
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource FacilityAccentBrush}"/>
                                <Setter TargetName="OuterBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <premium:ModalShellControl Title="{DynamicResource Terminology.Modal.QuickSale.Title}" 
                             Subtitle="{DynamicResource Terminology.Modal.QuickSale.Subtitle}"
                             MaxWidth="820" MaxHeight="500"
                             CancelCommand="{Binding CancelCommand}"
                             SaveCommand="{Binding ProcessSaleCommand}"
                             PrimaryActionText="{DynamicResource Terminology.Modal.QuickSale.CompleteSale}">
        <Grid Margin="24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="65*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="35*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: PRODUCT SELECTION -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <premium:PremiumSearchBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Placeholder="{DynamicResource Terminology.Modal.QuickSale.SearchPlaceholder}"
                                         IconData="{StaticResource IconSearch}"
                                         Margin="0,0,0,16"/>

                <ListBox Grid.Row="1" 
                         ItemsSource="{Binding Products}" 
                         SelectedItem="{Binding SelectedProduct}"
                         ItemContainerStyle="{StaticResource SelectionItemStyle}"
                         Style="{StaticResource PremiumListBox}"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="False"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                    <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Price, StringFormat='{}{0:N2} DA'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource FacilityAccentBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Loading Overlay -->
                <Border Grid.Row="1" Background="{DynamicResource Brush.Surface.Card}" 
                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Opacity="0.7">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="100" Height="2" Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource Terminology.Modal.QuickSale.LoadingProducts}" FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- RIGHT COLUMN: MEMBER & CHECKOUT -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Background="Transparent">
                <StackPanel>
                    <!-- 1. MEMBER SELECTION -->
                    <Border Background="{DynamicResource Brush.Surface.Card}" CornerRadius="16" Padding="20" Margin="0,0,0,16" BorderBrush="#F3F4F6" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Terminology.Modal.QuickSale.CustomerLinking}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,0,12"/>
                            
                            <!-- Search & Suggestion Control -->
                            <Grid Visibility="{Binding SelectedMember, Converter={StaticResource InverseNullToVisibilityConverter}}">
                                <premium:PremiumSearchBox 
                                                         Text="{Binding MemberSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                         Placeholder="Search member..."
                                                         IconData="{StaticResource IconUsers}"
                                                         Height="42"/>
                                <Popup IsOpen="{Binding SearchedMembers.Count, Converter={StaticResource CountToBooleanConverter}, Mode=OneWay}"
                                       PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Grid}}"
                                       Placement="Bottom"
                                       StaysOpen="False"
                                       AllowsTransparency="True">
                                    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Width="240" MaxHeight="250">
                                        <ListBox ItemsSource="{Binding SearchedMembers}" BorderThickness="0" Background="Transparent" Padding="4">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding PlacementTarget.DataContext.SelectMemberCommand, RelativeSource={RelativeSource AncestorType=Popup}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource Button.Ghost}" HorizontalContentAlignment="Left" Padding="12,8">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="13"/>
                                                            <TextBlock Text="{Binding MemberId}" FontSize="11" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Popup>
                            </Grid>

                            <!-- Selected Member Badge -->
                            <Border Background="#EFF6FF" CornerRadius="10" Padding="10,6" Visibility="{Binding SelectedMember, Converter={StaticResource NullToVisibilityConverter}}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconMember}" Fill="#3B82F6" Width="14" Height="14" Margin="0,0,8,0" Stretch="Uniform"/>
                                        <TextBlock Text="{Binding SelectedMember.FullName}" FontWeight="Bold" Foreground="#1E40AF" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Command="{Binding ClearSelectedMemberCommand}" HorizontalAlignment="Right" Style="{DynamicResource Button.Ghost}" Width="20" Height="20" Padding="5">
                                        <Path Data="{StaticResource IconClose}" Fill="#1E40AF" Stretch="Uniform"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 2. ACTIVE SALE SUMMARY -->
                    <Border Background="{DynamicResource Brush.Surface.Glass}" CornerRadius="16" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Terminology.Modal.QuickSale.ActiveSale}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,0,12"/>
                            
                            <Grid Visibility="{Binding SelectedProduct, Converter={StaticResource NullToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedProduct.Name}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                    
                                    <!-- Dynamic Price Row with Strikethrough & Badge -->
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <!-- Original Price (Strikethrough) -->
                                        <TextBlock Text="{Binding OriginalPrice, StringFormat='{}{0:N2} DA'}" 
                                                   FontSize="14" 
                                                   Foreground="{DynamicResource Brush.Text.Tertiary}" 
                                                   TextDecorations="Strikethrough"
                                                   VerticalAlignment="Bottom"
                                                   Margin="0,0,8,4"
                                                   Visibility="{Binding IsDiscounted, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        
                                        <!-- Effective Price -->
                                        <TextBlock Text="{Binding EffectivePrice, StringFormat='{}{0:N2} DA'}" 
                                                   FontSize="22" 
                                                   FontWeight="ExtraBold" 
                                                   Foreground="{DynamicResource FacilityAccentBrush}" 
                                                   VerticalAlignment="Bottom"/>
                                        
                                        <!-- Discount Badge -->
                                        <Border Background="#D1FAE5" CornerRadius="12" Padding="8,2" Margin="10,0,0,4" VerticalAlignment="Bottom"
                                                Visibility="{Binding IsDiscounted, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding AppliedPromotionName}" FontSize="10" FontWeight="Bold" Foreground="#047857"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Selection Feedback -->
                            <StackPanel Visibility="{Binding SelectedProduct, Converter={StaticResource InverseNullToVisibilityConverter}}" HorizontalAlignment="Center" Margin="0,20">
                                <TextBlock Text="{DynamicResource Terminology.Modal.QuickSale.SelectToContinue}" FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}" FontStyle="Italic"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </premium:ModalShellControl>
</UserControl>
