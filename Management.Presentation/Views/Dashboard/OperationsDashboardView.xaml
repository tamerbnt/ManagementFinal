<UserControl x:Class="Management.Presentation.Views.Dashboard.OperationsDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:data="clr-namespace:Management.Presentation.Components.Data"
             xmlns:controls="clr-namespace:Management.Presentation.Resources.Controls"
             xmlns:shell="clr-namespace:Management.Presentation.ViewModels.Shell"
             xmlns:converters="clr-namespace:Management.Presentation.Converters"
             xmlns:dashcomps="clr-namespace:Management.Presentation.Components.Dashboard"
             xmlns:dash="clr-namespace:Management.Presentation.Views.Dashboard.Components"
             xmlns:premium="clr-namespace:Management.Presentation.Controls.Premium"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    <UserControl.Resources>
        <controls:BindingProxy x:Key="Proxy" Data="{Binding}" />
        <converters:TerminologyConverter x:Key="TerminologyConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToVisibilityInverseConverter x:Key="BoolToVisibilityInverseConverter"/>
        <converters:EqualToVisibilityConverter x:Key="EqualToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>

        <!-- Mini Mode Toggle for Detail/Summary switching in Cards -->
        <Style x:Key="Style.MiniModeToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="28" />
            <Setter Property="Width" Value="80" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Background="{DynamicResource Brush.Surface.Header}" CornerRadius="14" BorderBrush="{DynamicResource Brush.Surface.Border}" BorderThickness="1">
                            <Grid>
                                <!-- Icons -->
                                <Grid Margin="8,0">
                                    <Path x:Name="GraphIcon" Data="M19,3H5C3.89,3 3,3.9 3,5V19C3,20.1 3.89,21 5,21H19C20.1,21 21,20.1 21,19V5C21,3.9 20.1,3 19,3M9,17H7V10H9V17M13,17H11V7H13V17M17,17H15V12H17V17Z" 
                                          Fill="#94A3B8" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Left" />
                                    <Path x:Name="ListIcon" Data="M3,4H21V6H3V4M3,9H21V11H3V9M3,14H21V16H3V14M3,19H21V21H3V19Z" 
                                          Fill="#94A3B8" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Right" />
                                </Grid>
                                <!-- Thumb -->
                                <Border x:Name="Thumb" Background="{DynamicResource Brush.Surface.Primary}" Width="36" Height="22" CornerRadius="11" HorizontalAlignment="Left" Margin="2">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.1" Color="#000000"/>
                                    </Border.Effect>
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="ThumbTransform" X="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X" To="38" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Premium Dashboard Mode Toggle Style -->
        <Style x:Key="Style.DashboardModeToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="44" />
            <Setter Property="Width" Value="250" /> <!-- Slightly wider to accommodate track arrows -->
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <!-- Outer Track (Grey/Dark Pill) -->
                            <Border x:Name="Track" 
                                    Background="{DynamicResource Brush.Surface.Header}" 
                                    CornerRadius="22" 
                                    BorderBrush="{DynamicResource Brush.Surface.Border}" 
                                    BorderThickness="1.5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusinessMode}" Value="True">
                                                <Setter Property="Background" Value="#1E293B"/>
                                                <Setter Property="BorderBrush" Value="#475569"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Stationary Arrows (In the Track Area) -->
                            <Grid Margin="16,0">
                                <!-- Back Arrow (Visible on the left when thumb is on the right) -->
                                <Path x:Name="BackArrow" 
                                      Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" 
                                      Fill="White" 
                                      Width="14" Height="14" Stretch="Uniform" 
                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Opacity="0" Visibility="Visible"/>
                                      
                                <!-- Forward Arrow (Visible on the right when thumb is on the left) -->
                                <Path x:Name="ForwardArrow" 
                                      Data="M4,11V13H16L10.5,18.5L11.92,19.92L19.84,12L11.92,4.08L10.5,5.5L16,11H4Z" 
                                      Fill="{DynamicResource FacilityAccentBrush}" 
                                      Width="14" Height="14" Stretch="Uniform" 
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Opacity="1" Visibility="Visible"/>
                            </Grid>

                            <!-- Animated Thumb (The Moving Pill) -->
                            <Border x:Name="Thumb" 
                                    Background="White" 
                                    CornerRadius="19" 
                                    Margin="3" 
                                    HorizontalAlignment="Left"
                                    Width="184"
                                    Effect="{DynamicResource Shadow.Level2}">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform" X="0" />
                                </Border.RenderTransform>
                                <TextBlock x:Name="ThumbText" 
                                           Text="{DynamicResource Terminology.Dashboard.View.SwitchToBusiness}" 
                                           FontWeight="Bold" 
                                           FontSize="11" 
                                           Foreground="#1E293B" 
                                           VerticalAlignment="Center" 
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                            </Border>
                        </Grid>
                        
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                 <Setter TargetName="ThumbText" Property="Text" Value="{DynamicResource Terminology.Dashboard.View.SwitchToOperations}" />
                                 <Setter TargetName="ThumbText" Property="Foreground" Value="White" />
                                 <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource FacilityAccentBrush}" />
                                 <Trigger.EnterActions>
                                     <BeginStoryboard>
                                         <Storyboard>
                                             <DoubleAnimation Storyboard.TargetName="ThumbTransform" 
                                                              Storyboard.TargetProperty="X" 
                                                              To="60" Duration="0:0:0.35">
                                                 <DoubleAnimation.EasingFunction>
                                                     <QuarticEase EasingMode="EaseInOut" />
                                                 </DoubleAnimation.EasingFunction>
                                             </DoubleAnimation>
                                             <DoubleAnimation Storyboard.TargetName="ForwardArrow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                             <DoubleAnimation Storyboard.TargetName="BackArrow" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.2" Duration="0:0:0.15" />
                                         </Storyboard>
                                     </BeginStoryboard>
                                 </Trigger.EnterActions>
                                 <Trigger.ExitActions>
                                     <BeginStoryboard>
                                         <Storyboard>
                                             <DoubleAnimation Storyboard.TargetName="ThumbTransform" 
                                                              Storyboard.TargetProperty="X" 
                                                              To="0" Duration="0:0:0.35">
                                                 <DoubleAnimation.EasingFunction>
                                                     <QuarticEase EasingMode="EaseInOut" />
                                                 </DoubleAnimation.EasingFunction>
                                             </DoubleAnimation>
                                             <DoubleAnimation Storyboard.TargetName="BackArrow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                             <DoubleAnimation Storyboard.TargetName="ForwardArrow" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.2" Duration="0:0:0.15" />
                                         </Storyboard>
                                     </BeginStoryboard>
                                 </Trigger.ExitActions>
                            </Trigger>
                            
                            <Trigger Property="IsMouseOver" Value="True">
                                 <Setter TargetName="Thumb" Property="Effect" Value="{DynamicResource Shadow.Level3}" />
                            </Trigger>

                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Opacity" Value="0.6"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BounceValueStyle" TargetType="TextBlock">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.1" Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <ElasticEase Oscillations="2" Springiness="3"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.1" Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <ElasticEase Oscillations="2" Springiness="3"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

<!-- OPERATIONS VIEW (Original) -->
        <!-- ========================== -->
        <Grid Grid.Row="1" Grid.RowSpan="2">
            
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <!-- Row 1: Bento Grid Stats -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" /> <!-- Hero -->
                    <ColumnDefinition Width="1*" />   <!-- Standard -->
                    <ColumnDefinition Width="1*" />   <!-- Split Column -->
                    <ColumnDefinition Width="1*" />   <!-- Actions/Extra -->
                </Grid.ColumnDefinitions>

                <!-- 1. Hero Card: People Inside (Gym) / Today's Appointments (Salon) -->
                <Grid Grid.Column="0" Margin="0,0,16,0">
                    <!-- Gym: People Inside -->
                    <Border CornerRadius="16" Background="{DynamicResource CardBackgroundBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSalonMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid Margin="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- HEADER: Icon + Label -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,16">
                                <Path Data="{StaticResource IconGym}" Stroke="{DynamicResource FacilityAccentBrush}" StrokeThickness="1.8" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Foreground="{DynamicResource Brush.Card.Foreground}" FontWeight="Bold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{DynamicResource Terminology.Dashboard.Stat.PeopleInside}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRestaurantMode}" Value="True">
                                                    <Setter Property="Text" Value="{DynamicResource Terminology.Dashboard.Stat.LiveTableStatus}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="{Binding PeopleInside}" Foreground="{DynamicResource Brush.Card.Foreground}" FontSize="48" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Grid.Row="2" CornerRadius="12" HorizontalAlignment="Left" Padding="8,4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRestaurantMode}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasPeopleInsideTrend}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding PeopleInsideTrendText}" Foreground="{DynamicResource Brush.Card.Foreground}" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            
                            <!-- Restaurant: Table Seating Percent -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Visibility="{Binding IsRestaurantMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border Background="{DynamicResource FacilityAccentBrush}" CornerRadius="10" Padding="8,3" Margin="0,0,8,0">
                                    <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold">
                                        <Run Text="{Binding ActiveTablesCount}"/><Run Text="/"/><Run Text="{Binding TotalTablesCount}"/><Run Text=" "/><Run Text="{DynamicResource Terminology.Dashboard.TablesOccupied}"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- Salon: Today's Appointments -->
                    <Border CornerRadius="16" Background="{DynamicResource CardBackgroundBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSalonMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid Margin="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- HEADER: Icon + Label -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,16">
                                <Path Data="{StaticResource IconClock}" Stroke="{DynamicResource FacilityAccentBrush}" StrokeThickness="1.8" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{DynamicResource Terminology.Dashboard.Stat.TodaysAppointments}" Foreground="{DynamicResource Brush.Card.Foreground}" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="{Binding TodayAppointmentsTotal}" Foreground="{DynamicResource Brush.Card.Foreground}" FontSize="48" FontWeight="Bold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Border Background="{DynamicResource StatusSuccessBrush}" CornerRadius="10" Padding="8,3" Margin="0,0,8,0">
                                    <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold">
                                        <Run Text="&#x2713; "/><Run Text="{Binding TodayAppointmentsCompleted}"/><Run Text=" "/><Run Text="{DynamicResource Terminology.Dashboard.Stat.Done}"/>
                                    </TextBlock>
                                </Border>
                                <Border Background="#30FFFFFF" CornerRadius="10" Padding="8,3">
                                    <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold">
                                        <Run Text="&#x23F3; "/><Run Text="{Binding TodayAppointmentsPending}"/><Run Text=" "/><Run Text="{DynamicResource Terminology.Dashboard.Stat.Upcoming}"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 2. Active Members (Gym) / Today's Covers (Restaurant) -->
                <data:StatTile Grid.Column="1" Margin="0,0,16,0" 
                               Value="{Binding TotalActiveMembers}" 
                               IconData="{DynamicResource IconMembers}" 
                               IconBrush="{DynamicResource StatusSuccessBrush}" 
                               IsLoading="{Binding IsLoading}">
                    <data:StatTile.Style>
                        <Style TargetType="data:StatTile">
                            <Setter Property="Label" Value="{DynamicResource Terminology.Dashboard.Stat.ActiveMembers}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRestaurantMode}" Value="True">
                                    <Setter Property="Label" Value="{DynamicResource Terminology.Dashboard.Stat.CoversToday}"/>
                                    <Setter Property="Value" Value="{Binding TodayCovers}"/>
                                    <Setter Property="IconData" Value="{DynamicResource IconMembers}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSalonMode}" Value="True">
                                    <Setter Property="Label" Value="{DynamicResource Terminology.Dashboard.Stat.ActiveClients}"/>
                                    <Setter Property="Value" Value="{Binding TotalActiveMembers}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </data:StatTile.Style>
                </data:StatTile>

                <!-- 3. Split Column (Expiring / Pending) -->
                <Grid Grid.Column="2" Margin="0,0,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" /> <!-- Spacer -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <!-- Expiring -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="16">
                        <Grid Margin="16,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!-- HEADER: Icon + Label -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,12">
                                <Path Data="{DynamicResource IconClock}" Stroke="{DynamicResource StatusWarningBrush}" StrokeThickness="1.8" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Card.Foreground}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{DynamicResource Terminology.Dashboard.Stat.ExpiringSoon}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRestaurantMode}" Value="True">
                                                    <Setter Property="Text" Value="{DynamicResource Terminology.Dashboard.Stat.AverageOrderValue}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Grid.Row="1" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding ExpiringSoonCount}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRestaurantMode}" Value="True">
                                                <Setter Property="Text" Value="{Binding AverageOrderValue, Converter={StaticResource AbbreviatedCurrencyConverter}}"/>
                                                <Setter Property="ToolTip" Value="{Binding AverageOrderValue, Converter={StaticResource AbbreviatedCurrencyConverter}, ConverterParameter=Full}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Pending -->
                    <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="16">
                        <Grid Margin="16,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!-- HEADER: Icon + Label -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,12">
                                <Path Data="{DynamicResource IconRegistrations}" Stroke="{DynamicResource StatusErrorBrush}" StrokeThickness="1.8" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Card.Foreground}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{DynamicResource Terminology.Dashboard.Stat.PendingRegs}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRestaurantMode}" Value="True">
                                                    <Setter Property="Text" Value="{DynamicResource Terminology.Dashboard.Stat.PendingOrders}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Grid.Row="1" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding PendingRegistrationsCount}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRestaurantMode}" Value="True">
                                                <Setter Property="Text" Value="{Binding PendingOrdersCount}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 4. Revenue Snapshot (Replaces Quick Actions) -->
                 <Border Grid.Column="3" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="16">
                    <Grid Margin="20">
                         <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,16">
                            <Path Data="{DynamicResource IconFinance}" Stroke="#A78BFA" StrokeThickness="1.8" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/> 
                            <TextBlock Text="{DynamicResource Terminology.Home.RevenueToday}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Card.Foreground}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                             <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center">
                                 <TextBlock Text="{Binding FinancialSummary.Revenue, Converter={StaticResource AbbreviatedCurrencyConverter}}" 
                                            FontSize="36" FontWeight="Bold" Foreground="{DynamicResource Brush.Card.Foreground}">
                                     <TextBlock.ToolTip>
                                         <ToolTip Content="{Binding FinancialSummary.Revenue, Converter={StaticResource AbbreviatedCurrencyConverter}, ConverterParameter=Full}" 
                                                  Style="{StaticResource ToolTip.Standard}"/>
                                     </TextBlock.ToolTip>
                                     <TextBlock.Style>
                                         <Style TargetType="TextBlock">
                                             <Setter Property="RenderTransform">
                                                 <Setter.Value>
                                                     <ScaleTransform CenterX="0" CenterY="18"/>
                                                 </Setter.Value>
                                             </Setter>
                                             <Style.Triggers>
                                                 <Trigger Property="IsMouseOver" Value="True">
                                                     <Trigger.EnterActions>
                                                         <BeginStoryboard>
                                                             <Storyboard>
                                                                 <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.2"/>
                                                                 <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.2"/>
                                                             </Storyboard>
                                                         </BeginStoryboard>
                                                     </Trigger.EnterActions>
                                                     <Trigger.ExitActions>
                                                         <BeginStoryboard>
                                                             <Storyboard>
                                                                 <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.2"/>
                                                                 <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.2"/>
                                                             </Storyboard>
                                                         </BeginStoryboard>
                                                     </Trigger.ExitActions>
                                                 </Trigger>
                                             </Style.Triggers>
                                         </Style>
                                     </TextBlock.Style>
                                 </TextBlock>
                             </Viewbox>
                             <ProgressBar Value="{Binding RevenueProgress}" Maximum="1" Height="4" Background="#20FFFFFF" Foreground="{DynamicResource FacilityAccentBrush}" BorderThickness="0" Margin="0,8,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <TextBlock Text="{Binding RevenueProgress, StringFormat={}{0:P0}}" FontWeight="Bold" Foreground="{DynamicResource FacilityAccentBrush}" FontSize="12"/>
                            <TextBlock Text="{DynamicResource Terminology.Dashboard.Stat.DailyTarget}" Foreground="White" Opacity="0.7" FontSize="12" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Row 2: Content Grid (Chart Left, Member Dev Right) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.8*" /> <!-- Occupancy Chart -->
                    <ColumnDefinition Width="1.2*" /> <!-- Member Development -->
                </Grid.ColumnDefinitions>

                <!-- Chart Section -->
            <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="16" Margin="0,0,24,0">
                    <Grid Margin="32">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- HEADER: Icon + Label + Filter -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Path Data="{DynamicResource IconDashboard}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Terminology.Dashboard.Chart.Occupancy.Title}" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{DynamicResource Terminology.Dashboard.Chart.Occupancy.Subtitle}" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- DAY FILTERS -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FormattedOccupancyDate}" VerticalAlignment="Center" Margin="0,0,12,0" 
                                           Foreground="{DynamicResource FacilityAccentBrush}" FontWeight="SemiBold" FontSize="12"/>
                                
                                <Border Background="{DynamicResource FacilitySidebarBrush}" CornerRadius="12" Padding="4">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Today Button -->
                                        <Button Command="{Binding SetOccupancyFilterCommand}" CommandParameter="Today"
                                                Padding="12,4" Margin="2,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                                    <Setter Property="FontSize" Value="11"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedOccupancyDate}" Value="{x:Static System:DateTime.Today}">
                                                            <Setter Property="Background" Value="{DynamicResource FacilityAccentBrush}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="{DynamicResource Terminology.Dashboard.Range.Today}"/>
                                        </Button>
                                        
                                        <!-- Yesterday Button -->
                                        <Button Command="{Binding SetOccupancyFilterCommand}" CommandParameter="Yesterday"
                                                Padding="12,4" Margin="2,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                                    <Setter Property="FontSize" Value="11"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <!-- Need a property for yesterday or just use a helper -->
                                                        <DataTrigger Binding="{Binding FormattedOccupancyDate}" Value="YESTERDAY">
                                                            <Setter Property="Background" Value="{DynamicResource FacilityAccentBrush}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="{DynamicResource Terminology.Dashboard.Range.Yesterday}"/>
                                        </Button>
                                        
                                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,2"/>
                                        
                                        <!-- Calendar Select -->
                                        <Grid Margin="2,0">
                                            <DatePicker SelectedDate="{Binding SelectedOccupancyDate, Mode=TwoWay}"
                                                       Width="32" Height="28" Opacity="0" 
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <Button Style="{StaticResource Button.Ghost}" Padding="8,4" IsHitTestVisible="False"
                                                    ToolTip="{DynamicResource Terminology.Dashboard.Action.SelectDate}">
                                                <Path Data="{DynamicResource IconCalendar}" Stroke="White" StrokeThickness="1.5" Width="14" Height="12" Stretch="Uniform"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                
                                <!-- Loading Spinner (Granular) -->
                                <Border Width="16" Height="16" Margin="12,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding IsOccupancyLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Path Data="M12,4V2A10,10 0 0,0 2,12H4A8,8 0 0,1 12,4Z" Fill="{DynamicResource FacilityAccentBrush}" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="Rotator" Angle="0"/>
                                        </Path.RenderTransform>
                                        <Path.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Rotator" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Path.Triggers>
                                    </Path>
                                </Border>
                            </StackPanel>
                        </Grid>
                        
                        <lvc:CartesianChart Grid.Row="1" Margin="0,24,0,0"
                                            Series="{Binding OccupancySeries}" 
                                            XAxes="{Binding OccupancyXAxes}"
                                            YAxes="{Binding OccupancyYAxes}" 
                                            TooltipPosition="Top">
                        </lvc:CartesianChart>
                    </Grid>
                </Border>

                <!-- Right Panel: Member Development Trend (High Fidelity) -->
                <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,0">
                    <dashcomps:RevenueByPlanCard VerticalAlignment="Stretch" Margin="0,0,0,0">
                        <dashcomps:RevenueByPlanCard.Style>
                            <Style TargetType="dashcomps:RevenueByPlanCard">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSalonMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </dashcomps:RevenueByPlanCard.Style>
                    </dashcomps:RevenueByPlanCard>

                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGymMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid Margin="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header Row: Icon + Title (left) | Month Navigator (right) -->
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,16">
                                    <Path Data="{DynamicResource IconMembers}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Strings.Shell.MemberDevelopment}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{DynamicResource Strings.Shell.Totalactivememberstrend}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Right: Month Navigation -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding PreviousMonthCommand}" Cursor="Hand" Style="{DynamicResource IconButtonStyle}" Padding="6,4">
                                        <Path Data="{DynamicResource IconChevronLeft}" Fill="{DynamicResource TextSecondaryBrush}" Width="8" Height="12" Stretch="Uniform"/>
                                    </Button>
                                    <TextBlock Text="{Binding FormattedSelectedMonth}" FontWeight="SemiBold" FontSize="12" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <Button Command="{Binding NextMonthCommand}" Cursor="Hand" Style="{DynamicResource IconButtonStyle}" Padding="6,4">
                                        <Path Data="{DynamicResource IconChevronRight}" Fill="{DynamicResource TextSecondaryBrush}" Width="8" Height="12" Stretch="Uniform"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <lvc:CartesianChart Grid.Row="1" 
                                              Series="{Binding MemberSeries}" 
                                              XAxes="{Binding MemberXAxes}"
                                              YAxes="{Binding MemberYAxes}"
                                              TooltipPosition="Top"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ========================== -->
        <!-- BUSINESS VIEW (New)        -->
        <!-- ========================== -->
        

</UserControl>

