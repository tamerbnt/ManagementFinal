<Window x:Class="Management.Presentation.Views.Auth.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:auth="clr-namespace:Management.Presentation.Views.Auth"
        xmlns:authvm="clr-namespace:Management.Presentation.ViewModels.Auth"
        xmlns:viewmodels="clr-namespace:Management.Presentation.ViewModels"
        xmlns:sharedVm="clr-namespace:Management.Presentation.ViewModels.Shared"
        xmlns:sharedView="clr-namespace:Management.Presentation.Views.Shared"
        xmlns:reg="clr-namespace:Management.Presentation.Views.Registrations"
        xmlns:premium="clr-namespace:Management.Presentation.Controls.Premium"
        mc:Ignorable="d"
        Title="{DynamicResource Strings.Auth.LuxuryaActivation}"
        MinHeight="600" Height="680" MaxHeight="720" Width="980"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseDown="OnMouseLeftButtonDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resources/Converters.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- View routing DataTemplates -->
            <DataTemplate DataType="{x:Type viewmodels:LicenseEntryViewModel}">
                <auth:LicenseEntryView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:OnboardingOwnerViewModel}">
                <auth:OnboardingOwnerView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:LoginViewModel}">
                <auth:LoginView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type authvm:SplashOnboardingViewModel}">
                <auth:SplashOnboardingView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type sharedVm:ConfirmationModalViewModel}">
                <sharedView:ConfirmationModal/>
            </DataTemplate>


            <Style x:Key="GlobalModalContainerStyle" TargetType="Border">
                <Setter Property="Background" Value="#F0FFFFFF"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="24"/>
                <Setter Property="Padding" Value="32"/>
                <Setter Property="Effect">
                    <Setter.Value><StaticResource ResourceKey="Shadow4"/></Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Title2" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            </Style>
            <Style x:Key="Body" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
            </Style>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            GlassFrameThickness="-1"
                            CornerRadius="24"
                            ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <!-- ROOT BORDER: clips everything into rounded corners.
         #CCE3F0 is the specific light blue color from the illustration background. -->
    <Border CornerRadius="24" ClipToBounds="True" Background="#CCE3F0">

        <Grid MouseDown="OnMouseLeftButtonDown">
            <!-- PERFORMANCE WARMING: Invisible instance to prime the animation storyboards -->
            <premium:AtriumMarkAnimation x:Name="WarmingAnim" Opacity="0" IsHitTestVisible="False" Width="1" Height="1" 
                                         HorizontalAlignment="Left" VerticalAlignment="Top"/>

            <!-- ══════════════════════════════════════════════════════
                 LAYER 1 — BACKGROUND CROSSFADER (Onboarding Slides)
                 ══════════════════════════════════════════════════════ -->
            <ItemsControl ItemsSource="{Binding Slides}" IsHitTestVisible="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Grid/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Panel.ZIndex" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Panel.ZIndex" Value="1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="BgSlide" Opacity="0" CacheMode="BitmapCache">
                            <Border Background="{Binding BackgroundColor}" CornerRadius="24"/>
                            <Ellipse Width="1200" Height="1200" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.06">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="{Binding TitleColor}" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BgSlide" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6" FillBehavior="HoldEnd">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard></BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BgSlide" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:1.0" FillBehavior="HoldEnd">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard></BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ══════════════════════════════════════════════════════
                 LAYER 2 — MAIN LAYOUT (Left Card & Right Presentation)
                 ══════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Main Content Card Container -->
                <Border x:Name="CardBorder"
                        Grid.Column="0"
                        Width="450"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        Background="White"
                        CornerRadius="24"
                        Margin="40,40,0,40"
                        Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform X="-50"/>
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <!-- Card slides in from left as overlay clears (BeginTime=2300ms matches overlay at 40% faded) -->
                                <DoubleAnimation
                                    Storyboard.TargetName="CardBorder"
                                    Storyboard.TargetProperty="Opacity"
                                    From="0" To="1"
                                    Duration="0:0:0.6" BeginTime="0:0:2.3"
                                    FillBehavior="HoldEnd">
                                    <DoubleAnimation.EasingFunction>
                                        <QuarticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation
                                    Storyboard.TargetName="CardBorder"
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                    From="-50" To="0"
                                    Duration="0:0:0.6" BeginTime="0:0:2.3"
                                    FillBehavior="HoldEnd">
                                    <DoubleAnimation.EasingFunction>
                                        <QuarticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="60" ShadowDepth="10" Opacity="0.13"
                                      Direction="270" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <!-- Fallback skeleton: visible ONLY when CurrentView is null -->
                    <auth:LoginSkeletonView Visibility="{Binding CurrentView, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}"/>
                    
                    <!-- Main content: fades in/out as views change, with silent scroll -->
                    <ScrollViewer Style="{DynamicResource Style.ScrollViewer.PremiumOverlay}">
                        <ContentControl Content="{Binding CurrentView}"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Top"
                                        Focusable="False"/>
                    </ScrollViewer>
                </Grid>
            </Border>

                <!-- RIGHT: Typography, Illustration, and Navigation -->
                <Grid Grid.Column="1" Margin="0,48,48,48">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ROW 0: High-End Cinematic Typography Reveal -->
                    <!-- Reduced to 48px, Switched to Staggered BlurEffect Entry -->
                    <ItemsControl Grid.Row="0" ItemsSource="{Binding Slides}" Background="Transparent" BorderThickness="0" IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Grid/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="MasterTextGrid" Opacity="0" Visibility="Hidden" HorizontalAlignment="Right" VerticalAlignment="Top" CacheMode="BitmapCache">
                                    <StackPanel>
                                        <!-- Elevated Font to Georgia Italic Light -->
                                        <premium:StaggeredTextRevealControl x:Name="HeadlineText" Text="{Binding EmotionalHeadline}" Foreground="{Binding TitleColor}" FontFamily="Georgia, Playfair Display, Serif" FontStyle="Italic" FontWeight="Light" FontSize="48" Margin="0,0,0,12" HorizontalAlignment="Right" IsSelected="{Binding IsSelected}" />
                                        <TextBlock x:Name="SubtitleText" Text="{Binding TechnicalSubtitle}" Foreground="{Binding SubtitleColor}" FontSize="16" FontWeight="Medium" LineHeight="24" MaxWidth="420" TextWrapping="Wrap" HorizontalAlignment="Right" TextAlignment="Right" Opacity="0">
                                            <TextBlock.RenderTransform><TranslateTransform Y="20"/></TextBlock.RenderTransform>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="MasterTextGrid" Property="Visibility" Value="Visible"/>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard><Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="MasterTextGrid" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
                                                <!-- Staggered Subtitle (Starts at 150ms) -->
                                                <DoubleAnimation Storyboard.TargetName="SubtitleText" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="SubtitleText" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="20" To="0" Duration="0:0:0.4" BeginTime="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard></BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard><Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="MasterTextGrid" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" BeginTime="0:0:0.22"/>
                                                <DoubleAnimation Storyboard.TargetName="SubtitleText" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="SubtitleText" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-16" Duration="0:0:0.2">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard></BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ROW 1: Centered Illustration with Masking & Fluid Gravity -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Slides}" Background="Transparent" BorderThickness="0" IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Grid/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="ImgRoot" Opacity="0" Visibility="Hidden" CacheMode="BitmapCache">
                                    <Grid.RenderTransformOrigin>0.5,0.5</Grid.RenderTransformOrigin>
                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </Grid.RenderTransform>
                                    
                                    <Image Source="{Binding ImagePath}" Stretch="Uniform" MaxWidth="380" MaxHeight="380" HorizontalAlignment="Right" VerticalAlignment="Center" x:Name="FloatingImage">
                                        <Image.RenderTransform><TranslateTransform/></Image.RenderTransform>
                                        
                                        <!-- Radial Mask absolutely neutralizes the hard colored box edge -->
                                        <Image.OpacityMask>
                                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                                <GradientStop Color="#FFFFFFFF" Offset="0.6"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                                            </RadialGradientBrush>
                                        </Image.OpacityMask>
                                    </Image>
                                </Grid>
                                
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="ImgRoot" Property="Visibility" Value="Visible"/>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard><Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ImgRoot" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetName="ImgRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" From="0.96" To="1" Duration="0:0:0.4" BeginTime="0:0:0.1">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="ImgRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" From="0.96" To="1" Duration="0:0:0.4" BeginTime="0:0:0.1">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard></BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard><Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ImgRoot" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.28"/>
                                                <DoubleAnimation Storyboard.TargetName="ImgRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.03" Duration="0:0:0.28">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="ImgRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.03" Duration="0:0:0.28">
                                                    <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard></BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ROW 2: The Adaptive Bi-Directional Swipe Interactive Cue -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        
                        <!-- PREVIOUS Slide Button -->
                        <Button Command="{Binding PrevSlideCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,16,0" ToolTip="Previous Slide">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBorder" Background="Transparent" Padding="8">
                                        <Path x:Name="ChevLeft" Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" Fill="{Binding CurrentActionColor}" Width="16" Height="16" Stretch="Uniform" Opacity="0.5">
                                            <Path.RenderTransform><TranslateTransform/></Path.RenderTransform>
                                        </Path>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ChevLeft" Property="Opacity" Value="1"/>
                                        </Trigger>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="ChevLeft" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="-4" Duration="0:0:0.8" AutoReverse="True">
                                                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- DYNAMIC Navigation Dots -->
                        <ItemsControl ItemsSource="{Binding Slides}" VerticalAlignment="Center" Margin="0,0,16,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="14" Height="5" Margin="0,0,12,0" Background="Transparent" CacheMode="BitmapCache">
                                        <Border x:Name="Dot" Width="5" Height="5" CornerRadius="2.5" HorizontalAlignment="Left">
                                            <Border.Background>
                                                <SolidColorBrush Color="#40FFFFFF"/>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard><Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Width" To="14" Duration="0:0:0.2">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <ColorAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#FFFFFFFF" Duration="0:0:0.2"/>
                                                </Storyboard></BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard><Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Width" To="5" Duration="0:0:0.2">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <ColorAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#40FFFFFF" Duration="0:0:0.2"/>
                                                </Storyboard></BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- NEXT Slide Button -->
                        <Button Command="{Binding NextSlideCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Next Slide">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBorder" Background="Transparent" Padding="8">
                                        <Path x:Name="ChevRight" Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" Fill="{Binding CurrentActionColor}" Width="16" Height="16" Stretch="Uniform" Opacity="0.5">
                                            <Path.RenderTransform><TranslateTransform/></Path.RenderTransform>
                                        </Path>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ChevRight" Property="Opacity" Value="1"/>
                                        </Trigger>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="ChevRight" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="4" Duration="0:0:0.8" AutoReverse="True">
                                                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ══════════════════════════════════════════════════════
                 LAYER 4 — MODAL OVERLAY
                 ══════════════════════════════════════════════════════ -->
            <Grid Visibility="{Binding IsModalOpen, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                  Panel.ZIndex="1000">
                <Border Background="#66000000" MouseDown="OnMouseLeftButtonDown"/>
                <ContentControl Content="{Binding CurrentModal}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ContentControl.Resources>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentModal}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Resources>
                </ContentControl>
            </Grid>

            <!-- ══════════════════════════════════════════════════════
                 LAYER 5 — MINIMIZE + CLOSE BUTTONS (top-right)
                 ══════════════════════════════════════════════════════ -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,16,20,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Panel.ZIndex="2000">

                <Button Click="MinimizeButton_Click" Margin="0,0,8,0"
                        Width="30" Height="30"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="Transparent" CornerRadius="15">
                                <Path x:Name="icon" Data="M19,13H5V11H19V13Z" Fill="#374151"
                                      Stretch="Uniform" Width="12" Height="2"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#18000000"/>
                                    <Setter TargetName="icon" Property="Fill" Value="#111827"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Click="CloseButton_Click"
                        Width="30" Height="30"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="Transparent" CornerRadius="15">
                                <Path x:Name="icon"
                                      Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                      Fill="#374151" Stretch="Uniform" Width="12" Height="12"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#18EF4444"/>
                                    <Setter TargetName="icon" Property="Fill" Value="#EF4444"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>

            <!-- Toast notifications overlay -->
            <ItemsControl ItemsSource="{Binding ActiveToasts}"
                          VerticalAlignment="Top" 
                          HorizontalAlignment="Right"
                          Margin="0,24,24,0" 
                          Panel.ZIndex="3000">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Reusing the standard toast design from the system -->
                        <Border x:Name="ToastCard" 
                                Width="320" 
                                CornerRadius="12" 
                                Background="White"
                                Padding="12"
                                Margin="0,0,0,8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" Opacity="0.10" Color="Black" Direction="270" ShadowDepth="4"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Type Icon -->
                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6" Margin="0,0,10,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="Success">
                                                    <Setter Property="Background" Value="#E8F5E9"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Error">
                                                    <Setter Property="Background" Value="#FEECEC"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Warning">
                                                    <Setter Property="Background" Value="#FFF8E1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
