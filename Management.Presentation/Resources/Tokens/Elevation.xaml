<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 
        APPLE 2025 ELEVATION SYSTEM (Performance Optimized)
        
        Logic: 
        - Standard tiers use DynamicResource ElevationColor for adaptive depth.
        - RenderingBias="Performance" is enforced to minimize GPU overdraw.
        - Shadow.LevelX keys for new code; ShadowX keys for legacy compatibility.
    -->

    <!-- Level 1: Subtle (Cards / List Items) -->
    <DropShadowEffect x:Key="Shadow.Level1" x:Shared="False" Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0" />
    
    <DropShadowEffect x:Key="Shadow1" x:Shared="False" Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0" />

    <!-- Level 2: Standard (Dropdowns / Popovers) -->
    <DropShadowEffect x:Key="Shadow.Level2" x:Shared="False" Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0" />

    <DropShadowEffect x:Key="Shadow2" x:Shared="False" Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0" />

    <!-- Level 3: Floating (Modals / Sticky Headers) -->
    <DropShadowEffect x:Key="Shadow.Level3" x:Shared="False" Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0" />

    <DropShadowEffect x:Key="Shadow3" x:Shared="False" Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0" />

    <!-- Level 4: Deep (Dialogs / Alerts) -->
    <DropShadowEffect x:Key="Shadow.Modal" x:Shared="False" Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0" />

    <DropShadowEffect x:Key="Shadow4" x:Shared="False" Color="Transparent" BlurRadius="0" ShadowDepth="0" Opacity="0" />

    <!-- Level 5: Brand Glow (Focus States / Accents) -->
    <DropShadowEffect x:Key="ShadowGlow" x:Shared="False" Color="Transparent" Opacity="0" />

    <!-- Inner Shadow Placeholder -->
    <DropShadowEffect x:Key="Shadow.Inner" Color="Transparent" Opacity="0" />

</ResourceDictionary>
