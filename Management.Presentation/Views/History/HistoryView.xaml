<UserControl x:Class="Management.Presentation.Views.History.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:Management.Presentation.Converters"
             xmlns:local="clr-namespace:Management.Presentation.Views.History"
             xmlns:vm="clr-namespace:Management.Presentation.ViewModels.History"
             xmlns:premium="clr-namespace:Management.Presentation.Controls.Premium"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="1080" d:DesignWidth="1440"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Shared converters used from App.xaml -->

        <!-- 
            POLYMORPHIC TEMPLATES (Section 28.6)
            Maps ViewModel types to their specific "Card" visual components.
        -->
        <DataTemplate DataType="{x:Type vm:AccessEventItemViewModel}">
            <local:AccessEventList />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PaymentEventItemViewModel}">
            <local:PaymentHistoryList />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ReservationEventItemViewModel}">
            <local:ReservationHistoryList />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SaleEventItemViewModel}">
            <local:SaleHistoryList />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AppointmentEventItemViewModel}">
            <local:AppointmentHistoryList />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PayrollEventItemViewModel}">
            <local:PayrollHistoryList />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:InventoryEventItemViewModel}">
            <local:InventoryHistoryList />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Focusable="True" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Filter / Selection Bar -->
            <RowDefinition Height="*"/>
            <!-- Content -->
        </Grid.RowDefinitions>

        <!-- 1. Header & Primary Actions -->
        <Grid Grid.Row="0" Margin="{DynamicResource MarginSectionBottom}">
            
            
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="{StaticResource IconHistory}" 
                      Style="{StaticResource Style.Icon.Large}" 
                      Stroke="{DynamicResource TextPrimaryBrush}"
                      Margin="0,0,12,0"
                      VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Terminology.History.Header}" 
                           Style="{StaticResource Title1}" 
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 2. Controls Area (Row 1) -->
        <Grid Grid.Row="1" Margin="{DynamicResource MarginSectionBottom}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Date Controls -->
                <ColumnDefinition Width="*"/>    <!-- Filters -->
                <ColumnDefinition Width="Auto"/> <!-- Actions -->
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12" 
                    Padding="4"
                    Height="44"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <!-- Previous Day -->
                    <Button Style="{DynamicResource Button.Ghost}"
                            Command="{Binding PreviousDayCommand}"
                            Width="44" Height="36" Padding="0"
                            VerticalAlignment="Center">
                        <Path Data="M15 18l-6-6 6-6" 
                              Stroke="{DynamicResource TextPrimaryBrush}" 
                              StrokeThickness="2" 
                              Width="10" Height="14" 
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Button>

                    <!-- Selected Date Display & Quick Jump -->
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Text="{Binding SelectedDay, Converter={StaticResource StringFormatConverter}, ConverterParameter='Terminology.Format.Date.Medium'}" 
                                   FontWeight="SemiBold" 
                                   FontSize="15" 
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        
                        <!-- Hidden DatePicker mapped to Icon -->
                        <Grid Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <DatePicker SelectedDate="{Binding SelectedDay, Mode=TwoWay}" 
                                        Width="28" Height="28" 
                                        Opacity="0"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"/>
                            <Path Data="M19 4h-1V3c0-.55-.45-1-1-1s-1 .45-1 1v1H9V3c0-.55-.45-1-1-1s-1 .45-1 1v1H6c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h13c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H6V9h13v11zm0-13H6V6h13v1z" 
                                  Fill="{DynamicResource TextSecondaryBrush}" 
                                  Width="18" Height="18" 
                                  IsHitTestVisible="False"
                                  Stretch="Uniform"/>
                        </Grid>
                    </Grid>

                    <!-- Next Day -->
                    <Button Style="{DynamicResource Button.Ghost}"
                            Command="{Binding NextDayCommand}"
                            Width="44" Height="36" Padding="0"
                            VerticalAlignment="Center">
                        <Path Data="M9 18l6-6-6-6" 
                              Stroke="{DynamicResource TextPrimaryBrush}" 
                              StrokeThickness="2" 
                              Width="10" Height="14" 
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Apple Style Segmented Filters -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                
                <!-- Status Filter Group Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12" 
                        Padding="4"
                        Height="44"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Content="All" 
                                     IsChecked="{Binding SelectedFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=All}"
                                     Style="{StaticResource AppleFilterRadioButtonStyle}"/>
                        <RadioButton Content="Active" 
                                     IsChecked="{Binding SelectedFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Active}"
                                     Style="{StaticResource AppleFilterRadioButtonStyle}"/>
                        <RadioButton Content="Undone" 
                                     IsChecked="{Binding SelectedFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Undone}"
                                     Style="{StaticResource AppleFilterRadioButtonStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Search — fixed width, focus highlight handled inside PremiumSearchBox -->
                <premium:PremiumSearchBox
                    Margin="12,0,0,0"
                    Width="300"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    Placeholder="{DynamicResource Terminology.History.SearchPlaceholder}"
                    IconData="{StaticResource Icon.Search}"
                    Height="44"
                    VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0,0,0">
                <!-- Print Action -->
                <Button Style="{StaticResource Button.Secondary}" Command="{Binding PrintReportCommand}" Margin="0,0,12,0" Height="44" Padding="16,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="{DynamicResource Corner.LG}" 
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <StackPanel x:Name="ContentStack" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconPrinter}" 
                                              Fill="{TemplateBinding Foreground}"
                                              Style="{StaticResource Style.Icon.Small}"
                                              Margin="{StaticResource MarginIconRight}"/>
                                        <TextBlock Text="{DynamicResource Terminology.History.Action.Print}" 
                                                   Foreground="{TemplateBinding Foreground}" 
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <premium:AtriumMarkAnimation x:Name="BusyAnim" AnimationMode="Scan" MarkForeground="{TemplateBinding Foreground}" 
                                                                 Width="18" Height="18" Visibility="Collapsed" 
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsPrinting}" Value="True">
                                    <Setter TargetName="ContentStack" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="BusyAnim" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Export Action -->
                <Button Style="{StaticResource Button.Primary}" Command="{Binding ExportCommand}" Height="44" Padding="16,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" 
                                    Background="{TemplateBinding Background}" 
                                    CornerRadius="{DynamicResource Corner.LG}" 
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <StackPanel x:Name="ContentStack" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" 
                                              Stroke="{TemplateBinding Foreground}"
                                              Style="{StaticResource Style.Icon.Small}"
                                              Margin="{StaticResource MarginIconRight}"/>
                                        <TextBlock Text="{DynamicResource Terminology.History.Action.Export}" 
                                                   Foreground="{TemplateBinding Foreground}" 
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <premium:AtriumMarkAnimation x:Name="BusyAnim" AnimationMode="Scan" MarkForeground="{TemplateBinding Foreground}" 
                                                                 Width="18" Height="18" Visibility="Collapsed" 
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource FacilityAccentBrush.Deep}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsExporting}" Value="True">
                                    <Setter TargetName="ContentStack" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="BusyAnim" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 3. Content Area (Row 2): Liquid Layout -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/> <!-- List Column -->
                <ColumnDefinition Width="Auto"/> <!-- Drawer Column -->
            </Grid.ColumnDefinitions>

            <!-- Empty State -->
            <Grid Grid.Column="0"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"
                  Visibility="{Binding HistoryEventsView.Count, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=Inverse}">

                <Ellipse Width="240" Height="240" Fill="{DynamicResource FacilityAccentBrush}" Opacity="0.03" Margin="0,-40,0,0"/>

                <StackPanel HorizontalAlignment="Center">
                    <Border Width="80" Height="80"
                            Background="{DynamicResource FacilityAccentDimBrush}"
                            CornerRadius="40"
                            Margin="0,0,0,24">
                        <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                              Fill="{DynamicResource FacilityAccentBrush}"
                              Width="36" Height="36"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="{DynamicResource Terminology.History.EmptyStateText}"
                               FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="{DynamicResource Terminology.History.EmptyState.Description}"
                               FontSize="16"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,32"
                               TextAlignment="Center"
                               MaxWidth="320"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <!-- A. Timeline List (Grouped) -->
            <ListBox Grid.Column="0"
                     x:Name="HistoryListBox"
                     ItemsSource="{Binding HistoryEventsView}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0,0,12,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                     SelectedItem="{Binding SelectedEvent, Mode=TwoWay}">

                <ListBox.ItemContainerStyle>
                     <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRingStyle}"/>
                        <Setter Property="Margin" Value="0"/> <!-- Handled by the Card margin -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <!-- Group Headers (Date Labels) - Reskinned -->
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" 
                                           Style="{DynamicResource Title3}" 
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Margin="0,24,0,8"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
            </ListBox>

            <premium:ScrollIndicatorButton 
                TargetScrollViewer="{Binding ElementName=HistoryListBox}"
                Grid.Column="0"
                HorizontalAlignment="Center" 
                VerticalAlignment="Bottom"
                Margin="0,0,0,24"/>

            <!-- B. Detail Drawer (Slide-in) -->
            <Border Grid.Column="1" 
                    Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource MultiplyValueConverter}, ConverterParameter=0.45}" 
                    MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource CardBackgroundBrush}" 
                    CornerRadius="32"
                    Margin="16,0,16,16"
                    Effect="{DynamicResource Shadow3}"
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1"
                    Visibility="{Binding DataContext.IsDetailOpen, RelativeSource={RelativeSource AncestorType=local:HistoryView}, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border.RenderTransform>
                    <TranslateTransform X="800"/>
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsDetailOpen, RelativeSource={RelativeSource AncestorType=local:HistoryView}}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="800" To="0" Duration="0:0:0.4">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                
                <local:HistoryDetailView DataContext="{Binding SelectedEvent}"/>
            </Border>
        </Grid>

    </Grid>
</UserControl>
