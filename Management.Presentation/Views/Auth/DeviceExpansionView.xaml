<UserControl x:Class="Management.Presentation.Views.Auth.DeviceExpansionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Management.Presentation.Views.Auth"
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="460"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="LicenseInputBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="40"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <StackPanel VerticalAlignment="Top" Margin="36,24,36,32">

            <!-- ROW 1 — ATRIUM BRAND LOGO -->
            <Grid Margin="0,0,0,4">
                <Image Source="/Assets/atrium_header_logo.png"
                       Height="84"
                       HorizontalAlignment="Left"
                       Margin="-20,0,0,0"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Stretch="Uniform"/>
            </Grid>

            <!-- ROW 2 — TITLE & SUBTITLE -->
            <TextBlock Text="Workspace Expansion"
                       FontSize="26" FontWeight="ExtraBold"
                       Foreground="#0F172A"
                       Margin="0,0,0,4"
                       FontFamily="Segoe UI Variable Display, Segoe UI"/>

            <TextBlock Text="This license is already registered. Choose how you want to configure this device."
                       FontSize="12" Foreground="#64748B"
                       TextWrapping="Wrap" LineHeight="17"
                       Margin="0,0,0,14"
                       FontFamily="Segoe UI Variable Display, Segoe UI"/>

            <!-- ROW 3 — ACTIVE LICENSE SUMMARY -->
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                    CornerRadius="10" Padding="12,10" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding BusinessName}" FontSize="13" FontWeight="Bold" Foreground="#1E293B"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"/>
                        <TextBlock Text="{Binding CurrentCategory}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#EEF2FF" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BranchQuotaDisplay}" FontSize="10" FontWeight="Bold" Foreground="#4F46E5"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════
                 OPTION 1 — OPEN NEW BRANCH
                 ══════════════════════════════════════════ -->
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="10" Padding="12" Margin="0,0,0,10"
                    Visibility="{Binding CanOpenNewBranch, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6" Background="#EFF6FF" VerticalAlignment="Center">
                            <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Fill="#2563EB" Width="14" Height="14" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Open New Branch Location" FontSize="12" FontWeight="Bold" Foreground="#1E293B"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"/>
                            <TextBlock Text="Deploy a new site under your allocated branch quota." FontSize="10" Foreground="#64748B"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource LicenseInputBorderStyle}" Margin="0,0,8,0">
                            <TextBox Text="{Binding NewBranchName, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Foreground="#111827" FontSize="12"
                                     VerticalContentAlignment="Center" Margin="8,0" Tag="e.g. Downtown Site #2"/>
                        </Border>
                        <Button Grid.Column="1" Command="{Binding OpenNewBranchCommand}"
                                Background="{DynamicResource FacilityAccentBrush}" Height="40" Padding="14,0" Cursor="Hand" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <TextBlock Text="Create Branch" Foreground="White" FontSize="11" FontWeight="Bold"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════
                 OPTION 2 — JOIN AS TERMINAL
                 ══════════════════════════════════════════ -->
            <Button Command="{Binding JoinBranchAsTerminalCommand}"
                    Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,10" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="10" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6" Background="#F0FDF4" VerticalAlignment="Center">
                                    <Path Data="M4,6H20V16H4M20,18A2,2 0 0,0 22,16V6C22,4.89 21.1,4 20,4H4C2.89,4 2,4.89 2,6V16A2,2 0 0,0 4,18H0V20H24V18H20Z"
                                          Fill="#16A34A" Width="14" Height="14" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Enroll as Cashier / Workstation Terminal" FontSize="12" FontWeight="Bold" Foreground="#1E293B"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"/>
                                    <TextBlock Text="Link this PC directly to your existing branch for staff or registers." FontSize="10" Foreground="#64748B"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- ══════════════════════════════════════════
                 OPTION 3 — ADD NEW CATEGORY (UPGRADE NOTICE)
                 ══════════════════════════════════════════ -->
            <Button Command="{Binding RequestCategoryUpgradeCommand}"
                    Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,10" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1.5" CornerRadius="10" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6" Background="#FEF3C7" VerticalAlignment="Center">
                                    <Path Data="M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z"
                                          Fill="#D97706" Width="14" Height="14" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Add New Business Category" FontSize="12" FontWeight="Bold" Foreground="#92400E"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"/>
                                    <TextBlock Text="Requires Multi-Category Enterprise License upgrade." FontSize="10" Foreground="#B45309"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"/>
                                </StackPanel>
                                <Border Grid.Column="2" Background="#FDE68A" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="UPGRADE" FontSize="9" FontWeight="Bold" Foreground="#78350F"/>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- ══════════════════════════════════════════
                 OPTION 4 — BRANCH LIMIT REACHED
                 ══════════════════════════════════════════ -->
            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1.5" CornerRadius="10" Padding="12" Margin="0,0,0,10"
                    Visibility="{Binding IsBranchLimitReached, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Branch Quota Exhausted" FontSize="12" FontWeight="Bold" Foreground="#991B1B"/>
                        <TextBlock Text="All allocated branch slots have been provisioned on other machines." FontSize="10" Foreground="#B91C1C"/>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding RequestBranchUpgradeCommand}"
                            Background="#DC2626" Height="32" Padding="10,0" Cursor="Hand" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <TextBlock Text="Upgrade Quota" Foreground="White" FontSize="10" FontWeight="Bold"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ROW 4 — CANCEL BUTTON -->
            <Button Command="{Binding CancelCommand}"
                    Background="Transparent" BorderThickness="0" Margin="0,6,0,0" Cursor="Hand" HorizontalAlignment="Center">
                <TextBlock Text="Back to Sign In" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"
                           FontFamily="Segoe UI Variable Display, Segoe UI"/>
            </Button>

        </StackPanel>
    </Grid>
</UserControl>
