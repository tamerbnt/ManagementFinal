<UserControl x:Class="Management.Presentation.Controls.Premium.PremiumSearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Height="44">
    <Border Background="#F9FAFB" CornerRadius="22" BorderThickness="1" BorderBrush="#E5E7EB">
        <Grid Margin="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search Icon -->
            <Path Grid.Column="0" Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" 
                  Fill="#9CA3AF" Stretch="Uniform" Width="18" Height="18" VerticalAlignment="Center"/>

            <!-- Input Field -->
            <TextBox Grid.Column="1" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" 
                     Margin="12,0" FontSize="14" Foreground="#111827" CaretBrush="{DynamicResource Brush.Brand.Primary}"/>

            <!-- Clear (X) Button (Normally collapsed until text is typed) -->
            <Button Grid.Column="2" Width="20" Height="20" Background="#E5E7EB" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" 
                                  Fill="#6B7280" Stretch="Uniform" Margin="5"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</UserControl>
