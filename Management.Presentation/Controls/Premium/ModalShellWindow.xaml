<Window x:Class="Management.Presentation.Controls.Premium.ModalShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="{Binding Title}" 
        SizeToContent="WidthAndHeight"
        MinWidth="400"
        FlowDirection="{DynamicResource GlobalFlowDirection}"
        WindowStyle="None" 
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- Scale Converter to bind MaxHeight to MainWindow height * 0.9 -->
        <ScaleTransform x:Key="ScaleDownTransform" ScaleX="0.9" ScaleY="0.9"/>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                          GlassFrameThickness="-1"
                          CornerRadius="24"
                          ResizeBorderThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <!-- Essential structural backdrop / container -->
    <Grid Margin="16,16,16,32">
        <Border Background="{DynamicResource Brush.Surface.Card}"
                CornerRadius="24"
                Width="{Binding ModalWidth, FallbackValue=450}">
            <Border.Effect>
                <!-- Performance Optimized Drop Shadow -->
                <DropShadowEffect BlurRadius="30" ShadowDepth="10" 
                                  Opacity="0.15" Direction="270"
                                  Color="Black" RenderingBias="Performance"/>
            </Border.Effect>

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="*"/>    <!-- Scrollable Content -->
                    <RowDefinition Height="Auto"/> <!-- Footer -->
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" 
                               Text="{Binding Title, FallbackValue='Modal Title'}" 
                               Style="{DynamicResource Text.Title2}" 
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"/>
                    
                    <!-- Premium X Button -->
                    <Button Grid.Column="1" 
                            Command="{Binding CloseCommand}"
                            Width="36" Height="36"
                            Background="#F3F4F6"
                            BorderThickness="0"
                            Cursor="Hand"
                            VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                    <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" 
                                          Fill="#6B7280" Stretch="Uniform" Margin="10"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E5E7EB"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- SCROLLABLE CONTENT AREA -->
                <!-- MaxHeight logic prevents small screens from clipping the modal entirely -->
                <ScrollViewer Grid.Row="1" 
                              VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="500">
                    <ContentPresenter Content="{Binding InnerContent}" />
                </ScrollViewer>

                <!-- FOOTER -->
                <Grid Grid.Row="2" Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" 
                            Content="{DynamicResource Terminology.Global.Cancel}" 
                            Command="{Binding CancelCommand}"
                            Style="{DynamicResource SecondaryButton}"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#4B5563"/>
                    
                    <Button Grid.Column="1" 
                            Content="{Binding ConfirmButtonText, FallbackValue='Confirm'}" 
                            Command="{Binding ConfirmCommand}"
                            Style="{DynamicResource PrimaryButton}"
                            HorizontalAlignment="Right"
                            Padding="32,12"
                            Background="{DynamicResource Brush.Brand.Primary}"
                            Foreground="White">
                        <Button.Resources>
                            <!-- Force override the corner radius to 12 for the submit button -->
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="12"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
