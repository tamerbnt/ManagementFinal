<UserControl x:Class="Management.Presentation.Views.GymHome.WalkInConfirmationModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Management.Presentation.ViewModels.GymHome"
             xmlns:premium="clr-namespace:Management.Presentation.Controls.Premium"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:WalkInConfirmationViewModel}"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- Refined Premium Item Style -->
        <Style x:Key="WalkInPlanItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" 
                                CornerRadius="14" 
                                BorderThickness="1.5" 
                                BorderBrush="#E5E7EB"
                                Background="{DynamicResource Brush.Surface.Glass}"
                                Padding="16"
                                Margin="0,0,8,12"
                                Cursor="Hand">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <Border x:Name="IndicatorBorder"
                                        Grid.Column="0" 
                                        Width="20" Height="20" 
                                        CornerRadius="10" 
                                        BorderThickness="2" 
                                        BorderBrush="#D1D5DB"
                                        Margin="0,0,16,0"
                                        VerticalAlignment="Center">
                                    <Ellipse x:Name="CheckMark" 
                                             Width="8" Height="8" 
                                             Fill="{DynamicResource FacilityAccentBrush}"
                                             Visibility="Collapsed"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="NameText" Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                    <TextBlock x:Name="DurationText" Text="{Binding DurationDescription}" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <TextBlock x:Name="PriceText" 
                                           Grid.Column="2" 
                                           Text="{Binding Price, StringFormat='{}{0:N2} DA'}" 
                                           FontSize="15"
                                           FontWeight="ExtraBold" 
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource FacilityAccentBrush}"/>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F0FDFA"/> <!-- Very light primary tint -->
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="IndicatorBorder" Property="BorderBrush" Value="{DynamicResource FacilityAccentBrush}"/>
                                <Setter TargetName="PriceText" Property="Foreground" Value="{DynamicResource FacilityAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource FacilityAccentBrush}"/>
                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Premium Stepper Button Style -->
        <Style x:Key="StepperButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <premium:ModalShellControl Title="{Binding Title}"
                               Width="820"
                               CancelCommand="{Binding CancelWalkInCommand}"
                               RegisterCommand="{Binding ConfirmWalkInCommand}"
                               PrimaryActionText="{DynamicResource Terminology.GymHome.WalkIn.Action.Confirm}">
        
        <premium:ModalShellControl.ExtraFooterContent>
            <Button Command="{Binding OpenRegisterWalkInCommand}" 
                    Style="{DynamicResource Button.Pill.Outline}" 
                    Content="{DynamicResource Terminology.Gym.Action.RegisterWalkIn}"
                    Margin="0,0,8,0"/>
        </premium:ModalShellControl.ExtraFooterContent>

        <Grid Height="480" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Column 0: Plan List -->
            <ListBox Grid.Column="0"
                     ItemsSource="{Binding Plans}" 
                     SelectedItem="{Binding SelectedPlan}"
                     ItemContainerStyle="{StaticResource WalkInPlanItemStyle}"
                     Style="{StaticResource PremiumListBox}"
                     BorderThickness="0"/>

            <!-- Column 1: Configuration -->
            <StackPanel Grid.Column="2">
                <!-- Quantity Card -->
                <Border Background="{DynamicResource Brush.Surface.Card}" 
                        CornerRadius="16" 
                        Padding="24"
                        Margin="0,0,0,24"
                        BorderBrush="#F3F4F6"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Terminology.GymHome.WalkIn.Quantity}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"/>
                        <TextBlock Text="Select group size" FontSize="11" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,0,20"/>
                        
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Button Grid.Column="0" Command="{Binding DecrementGuestCountCommand}" Style="{StaticResource StepperButtonStyle}">
                                <Path Data="M19,13H5V11H19V13Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Margin="10"/>
                            </Button>

                            <TextBlock Grid.Column="1" Text="{Binding GuestCount}" TextAlignment="Center" VerticalAlignment="Center" FontSize="28" FontWeight="ExtraBold" Foreground="{DynamicResource FacilityAccentBrush}"/>

                            <Button Grid.Column="2" Command="{Binding IncrementGuestCountCommand}" Style="{StaticResource StepperButtonStyle}">
                                <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Margin="10"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Summary Card -->
                <Border Background="{DynamicResource Brush.Surface.Glass}" 
                        CornerRadius="16" 
                        Padding="24"
                        BorderBrush="#F3F4F6"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Summary" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,0,16"/>
                        
                        <!-- Stacked Price Layout to prevent overlap -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Total Price" FontSize="13" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            <TextBlock Text="{Binding TotalPrice, StringFormat='{}{0:N2} DA'}" 
                                       FontSize="28" 
                                       FontWeight="ExtraBold" 
                                       Foreground="{DynamicResource FacilityAccentBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        
                        <Border Height="1" Background="#F3F4F6" Margin="0,0,0,20"/>
                        <TextBlock Text="Ready to process guest entry." FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </premium:ModalShellControl>
</UserControl>
