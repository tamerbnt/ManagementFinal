<UserControl x:Class="Management.Presentation.Views.GymHome.WalkInConfirmationModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Management.Presentation.ViewModels.GymHome"
             xmlns:premium="clr-namespace:Management.Presentation.Controls.Premium"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:WalkInConfirmationViewModel}"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- Selection Highlight Style -->
        <Style x:Key="SelectionItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" 
                                CornerRadius="12" 
                                BorderThickness="1.5" 
                                BorderBrush="{DynamicResource SeparatorStroke}"
                                Background="{DynamicResource Brush.Surface.Glass}"
                                Padding="12"
                                Margin="0,0,0,8"
                                Cursor="Hand">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource FacilityAccentBrush}"/>
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource FacilityAccentDimBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource FacilityAccentBrush}"/>
                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Premium Stepper Button Style -->
        <Style x:Key="StepperButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBgDim}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceAccentBg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <premium:ModalShellControl Title="{Binding Title}"
                               Width="900" MaxWidth="900"
                               CancelCommand="{Binding CancelWalkInCommand}"
                               SaveCommand="{Binding ConfirmWalkInCommand}"
                               PrimaryActionText="{DynamicResource Terminology.GymHome.WalkIn.Action.Confirm}">
        
        <premium:ModalShellControl.ExtraFooterContent>
            <Button Command="{Binding OpenRegisterWalkInCommand}" 
                    Style="{DynamicResource Button.Pill.Outline}" 
                    Content="{DynamicResource Terminology.Gym.Action.RegisterWalkIn}"
                    HorizontalAlignment="Stretch"/>
        </premium:ModalShellControl.ExtraFooterContent>

        <Grid Height="500" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Column 0: Plan List -->
            <Grid Grid.Column="0">
                <ListBox ItemsSource="{Binding Plans}" 
                         SelectedItem="{Binding SelectedPlan}"
                         ItemContainerStyle="{StaticResource SelectionItemStyle}"
                         Style="{StaticResource PremiumListBox}"
                         BorderThickness="0"
                         Height="400"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                    <TextBlock Text="{Binding DurationDescription}" FontSize="11" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Price, StringFormat='{}{0:N2} DA'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                         
                <premium:ScrollIndicatorButton 
                     HorizontalAlignment="Center" 
                     VerticalAlignment="Bottom"
                     Margin="0,0,0,24"/>
            </Grid>

            <!-- Column 1: Configuration -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Height="400" Background="Transparent">
                <StackPanel>
                <!-- Quantity Card -->
                <Border Background="{DynamicResource Brush.Surface.Card}" 
                        CornerRadius="16" 
                        Padding="24"
                        Margin="0,0,0,24"
                        BorderBrush="{DynamicResource SeparatorStroke}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Terminology.GymHome.WalkIn.Quantity}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"/>
                        <TextBlock Text="{DynamicResource Terminology.GymHome.WalkIn.GroupSize}" FontSize="11" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,0,20"/>
                        
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Button Grid.Column="0" Command="{Binding DecrementGuestCountCommand}" Style="{StaticResource StepperButtonStyle}">
                                <Path Data="M19,13H5V11H19V13Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Margin="10"/>
                            </Button>

                            <TextBlock Grid.Column="1" Text="{Binding GuestCount}" TextAlignment="Center" VerticalAlignment="Center" FontSize="28" FontWeight="ExtraBold" Foreground="{DynamicResource FacilityAccentBrush}"/>

                            <Button Grid.Column="2" Command="{Binding IncrementGuestCountCommand}" Style="{StaticResource StepperButtonStyle}">
                                <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Margin="10"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Discount Card -->
                <Border Background="{DynamicResource Brush.Surface.Card}" 
                        CornerRadius="16" 
                        Padding="24"
                        Margin="0,0,0,24"
                        BorderBrush="{DynamicResource SeparatorStroke}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource TerminologyManualDiscountLabel}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"/>
                        <TextBlock Text="{DynamicResource Terminology.Settings.Discounts.Select}" FontSize="11" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,0,16"/>
                        
                        <ComboBox ItemsSource="{Binding AvailableDiscounts}"
                                  SelectedItem="{Binding SelectedDiscount}"
                                  Style="{DynamicResource Input.ComboBox}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Padding" Value="12,8"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                        
                        <!-- Show discount details if selected -->
                        <TextBlock Margin="0,12,0,0" 
                                   FontSize="12" 
                                   Foreground="{DynamicResource FacilityAccentBrush}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDiscount, Converter={StaticResource NullToVisibilityConverter}}" Value="Visible">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedDiscount.Type}" Value="0">
                                            <Setter Property="Text" Value="{Binding SelectedDiscount.Percentage, StringFormat='- {0}%'}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedDiscount.Type}" Value="1">
                                            <Setter Property="Text" Value="{Binding SelectedDiscount.FixedAmount, StringFormat='- {0:N2} DA'}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Summary Card -->
                <Border Background="{DynamicResource Brush.Surface.Glass}" 
                        CornerRadius="16" 
                        Padding="24"
                        BorderBrush="{DynamicResource SeparatorStroke}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Terminology.Global.Summary}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,16"/>
                        
                        <!-- Stacked Price Layout to prevent overlap -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="{DynamicResource Terminology.Global.TotalPrice}" FontSize="13" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            <TextBlock Text="{Binding TotalPrice, StringFormat='{}{0:N2} DA'}" 
                                       FontSize="28" 
                                       FontWeight="ExtraBold" 
                                       Foreground="{DynamicResource FacilityAccentBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        
                        <!-- Discount Row (Optional) -->
                        <Grid Margin="0,0,0,12" Visibility="{Binding SelectedDiscount, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="{DynamicResource TerminologyManualDiscountLabel}" FontSize="13" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            <TextBlock Text="{Binding PricingResult.ManualDiscountAmount, StringFormat='- {0:N2} DA'}" 
                                       FontSize="13" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource FacilityAccentBrush}"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource SeparatorStroke}" Margin="0,0,0,20"/>
                        <TextBlock Text="{DynamicResource Terminology.GymHome.WalkIn.Ready}" FontSize="12" Foreground="{DynamicResource Brush.Text.Primary}" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </premium:ModalShellControl>
</UserControl>
