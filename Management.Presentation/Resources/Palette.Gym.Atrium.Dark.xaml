<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- GYM — "Atrium" Palette (Brand) — DARK MODE OVERRIDE -->
    <!-- Accent colors only — dark surfaces remain from Theme.Dark.xaml -->

    <!-- ── Terracotta Accent — Terracotta.Mid #C4785A ─────────── -->
    <Color  x:Key="FacilityAccentColor">       #C4785A</Color>
    <Color  x:Key="FacilityAccentShadowColor"> #8C3D28</Color>
    <SolidColorBrush x:Key="FacilityAccentBrush"    Color="#C4785A"/>
    <SolidColorBrush x:Key="FacilityAccentDimBrush" Color="#C4785A" Opacity="0.15"/>
    <SolidColorBrush x:Key="AccentBrush"            Color="#C4785A"/>
    <Color  x:Key="AccentColor">               #C4785A</Color>
    <Color  x:Key="AccentLightColor">          #F5E8E4</Color>
    <SolidColorBrush x:Key="Brush.Brand.Primary"    Color="#C4785A"/>
    <SolidColorBrush x:Key="BrandPrimaryBrush"      Color="#C4785A"/>

    <LinearGradientBrush x:Key="FacilityAccentGradient" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#8C3D28" Offset="0"/>
        <GradientStop Color="#C4785A" Offset="1"/>
    </LinearGradientBrush>

    <!-- ── On-Accent Row Contrast Tokens ──────────────────────── -->
    <SolidColorBrush x:Key="RowOnAccentPrimary"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RowOnAccentSecondary"  Color="#F5E8E4"/>

</ResourceDictionary>
