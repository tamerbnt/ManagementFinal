<UserControl x:Class="Management.Presentation.Controls.Premium.ThemeSegmentedToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Height="32" Width="60">
    
    <UserControl.Resources>
        <Style x:Key="SegmentedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#01FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" IsHitTestVisible="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceBgDim}" CornerRadius="16" Padding="2">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Selection pill (Animation target) -->
            <Border x:Name="SelectionPill" 
                    Grid.Column="0" 
                    Background="{DynamicResource SurfaceBg}" 
                    CornerRadius="14"
                    HorizontalAlignment="Left"
                    BorderThickness="1"
                    IsHitTestVisible="False">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="PillTranslate" X="0"/>
                </Border.RenderTransform>
                <Border.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource BorderBrush.Color}"/>
                </Border.BorderBrush>
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="2" Opacity="0.1" Direction="270" Color="Black"/>
                </Border.Effect>
            </Border>

            <!-- Light Mode Segment (Sun) -->
            <Button Grid.Column="0" 
                    Click="LightButton_Click"
                    Style="{StaticResource SegmentedButtonStyle}"
                    Cursor="Hand">
                <Path x:Name="SunIcon" Data="{DynamicResource IconSun}" Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.5" Fill="Transparent" Stretch="Uniform" Width="14" Height="14"/>
            </Button>
            
            <!-- Dark Mode Segment (Moon) -->
            <Button Grid.Column="1" 
                    Click="DarkButton_Click"
                    Style="{StaticResource SegmentedButtonStyle}"
                    Cursor="Hand">
                <Path x:Name="MoonIcon" Data="{DynamicResource IconMoon}" Fill="{DynamicResource TextTertiaryBrush}" Stretch="Uniform" Width="14" Height="14"/>
            </Button>
        </Grid>
    </Border>
</UserControl>
