<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 
        GLOBAL BRUSH PRIMITIVES
        Fixed: Reverted DynamicResource-on-Key aliases which caused ResourceReferenceExpression errors.
        Brushes now correctly use terminal Color resources with DynamicResource Color mapping.
    -->

    <SolidColorBrush x:Key="Brush.Neutral.White" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Neutral.OffWhite" Color="#F8F9FA" />
    
    <!-- Semantic Aliases for Cross-Component Compatibility -->
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF"/> <!-- Global compatibility alias -->
    
    <!-- Stable Aliases for Legacy Components -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimary.Color}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondary.Color}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{DynamicResource TextTertiary.Color}"/>

    <SolidColorBrush x:Key="TextPrimary" Color="{DynamicResource TextPrimary.Color}"/>
    <SolidColorBrush x:Key="TextSecondary" Color="{DynamicResource TextSecondary.Color}"/>
    
    <SolidColorBrush x:Key="SeparatorStroke" Color="{DynamicResource Color.Border.Subtle}"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="{DynamicResource Color.Border.Subtle}"/>
    
    <!-- Semantic surfaces are now managed directly in Theme.Light.xaml / Theme.Dark.xaml to ensure reliable object-level swapping -->

</ResourceDictionary>
