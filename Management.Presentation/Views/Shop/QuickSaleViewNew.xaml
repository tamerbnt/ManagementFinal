<UserControl x:Class="Management.Presentation.Views.Shop.QuickSaleViewNew"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Management.Presentation.ViewModels.Shop"
             xmlns:converters="clr-namespace:Management.Presentation.Converters"
             xmlns:premium="clr-namespace:Management.Presentation.Controls.Premium"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:QuickSaleViewModel, IsDesignTimeCreatable=True}"
             Background="Transparent">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:CountToBooleanConverter x:Key="CountToBooleanConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="InverseNullToVisibilityConverter" Inverted="True"/>
        
        <!-- Icon Aliases -->
        <StreamGeometry x:Key="IconMember">M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 7a4 4 0 1 0 0-8 4 4 0 0 0 0 8M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75</StreamGeometry>
        <StreamGeometry x:Key="IconSearch">M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16zM21 21l-4.35-4.35</StreamGeometry>
        <StreamGeometry x:Key="IconClose">M18 6L6 18M6 6l12 12</StreamGeometry>
        <StreamGeometry x:Key="IconPinFilled">M12 17v5M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A.5.5 0 0 0 6 13.9V15a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-1.1a.5.5 0 0 0-.11-.31l-1.78-.9A2 2 0 0 1 15 10.76V6a1 1 0 0 1 1-1h1a1 1 0 0 0 0-2H7a1 1 0 0 0 0 2h1a1 1 0 0 1 1 1z</StreamGeometry>
        
        <Style x:Key="SelectionItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="OuterBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource SeparatorStroke}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16,12"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource FacilityAccentDimBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource FacilityAccentDimBrush}"/>
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource FacilityAccentBrush}"/>
                                <Setter TargetName="OuterBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <premium:ModalShellControl Title="{DynamicResource Terminology.Modal.QuickSale.Title}" 
                             Subtitle="{DynamicResource Terminology.Modal.QuickSale.Subtitle}"
                             Width="900" MaxWidth="900"
                             CancelCommand="{Binding CancelCommand}"
                             SaveCommand="{Binding ProcessSaleCommand}"
                             PrimaryActionText="{DynamicResource Terminology.Modal.QuickSale.CompleteSale}">
        <Grid Margin="24,0" Height="500">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="65*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="35*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: PRODUCT SELECTION -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <premium:PremiumSearchBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Placeholder="{DynamicResource Terminology.Modal.QuickSale.SearchPlaceholder}"
                                         IconData="{StaticResource IconSearch}"
                                         Margin="0,0,0,16"/>

                <ListBox Grid.Row="1" 
                         ItemsSource="{Binding Products}" 
                         SelectedItem="{Binding SelectedProduct}"
                         ItemContainerStyle="{StaticResource SelectionItemStyle}"
                         Style="{StaticResource PremiumListBox}"
                         Background="Transparent"
                         Height="400"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconPinFilled}" Fill="{DynamicResource FacilityAccentBrush}" 
                                              Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center" Stretch="Uniform"
                                              Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Price, StringFormat='{}{0:N2} DA'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource FacilityAccentBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <premium:ScrollIndicatorButton 
                     Grid.Row="1"
                     HorizontalAlignment="Center" 
                     VerticalAlignment="Bottom"
                     Margin="0,0,0,24"/>

                <!-- Loading Overlay -->
                <Border Grid.Row="1" Background="{DynamicResource Brush.Surface.Card}" 
                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Opacity="0.7">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="100" Height="2" Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource Terminology.Modal.QuickSale.LoadingProducts}" FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- RIGHT COLUMN: MEMBER & CHECKOUT -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Height="400" Background="Transparent">
                <StackPanel>
                    <!-- 1. MEMBER SELECTION -->
                    <Border Background="{DynamicResource Brush.Surface.Card}" CornerRadius="16" Padding="20" Margin="0,0,0,16" BorderBrush="#F3F4F6" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Terminology.Modal.QuickSale.CustomerLinking}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,0,12"/>
                            
                            <!-- Search & Suggestion Control -->
                            <Grid Visibility="{Binding SelectedMember, Converter={StaticResource InverseNullToVisibilityConverter}}">
                                <premium:PremiumSearchBox 
                                                         Text="{Binding MemberSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                         Placeholder="Search member..."
                                                         IconData="{StaticResource IconUsers}"
                                                         Margin="0,0,0,12"/>
                                 <Popup IsOpen="{Binding IsPopupOpen, Mode=OneWay}" 
                                        PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Grid}}" 
                                        Placement="Bottom" 
                                        StaysOpen="False"
                                        AllowsTransparency="True">
                                     <Border Background="{DynamicResource SurfaceBg}" 
                                             BorderBrush="{DynamicResource SeparatorStroke}" 
                                             BorderThickness="1" 
                                             CornerRadius="12" 
                                             Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}" 
                                             MinWidth="260"
                                             MaxHeight="350">
                                         <Border.Effect>
                                             <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.1" Color="Black"/>
                                         </Border.Effect>
                                         <Grid>
                                             <Grid.RowDefinitions>
                                                 <RowDefinition Height="Auto"/>
                                                 <RowDefinition Height="*"/>
                                             </Grid.RowDefinitions>

                                             <!-- Loading State -->
                                             <Grid Grid.Row="0" Margin="12" Visibility="{Binding IsMemberSearching, Converter={StaticResource BoolToVis}}">
                                                 <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                     <premium:AtriumMarkAnimation Width="20" Height="20" AnimationMode="Scan" MarkForeground="{DynamicResource FacilityAccentBrush}"/>
                                                     <TextBlock Text="Searching members..." Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                                                 </StackPanel>
                                             </Grid>

                                             <ListBox Grid.Row="1" ItemsSource="{Binding SearchedMembers}" 
                                                      Style="{StaticResource ListBox.SearchPopup}"
                                                      ItemTemplate="{StaticResource MemberSearchResultTemplate}"/>
                                             
                                             <!-- No Results State -->
                                             <TextBlock Grid.Row="1" Text="No members found" 
                                                        HorizontalAlignment="Center" Margin="20" 
                                                        Foreground="{DynamicResource Brush.Text.Tertiary}">
                                                 <TextBlock.Style>
                                                     <Style TargetType="TextBlock">
                                                         <Setter Property="Visibility" Value="Collapsed"/>
                                                         <Style.Triggers>
                                                             <MultiDataTrigger>
                                                                 <MultiDataTrigger.Conditions>
                                                                     <Condition Binding="{Binding SearchedMembers.Count}" Value="0"/>
                                                                     <Condition Binding="{Binding IsMemberSearching}" Value="False"/>
                                                                     <Condition Binding="{Binding IsPopupOpen}" Value="True"/>
                                                                 </MultiDataTrigger.Conditions>
                                                                 <Setter Property="Visibility" Value="Visible"/>
                                                             </MultiDataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </TextBlock.Style>
                                             </TextBlock>
                                         </Grid>
                                     </Border>
                                 </Popup>
                            </Grid>

                            <!-- Selected Member Badge -->
                            <Border Background="{DynamicResource StatusInfoBackground}" CornerRadius="10" Padding="10,6" Visibility="{Binding SelectedMember, Converter={StaticResource NullToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                                        <Path Data="{StaticResource IconMembers}" Stroke="{DynamicResource FacilityAccentBrush}" StrokeThickness="1.5" Width="14" Height="14" Margin="0,0,8,0" Stretch="Uniform"/>
                                        <TextBlock Text="{Binding SelectedMember.FullName}" FontWeight="Bold" Foreground="{DynamicResource FacilityAccentBrush}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    
                                    <Button Grid.Column="1" Command="{Binding ClearSelectedMemberCommand}" Style="{DynamicResource Button.Ghost}" Width="24" Height="24" Padding="6" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource FacilityAccentBrush}" StrokeThickness="2" Stretch="Uniform"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                    <!-- 1.5. MANUAL DISCOUNT -->
                    <Border Background="{DynamicResource Brush.Surface.Card}" CornerRadius="16" Padding="20" Margin="0,0,0,16" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource TerminologyManualDiscountLabel}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,0,12"/>
                            
                            <ComboBox ItemsSource="{Binding AvailableDiscounts}"
                                      SelectedItem="{Binding SelectedDiscount}"
                                      Style="{DynamicResource Input.ComboBox}"
                                      HorizontalAlignment="Stretch"
                                      Height="42">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Padding" Value="12,8"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- 2. ACTIVE SALE SUMMARY -->
                    <Border Background="{DynamicResource Brush.Surface.Glass}" CornerRadius="16" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Terminology.Modal.QuickSale.ActiveSale}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,12"/>
                            
                            <Grid Visibility="{Binding SelectedProduct, Converter={StaticResource NullToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedProduct.Name}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                    
                                    <!-- Dynamic Price Row with Strikethrough & Badge -->
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <!-- Original Price (Strikethrough) -->
                                        <TextBlock Text="{Binding OriginalPrice, StringFormat='{}{0:N2} DA'}" 
                                                   FontSize="14" 
                                                   Foreground="{DynamicResource Brush.Text.Tertiary}" 
                                                   TextDecorations="Strikethrough"
                                                   VerticalAlignment="Bottom"
                                                   Margin="0,0,8,4"
                                                   Visibility="{Binding IsDiscounted, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        
                                        <!-- Effective Price -->
                                        <TextBlock Text="{Binding EffectivePrice, StringFormat='{}{0:N2} DA'}" 
                                                   FontSize="22" 
                                                   FontWeight="ExtraBold" 
                                                   Foreground="{DynamicResource FacilityAccentBrush}" 
                                                   VerticalAlignment="Bottom"/>
                                        
                                        <!-- Discount Badge -->
                                        <Border Background="{DynamicResource StatusSuccessBackground}" CornerRadius="12" Padding="8,2" Margin="10,0,0,4" VerticalAlignment="Bottom"
                                                Visibility="{Binding IsDiscounted, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding AppliedPromotionName}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource StatusSuccessBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Selection Feedback -->
                            <StackPanel Visibility="{Binding SelectedProduct, Converter={StaticResource InverseNullToVisibilityConverter}}" HorizontalAlignment="Center" Margin="0,20">
                                <TextBlock Text="{DynamicResource Terminology.Modal.QuickSale.SelectToContinue}" FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}" FontStyle="Italic"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </premium:ModalShellControl>
</UserControl>
