<UserControl x:Class="Management.Presentation.Controls.Premium.SegmentedToggleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Height="44">
    <!-- Premium iOS-style segmented control -->
    <Border Background="#F3F4F6" CornerRadius="12" Padding="4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- The animated selection pill (mocked statically for now, animates left/right via visual state) -->
            <Border x:Name="SelectionPill" Grid.Column="0" Background="#FFFFFF" CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.1" Direction="270" RenderingBias="Performance"/>
                </Border.Effect>
            </Border>

            <!-- Option 1 -->
            <Button Grid.Column="0" Content="Male" Background="Transparent" BorderThickness="0" 
                    FontWeight="SemiBold" Foreground="#111827" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
            
            <!-- Option 2 -->
            <Button Grid.Column="1" Content="Female" Background="Transparent" BorderThickness="0" 
                    FontWeight="SemiBold" Foreground="#6B7280" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
        </Grid>
    </Border>
</UserControl>
