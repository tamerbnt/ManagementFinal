<UserControl x:Class="Management.Presentation.Views.Auth.ActivationChoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Management.Presentation.Views.Auth"
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="460"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             Background="Transparent">

    <Grid>
        <StackPanel VerticalAlignment="Top" Margin="40,32,40,40">

            <!-- ROW 1 — ATRIUM BRAND LOGO -->
            <Grid Margin="0,8,0,8">
                <Image Source="/Assets/atrium_header_logo.png"
                       Height="110"
                       HorizontalAlignment="Left"
                       Margin="-25,0,0,0"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Stretch="Uniform"
                       ToolTip="Atrium Management System"/>
            </Grid>

            <!-- ROW 2 — TITLE -->
            <TextBlock Text="Initial Activation"
                       FontSize="32" FontWeight="ExtraBold"
                       Foreground="#0F172A"
                       Margin="0,0,0,8"
                       FontFamily="Segoe UI Variable Display, Segoe UI"/>

            <!-- ROW 3 — SUBTITLE -->
            <TextBlock Text="Choose how you want to get started with your workspace."
                       FontSize="13" Foreground="#6B7280"
                       TextWrapping="Wrap" LineHeight="20"
                       Margin="0,0,0,28"
                       FontFamily="Segoe UI Variable Display, Segoe UI"/>

            <!-- ══════════════════════════════════════════
                 OPTION 1 — 14-DAY FREE EVALUATION (TRIAL)
                 ══════════════════════════════════════════ -->
            <Button Command="{Binding StartTrialCommand}" IsEnabled="{Binding IsTrialAvailable}"
                    Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,12" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootItem" Background="#F8FAFC" CornerRadius="12" Padding="14" BorderThickness="1.5" BorderBrush="Transparent"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Rocket Icon -->
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <Path Data="M12,2.5L20.84,5.65L21,6.24L21.5,12L19.5,17L17.5,14.5V20L12,22.5L6.5,20V14.5L4.5,17L2.5,12L3,6.24L3.16,5.65L12,2.5M12,5.5L6.5,7.65L6,12L8.5,9V17.5L12,19.5L15.5,17.5V9L18,12L17.5,7.65L12,5.5Z"
                                          Fill="#10B981" Stretch="Uniform" Width="16" Height="16"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Start 14-Day Free Evaluation" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI"/>
                                        <!-- Instant Access Badge -->
                                        <Border Grid.Column="1" Background="#ECFDF5" CornerRadius="6" Padding="6,3" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding TrialBadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="#059669"
                                                       FontFamily="Segoe UI Variable Display, Segoe UI"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="Full access to all operating engines. No cash voucher required."
                                               FontSize="11" Foreground="#64748B" Margin="0,3,0,0" TextWrapping="Wrap"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="RootItem" Property="BorderBrush" Value="#E2E8F0"/>
                            </MultiDataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.97" Duration="0:0:0.05"/>
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.97" Duration="0:0:0.05"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.0" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.0" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootItem" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- ══════════════════════════════════════════
                 OPTION 2 — LIFETIME VOUCHER / LICENSE KEY
                 ══════════════════════════════════════════ -->
            <Button Command="{Binding EnterVoucherCommand}"
                    Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,12" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootItem" Background="#F8FAFC" CornerRadius="12" Padding="14" BorderThickness="1.5" BorderBrush="Transparent"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Key Icon -->
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <Path Data="M7,14A2,2 0 0,1 5,12A2,2 0 0,1 7,10A2,2 0 0,1 9,12A2,2 0 0,1 7,14M12.65,10C11.83,7.67 9.61,6 7,6A6,6 0 0,0 1,12A6,6 0 0,0 7,18C9.61,18 11.83,16.33 12.65,14H17V18H21V14H23V10H12.65Z"
                                          Fill="#C4785A" Stretch="Uniform" Width="16" Height="16"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Text="Activate with Lifetime Voucher" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"/>
                                    <TextBlock Text="Redeem an ATR prepaid cash voucher code."
                                               FontSize="11" Foreground="#64748B" Margin="0,3,0,0" TextWrapping="Wrap"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="RootItem" Property="BorderBrush" Value="#E2E8F0"/>
                            </MultiDataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.97" Duration="0:0:0.05"/>
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.97" Duration="0:0:0.05"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.0" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.0" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- ROW — FOOTER: "Powered by From Scratch" -->
            <Grid Margin="0,24,0,0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="Powered by"
                               FontSize="10" Foreground="#6B7280" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               FontFamily="Segoe UI Variable Display, Segoe UI"/>
                    <Border Width="110" Height="80" 
                            Background="#111827"
                            HorizontalAlignment="Center"
                            Margin="0,4,0,0"
                            ToolTip="Powered by From Scratch">
                        <Border.OpacityMask>
                            <ImageBrush ImageSource="/Assets/from_scratch_logo.png" 
                                        Stretch="Uniform" 
                                        RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border.OpacityMask>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Opacity" Value="0.9"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="1.0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>
            </Grid>

        </StackPanel>
    </Grid>
</UserControl>
