<UserControl x:Class="Management.Presentation.Views.Members.MemberListItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:Management.Presentation.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="240" d:DesignWidth="280"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <converters:MemberStatusToBrushConverter x:Key="MemberStatusToBrushConverter"/>
    </UserControl.Resources>

    <!-- 
        Main Card Container (Section 26.4)
        - Height: 240px ({StaticResource SizeMemberCardHeight})
        - Padding: 24px ({StaticResource PaddingCardCompact})
        - Style: Global Interactive Style (Shadow L2 -> Lift)
        - FIX: AutomationProperties.Name moved here for correct accessibility tree placement
    -->
    <Border Style="{StaticResource MemberCardStyleInteractive}"
            Height="{StaticResource SizeMemberCardHeight}"
            Padding="{StaticResource PaddingCardCompact}"
            AutomationProperties.Name="{Binding FullName}">

        <Grid>
            <!-- 
                Selection Checkbox (Top Left)
                - Style: Global Circular Style (Handles Opacity 0->1 transition internally)
            -->
            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                      Style="{StaticResource CircularSelectionCheckBoxStyle}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Panel.ZIndex="10"/>

            <!-- Main Content (Centered) -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                <!-- Avatar: 96px (Section 26.4) -->
                <Ellipse Width="{StaticResource SizeAvatarLarge}" 
                         Height="{StaticResource SizeAvatarLarge}"
                         Margin="{StaticResource MarginCardBottom}">
                    <Ellipse.Fill>
                        <SolidColorBrush Color="{DynamicResource FacilityAccentColor}" Opacity="0.1"/>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Name: 17pt Body Medium (Section 26.4) -->
                <TextBlock Text="{Binding FullName}" 
                           Style="{StaticResource BodyMedium}" 
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           TextAlignment="Center"/>

                <!-- Card ID: Caption -->
                <TextBlock Text="{Binding CardId}" 
                           Style="{StaticResource Caption}" 
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="{StaticResource MarginSmallTop}"/>

                <!-- Status Badge: shows Lead in amber, Frozen in blue, Active in green etc. -->
                <Border Style="{StaticResource StatusBadgeStyle}"
                        Background="{Binding Status, Converter={StaticResource MemberStatusToBrushConverter}}"
                        Margin="{StaticResource MarginTextVertical}"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <!-- Snowflake icon — only visible when Frozen -->
                        <Path Data="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"
                              Style="{StaticResource Style.Icon.Micro}"
                              Stroke="{DynamicResource TextOnAccentBrush}"
                              Margin="0,0,4,0">
                            <Path.Visibility>
                                <Binding Path="IsFrozen" Converter="{StaticResource BoolToVisibilityConverter}"/>
                            </Path.Visibility>
                        </Path>
                        <TextBlock Text="{Binding Status, Converter={StaticResource EnumToLocalizedDescriptionConverter}}"
                                   Style="{StaticResource Micro}"
                                   Foreground="{DynamicResource TextOnAccentBrush}"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Expiration (hidden for Leads who have no plan yet) -->
                <TextBlock HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLead}" Value="True">
                                    <Setter Property="Text" Value="{DynamicResource Terminology.Gym.LeadNoExpiry}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Warning}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLead}" Value="False">
                                    <Setter Property="Text" Value="{Binding ExpirationDate, Converter={StaticResource StringFormatConverter}, ConverterParameter='Terminology.List.Expires'}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- HOVER ACTIONS OVERLAY (Sequoia Standard) -->
            <Border Background="{DynamicResource OverlayBackdrop}"
                    CornerRadius="20"
                    Style="{StaticResource RowHoverActionsStyle}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButtonStyle}" 
                            Command="{Binding EditCommand}"
                            ToolTip="{DynamicResource TerminologyEditMemberLabel}"
                            Margin="8">
                        <Path Data="{DynamicResource Icon.Edit}" Fill="{DynamicResource TextOnDarkBrush}" Style="{StaticResource Style.Icon.Standard}"/>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" 
                            Command="{Binding DeleteCommand}"
                            ToolTip="{DynamicResource TerminologyDeleteMemberLabel}"
                            Margin="8">
                        <Path Data="{DynamicResource Icon.Delete}" Fill="{DynamicResource StatusErrorBrush}" Style="{StaticResource Style.Icon.Standard}"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
